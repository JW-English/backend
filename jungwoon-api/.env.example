# 운영/스테이징에서 주입할 환경변수 목록. 실제 값은 절대 커밋하지 않는다.
SPRING_PROFILES_ACTIVE=prod
APP_VERSION=0.0.1

DB_URL=jdbc:postgresql://localhost:5432/jungwoon
DB_USERNAME=jungwoon
DB_PASSWORD=change-me
DB_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — 32바이트 이상 랜덤 값. 짧으면 기동 시 실패한다
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d

# 관리자 웹 쿠키. HTTPS 에서만 true 로 둘 수 있다
AUTH_COOKIE_SECURE=true

# 소셜 로그인 (검수 완료 후)
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=

# 미디어 스토리지 (S3 호환)
#   로컬 : MinIO  → http://localhost:9000
#   운영 : Cloudflare R2 → https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 는 리전 개념이 없어 auto 를 쓴다. path-style 은 양쪽 다 지원한다.
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=jungwoon-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE=true

# 관리자 웹 도메인 (CORS 화이트리스트)
JUNGWOON_CORS_ALLOWED_ORIGINS=https://admin.example.com
