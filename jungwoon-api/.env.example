# 운영/스테이징에서 주입할 환경변수 목록. 실제 값은 절대 커밋하지 않는다.
SPRING_PROFILES_ACTIVE=prod
APP_VERSION=0.0.1

DB_URL=jdbc:postgresql://localhost:5432/jungwoon
DB_USERNAME=jungwoon
DB_PASSWORD=change-me
DB_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (P1) — 256bit 이상 랜덤 값
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# 소셜 로그인 (P1)
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=

# Cloudflare R2 (P2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jungwoon-media
R2_ENDPOINT=

# 관리자 웹 도메인 (CORS 화이트리스트)
JUNGWOON_CORS_ALLOWED_ORIGINS=http://localhost:3000
