# 로컬 개발용 템플릿.
#
#   cp .env.example .env
#
# 이 파일은 local 프로파일에서만 읽힌다 (application-local.yml 의 spring.config.import).
# 운영 값은 여기 두지 않는다 — 아래 "운영 전용" 절 참고.
#
# ⚠️ 로컬에서 쓰지 않을 값은 주석으로 두거나 지운다.
#    application-local.yml 의 설정을 덮어써서 서버가 안 뜨는 일이 생긴다.
#    (DB_URL 을 채워두면 p6spy 경유 설정이 덮여 기동에 실패한다)

# ─────────────────────────────────────────────────────────────
# 미디어 스토리지
# ─────────────────────────────────────────────────────────────
# 비워두면 docker compose 의 MinIO 를 쓴다 (아무 설정 없이 동작).
# Cloudflare R2 에 붙일 때만 아래를 채운다.
#
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_REGION=auto            # R2 는 리전 개념이 없다. 다른 값을 넣으면 서명이 깨진다
# STORAGE_BUCKET=jungwoon-private
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PATH_STYLE=true

# ─────────────────────────────────────────────────────────────
# 소셜 로그인 (개발자 앱 검수 후)
# ─────────────────────────────────────────────────────────────
# OAUTH_KAKAO_CLIENT_ID=
# OAUTH_KAKAO_CLIENT_SECRET=
# OAUTH_NAVER_CLIENT_ID=
# OAUTH_NAVER_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=

# ─────────────────────────────────────────────────────────────
# 운영 전용 — 로컬 .env 에는 넣지 않는다
# ─────────────────────────────────────────────────────────────
# 배포 시 환경변수나 시크릿 관리자로 주입한다. 목록만 남겨둔다.
#
#   SPRING_PROFILES_ACTIVE=prod
#   DB_URL / DB_USERNAME / DB_PASSWORD / DB_POOL_SIZE
#   REDIS_HOST / REDIS_PORT
#   JWT_SECRET              32바이트 이상. 짧으면 기동 시 실패한다
#   JWT_ACCESS_TTL=30m / JWT_REFRESH_TTL=14d
#   AUTH_COOKIE_SECURE=true HTTPS 전용
#   JUNGWOON_CORS_ALLOWED_ORIGINS=https://admin.example.com
#   STORAGE_*               운영 버킷
