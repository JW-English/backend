# VM 의 deploy/.env 로 복사해서 값을 채운다.
#   cp .env.example .env && chmod 600 .env
# git 에 올리지 않는다 (.gitignore 에 등록되어 있다).

# ── 도메인
DOMAIN=purutpurut.com
ACME_EMAIL=you@purutpurut.com

# ── 이미지 태그. 배포 워크플로가 git sha 로 덮어쓴다
API_TAG=latest
ADMIN_TAG=latest

# ── DB
# 로컬과 같은 jungwoon/jungwoon 을 쓰지 않는다. 컨테이너 밖으로 포트를 열지
# 않더라도 약한 비밀번호를 운영에 두면 안 된다.
#   openssl rand -base64 32
DB_USERNAME=jungwoon
DB_PASSWORD=

# ── JWT
# 32바이트 이상. 이 값이 바뀌면 발급된 토큰이 전부 무효가 되어 모두 로그아웃된다
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d

# HTTPS 전용. 평문으로 Refresh Token 이 나가면 안 된다
AUTH_COOKIE_SECURE=true

# ── Cloudflare R2
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_BUCKET=jungwoon-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_PATH_STYLE=true

# ── CORS
# admin 페이지가 브라우저에서 api 를 부른다. 콤마로 여러 개를 준다.
# 앱은 브라우저가 아니라서 CORS 대상이 아니다.
JUNGWOON_CORS_ALLOWED_ORIGINS=https://admin.purutpurut.com

# ── 백업 (backup.sh 가 쓴다)
# 전용 버킷과 전용 토큰을 쓰는 것이 기본이다. 미디어 토큰이 새어도 백업은
# 지워지지 않고, 반대도 마찬가지다.
BACKUP_BUCKET=purutpurut-backup
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_KEEP_DAYS=30

# 전용 버킷을 못 만드는 경우(토큰이 버킷 단위로 묶여 있는 등)에만 쓴다.
# 미디어 버킷을 그대로 쓰고 프리픽스로 나눈다.
#   BACKUP_BUCKET=jungwoon-private
#   BACKUP_PREFIX=backups
BACKUP_PREFIX=
