{"headword": "mark", "meanings": [{"pos": "n.", "ko": "표시, 자국"}, {"pos": "v.", "ko": "표시하다, 기입하다"}, {"pos": "n.", "ko": "점수, 성적"}], "meaning_ko": "표시", "example_en": "There was a strange mark on the surface of the table.", "example_ko": "책상 표면에 이상한 표시가 있었다."}
{"headword": "marriage", "meanings": [{"pos": "n.", "ko": "결혼, 혼인"}, {"pos": "n.", "ko": "결합, 융합"}], "meaning_ko": "결혼", "example_en": "Their marriage ceremony was held in a beautiful garden.", "example_ko": "그들의 결혼식은 아름다운 정원에서 열렸다."}
{"headword": "martial", "meanings": [{"pos": "a.", "ko": "전쟁의, 군사의"}, {"pos": "a.", "ko": "용감한, 호전적인"}], "meaning_ko": "군사의", "example_en": "The country declared martial law during the crisis.", "example_ko": "그 나라는 위기 동안 계엄령을 선포했다."}
{"headword": "marvel", "meanings": [{"pos": "n.", "ko": "경이, 놀라운 일"}, {"pos": "v.", "ko": "경탄하다, 놀라다"}], "meaning_ko": "경이", "example_en": "The invention was considered a marvel of modern engineering.", "example_ko": "그 발명품은 현대 공학의 경이로 여겨졌다."}
{"headword": "marvelous", "meanings": [{"pos": "a.", "ko": "아주 훌륭한, 놀라운"}, {"pos": "a.", "ko": "재미있는, 흥미로운"}], "meaning_ko": "아주 훌륭한", "example_en": "She did a marvelous job organizing the school festival.", "example_ko": "그녀는 학교 축제를 아주 훌륭하게 준비했다."}
{"headword": "marvelously", "meanings": [{"pos": "ad.", "ko": "놀랍게도, 굉장히"}, {"pos": "ad.", "ko": "불가사의하게"}], "meaning_ko": "놀랍게도", "example_en": "The athlete performed marvelously in the final match.", "example_ko": "그 선수는 결승전에서 놀랍게도 뛰어난 활약을 했다."}
{"headword": "masculine", "meanings": [{"pos": "a.", "ko": "남성의, 남자다운"}, {"pos": "a.", "ko": "힘센, 강인한"}], "meaning_ko": "남성의", "example_en": "The actor has a very masculine voice and appearance.", "example_ko": "그 배우는 매우 남성적인 목소리와 외모를 가졌다."}
{"headword": "mass", "meanings": [{"pos": "n.", "ko": "덩어리, 집단"}, {"pos": "n.", "ko": "대중, 다수"}, {"pos": "n.", "ko": "질량"}], "meaning_ko": "덩어리", "example_en": "A large mass of clouds covered the sky before the storm.", "example_ko": "폭풍 전 하늘을 큰 구름 덩어리가 뒤덮었다."}
{"headword": "massive", "meanings": [{"pos": "a.", "ko": "거대한, 엄청난"}, {"pos": "a.", "ko": "중대한, 심각한"}], "meaning_ko": "거대한", "example_en": "The massive building could be seen from miles away.", "example_ko": "그 거대한 건물은 멀리서도 보였다."}
{"headword": "master", "meanings": [{"pos": "n.", "ko": "대가, 명인"}, {"pos": "n.", "ko": "주인, 지배자"}, {"pos": "v.", "ko": "숙달하다, 정통하다"}, {"pos": "a.", "ko": "일류의, 뛰어난"}], "meaning_ko": "대가", "example_en": "He is a master of classical music and teaches young musicians.", "example_ko": "그는 클래식 음악의 대가로서 젊은 음악가들을 가르친다."}
{"headword": "masterpiece", "meanings": [{"pos": "n.", "ko": "걸작, 명작"}, {"pos": "n.", "ko": "대표작"}], "meaning_ko": "걸작", "example_en": "The painting is considered the artist's greatest masterpiece.", "example_ko": "그 그림은 그 예술가의 최고의 걸작으로 여겨진다."}
{"headword": "material", "meanings": [{"pos": "n.", "ko": "재료, 원료"}, {"pos": "n.", "ko": "자료, 내용"}, {"pos": "a.", "ko": "물질의, 물질적인"}], "meaning_ko": "재료", "example_en": "Wood is a common material used in furniture making.", "example_ko": "나무는 가구 제작에 흔히 쓰이는 재료이다."}
{"headword": "maternal", "meanings": [{"pos": "a.", "ko": "어머니의, 모성의"}, {"pos": "a.", "ko": "외가 쪽의"}], "meaning_ko": "어머니의", "example_en": "She showed strong maternal instincts when caring for the child.", "example_ko": "그녀는 아이를 돌볼 때 강한 어머니의 본능을 보였다."}
{"headword": "mature", "meanings": [{"pos": "a.", "ko": "성숙한, 다 자란"}, {"pos": "v.", "ko": "성장하다, 성숙해지다"}], "meaning_ko": "성숙한", "example_en": "He became more mature after experiencing many challenges.", "example_ko": "그는 많은 어려움을 겪으며 더 성숙해졌다."}
{"headword": "maximal", "meanings": [{"pos": "a.", "ko": "최대한의, 최고조의"}, {"pos": "a.", "ko": "최대치의"}], "meaning_ko": "최대한의", "example_en": "The maximal speed of the vehicle is limited for safety reasons.", "example_ko": "그 차량의 최대 속도는 안전상의 이유로 제한된다."}
{"headword": "moan", "meanings": [{"pos": "v.", "ko": "신음하다, 슬픈 소리를 내다"}, {"pos": "n.", "ko": "신음 소리, 불평"}], "meaning_ko": "신음하다", "example_en": "The patient began to moan quietly as the pain increased.", "example_ko": "환자는 통증이 심해지자 조용히 신음하기 시작했다."}
{"headword": "mobile", "meanings": [{"pos": "a.", "ko": "이동이 쉬운, 움직일 수 있는"}, {"pos": "n.", "ko": "모빌(장식용 매달린 조각), 휴대전화"}], "meaning_ko": "이동이 쉬운", "example_en": "The mobile library visits small towns every week to lend books.", "example_ko": "이동 도서관은 매주 작은 마을을 방문해 책을 빌려준다."}
{"headword": "mobility", "meanings": [{"pos": "n.", "ko": "이동성, 움직일 수 있음"}, {"pos": "n.", "ko": "사회적 유동성"}], "meaning_ko": "이동성", "example_en": "Mobility is important for people who want to travel for work.", "example_ko": "일 때문에 여행하는 사람들에게 이동성은 중요하다."}
{"headword": "mock", "meanings": [{"pos": "v.", "ko": "조롱하다, 흉내 내며 놀리다"}, {"pos": "a.", "ko": "가짜의, 모의의"}, {"pos": "n.", "ko": "조롱, 놀림"}], "meaning_ko": "조롱하다", "example_en": "Some students tried to mock the teacher's accent during class.", "example_ko": "몇몇 학생들이 수업 중에 선생님의 억양을 흉내 내며 놀렸다."}
{"headword": "moderate", "meanings": [{"pos": "a.", "ko": "보통의, 중간의"}, {"pos": "a.", "ko": "온건한, 절제하는"}, {"pos": "v.", "ko": "완화하다, 누그러뜨리다"}, {"pos": "v.", "ko": "(회의 등을) 진행하다, 사회를 보다"}], "meaning_ko": "보통의", "example_en": "The weather was moderate, so we decided to go hiking.", "example_ko": "날씨가 보통이라 우리는 등산을 가기로 했다."}
{"headword": "modern", "meanings": [{"pos": "a.", "ko": "현대의, 근대의"}, {"pos": "a.", "ko": "현대적인, 최신의"}], "meaning_ko": "현대의", "example_en": "Modern technology has changed the way people communicate.", "example_ko": "현대 기술은 사람들이 소통하는 방식을 바꿔 놓았다."}
{"headword": "modernization", "meanings": [{"pos": "n.", "ko": "현대화, 근대화"}], "meaning_ko": "현대화", "example_en": "The country focused on the modernization of its transportation system.", "example_ko": "그 나라는 교통 체계의 현대화에 집중했다."}
{"headword": "modernize", "meanings": [{"pos": "v.", "ko": "현대화하다, 현대식으로 만들다"}], "meaning_ko": "현대화하다", "example_en": "The company plans to modernize its old factories next year.", "example_ko": "그 회사는 내년에 낡은 공장들을 현대화할 계획이다."}
{"headword": "modest", "meanings": [{"pos": "a.", "ko": "겸손한, 자만하지 않는"}, {"pos": "a.", "ko": "크지 않은, 적당한"}, {"pos": "a.", "ko": "단정한, 소박한"}], "meaning_ko": "겸손한", "example_en": "Despite his success, he remains a modest and humble person.", "example_ko": "성공했음에도 그는 여전히 겸손하고 소박하다."}
{"headword": "modesty", "meanings": [{"pos": "n.", "ko": "겸손, 소박함"}], "meaning_ko": "겸손", "example_en": "Her modesty made her popular among her classmates.", "example_ko": "그녀의 겸손함 때문에 반 친구들에게 인기가 많았다."}
{"headword": "modification", "meanings": [{"pos": "n.", "ko": "변경, 수정"}], "meaning_ko": "변경", "example_en": "The teacher suggested a modification to improve my essay.", "example_ko": "선생님이 내 에세이를 더 좋게 하려고 수정을 제안하셨다."}
{"headword": "modify", "meanings": [{"pos": "v.", "ko": "변경하다, 수정하다"}, {"pos": "v.", "ko": "수식하다"}], "meaning_ko": "변경하다", "example_en": "You can modify the schedule if you need more time.", "example_ko": "더 시간이 필요하면 일정을 변경할 수 있다."}
{"headword": "mold", "meanings": [{"pos": "n.", "ko": "틀, 주형"}, {"pos": "n.", "ko": "곰팡이"}, {"pos": "v.", "ko": "틀에 넣어 만들다, 형성하다"}], "meaning_ko": "틀", "example_en": "The chocolate was poured into a mold to create different shapes.", "example_ko": "초콜릿을 다양한 모양으로 만들기 위해 틀에 부었다."}
{"headword": "mole", "meanings": [{"pos": "n.", "ko": "두더지"}, {"pos": "n.", "ko": "점(피부에 있는 작은 반점)"}, {"pos": "n.", "ko": "스파이, 밀정"}], "meaning_ko": "두더지", "example_en": "A mole dug tunnels under the garden, damaging the plants.", "example_ko": "두더지가 정원 밑에 굴을 파서 식물들이 피해를 입었다."}
{"headword": "molecule", "meanings": [{"pos": "n.", "ko": "분자"}], "meaning_ko": "분자", "example_en": "A water molecule is made up of two hydrogen atoms and one oxygen atom.", "example_ko": "물 분자는 수소 원자 두 개와 산소 원자 한 개로 이루어져 있다."}
{"headword": "moment", "meanings": [{"pos": "n.", "ko": "순간, 아주 짧은 시간"}, {"pos": "n.", "ko": "특정한 때, 시기"}], "meaning_ko": "순간", "example_en": "She hesitated for a moment before answering the question.", "example_ko": "그녀는 질문에 답하기 전에 잠시 망설였다."}
{"headword": "momentarily", "meanings": [{"pos": "ad.", "ko": "잠시, 금방"}], "meaning_ko": "잠시", "example_en": "The lights will be turned off momentarily for the presentation.", "example_ko": "발표를 위해 잠시 불이 꺼질 예정이다."}
{"headword": "momentary", "meanings": [{"pos": "a.", "ko": "순간의, 잠깐의"}], "meaning_ko": "순간의", "example_en": "He felt a momentary pain in his leg during the run.", "example_ko": "그는 달리는 동안 다리에 순간적인 통증을 느꼈다."}
{"headword": "monetary", "meanings": [{"pos": "a.", "ko": "금전의, 화폐의"}], "meaning_ko": "금전의", "example_en": "The government announced new monetary policies to support the economy.", "example_ko": "정부는 경제를 지원하기 위해 새로운 금전 정책을 발표했다."}
{"headword": "monitor", "meanings": [{"pos": "n.", "ko": "화면, 모니터"}, {"pos": "n.", "ko": "감시자, 관찰자"}, {"pos": "v.", "ko": "감시하다, 관찰하다"}], "meaning_ko": "화면", "example_en": "He checked the monitor to see if the computer was working properly.", "example_ko": "그는 컴퓨터가 제대로 작동하는지 화면을 확인했다."}
{"headword": "monoculture", "meanings": [{"pos": "n.", "ko": "한 가지 작물만 재배함"}, {"pos": "n.", "ko": "단일 문화 형성"}], "meaning_ko": "단일 재배", "example_en": "Monoculture can lead to soil depletion and increased pest problems.", "example_ko": "단일 재배는 토양 고갈과 해충 문제를 유발할 수 있다."}
{"headword": "monologue", "meanings": [{"pos": "n.", "ko": "혼자 길게 말하는 것"}, {"pos": "n.", "ko": "연극에서 배우의 독백"}], "meaning_ko": "긴 독백", "example_en": "The actor delivered a powerful monologue that impressed the audience.", "example_ko": "그 배우는 관객을 감동시킨 긴 독백을 선보였다."}
{"headword": "monotonous", "meanings": [{"pos": "a.", "ko": "변화가 없어 지루한"}, {"pos": "a.", "ko": "단조로워 흥미 없는"}], "meaning_ko": "단조로운", "example_en": "Her monotonous voice made the lecture hard to concentrate on.", "example_ko": "그녀의 단조로운 목소리 때문에 강의에 집중하기 어려웠다."}
{"headword": "monotony", "meanings": [{"pos": "n.", "ko": "지루하고 변화 없는 상태"}, {"pos": "n.", "ko": "단조로움에서 오는 지침"}], "meaning_ko": "단조로움", "example_en": "The monotony of daily routines can sometimes make life feel dull.", "example_ko": "일상의 단조로움 때문에 삶이 지루하게 느껴질 때가 있다."}
{"headword": "monument", "meanings": [{"pos": "n.", "ko": "역사적 의미가 있는 기념물"}, {"pos": "n.", "ko": "기억을 위한 건축물"}], "meaning_ko": "기념물", "example_en": "The monument was built to honor those who fought in the war.", "example_ko": "그 기념물은 전쟁에서 싸운 이들을 기리기 위해 세워졌다."}
{"headword": "monumental", "meanings": [{"pos": "a.", "ko": "역사적으로 중요한"}, {"pos": "a.", "ko": "엄청나게 큰"}], "meaning_ko": "기념비적인", "example_en": "Her discovery was a monumental achievement in the field of science.", "example_ko": "그녀의 발견은 과학 분야에서 기념비적인 성과였다."}
{"headword": "mood", "meanings": [{"pos": "n.", "ko": "기분, 감정 상태"}, {"pos": "n.", "ko": "분위기, 상황의 느낌"}], "meaning_ko": "기분", "example_en": "His cheerful mood made everyone around him feel happier.", "example_ko": "그의 밝은 기분 덕분에 주변 모두가 더 즐거워졌다."}
{"headword": "moral", "meanings": [{"pos": "a.", "ko": "도덕적인, 옳고 그름에 관한"}, {"pos": "n.", "ko": "교훈, 도덕적 의미"}], "meaning_ko": "도덕적인", "example_en": "She always tries to make moral decisions in difficult situations.", "example_ko": "그녀는 어려운 상황에서도 항상 도덕적인 결정을 내리려고 한다."}
{"headword": "morale", "meanings": [{"pos": "n.", "ko": "의욕, 사기"}, {"pos": "n.", "ko": "집단의 정신 상태"}], "meaning_ko": "사기", "example_en": "The team's morale improved after their recent victory.", "example_ko": "최근 승리로 팀의 사기가 높아졌다."}
{"headword": "mortal", "meanings": [{"pos": "a.", "ko": "언젠가는 죽는, 죽을 운명의"}, {"pos": "a.", "ko": "치명적인"}, {"pos": "n.", "ko": "인간"}], "meaning_ko": "죽을 운명의", "example_en": "All humans are mortal and must face death someday.", "example_ko": "모든 인간은 죽을 운명이며 언젠가는 죽음을 맞이한다."}
{"headword": "mortality", "meanings": [{"pos": "n.", "ko": "사망률"}, {"pos": "n.", "ko": "죽을 운명, 필멸성"}], "meaning_ko": "사망률", "example_en": "Advances in medicine have helped reduce child mortality worldwide.", "example_ko": "의학의 발전으로 전 세계적으로 아동 사망률이 줄었다."}
{"headword": "motion", "meanings": [{"pos": "n.", "ko": "움직임, 동작"}, {"pos": "v.", "ko": "몸짓으로 신호하다"}], "meaning_ko": "움직임", "example_en": "The sudden motion of the train startled the passengers.", "example_ko": "기차의 갑작스러운 움직임에 승객들이 놀랐다."}
{"headword": "motionless", "meanings": [{"pos": "a.", "ko": "가만히 있는, 움직이지 않는"}], "meaning_ko": "가만히 있는", "example_en": "The deer stood motionless, trying not to attract attention.", "example_ko": "사슴은 주의를 끌지 않으려고 가만히 서 있었다."}
{"headword": "motivate", "meanings": [{"pos": "v.", "ko": "동기를 부여하다"}, {"pos": "v.", "ko": "자극하여 행동하게 하다"}], "meaning_ko": "동기를 주다", "example_en": "Teachers should motivate students to reach their full potential.", "example_ko": "교사는 학생들이 잠재력을 발휘하도록 동기를 주어야 한다."}
{"headword": "motivation", "meanings": [{"pos": "n.", "ko": "무언가를 하게 하는 동기"}, {"pos": "n.", "ko": "의욕, 열의"}], "meaning_ko": "동기 부여", "example_en": "Strong motivation is necessary to achieve long-term goals.", "example_ko": "장기적인 목표를 이루려면 강한 동기 부여가 필요하다."}
{"headword": "motive", "meanings": [{"pos": "n.", "ko": "행동의 이유, 동기"}, {"pos": "a.", "ko": "행동을 유발하는"}], "meaning_ko": "행동 동기", "example_en": "The police are still searching for the motive behind the crime.", "example_ko": "경찰은 아직 그 범죄의 행동 동기를 찾고 있다."}
{"headword": "mourn", "meanings": [{"pos": "v.", "ko": "슬퍼하다, 애도하다"}], "meaning_ko": "애도하다", "example_en": "Many people gathered to mourn the loss of their beloved leader.", "example_ko": "많은 사람들이 사랑하는 지도자의 죽음을 애도하기 위해 모였다."}
{"headword": "move", "meanings": [{"pos": "v.", "ko": "움직이다, 이동하다"}, {"pos": "v.", "ko": "이사하다"}, {"pos": "v.", "ko": "감동시키다"}, {"pos": "n.", "ko": "행동, 조치"}], "meaning_ko": "움직이다", "example_en": "Please move your car so others can park in the space.", "example_ko": "다른 사람이 주차할 수 있도록 차를 이동시켜 주세요."}
{"headword": "movement", "meanings": [{"pos": "n.", "ko": "움직임, 이동"}, {"pos": "n.", "ko": "사회적 운동, 집단적 활동"}, {"pos": "n.", "ko": "진전, 변화"}], "meaning_ko": "이동", "example_en": "The movement of people to cities has increased rapidly in recent years.", "example_ko": "최근 몇 년 사이 도심으로의 인구 이동이 급증했다."}
{"headword": "moving", "meanings": [{"pos": "a.", "ko": "감동을 주는"}, {"pos": "a.", "ko": "움직이는, 이동하는"}], "meaning_ko": "감동적인", "example_en": "The movie had a moving ending that brought tears to my eyes.", "example_ko": "그 영화는 감동적인 결말로 내 눈에 눈물을 맺게 했다."}
{"headword": "minimize", "meanings": [{"pos": "v.", "ko": "최소로 줄이다"}, {"pos": "v.", "ko": "가장 작게 만들다"}, {"pos": "v.", "ko": "과소평가하다"}], "meaning_ko": "최소로 줄이다", "example_en": "To save energy, we should minimize the use of electricity at home.", "example_ko": "에너지를 절약하려면 집에서 전기 사용을 최소로 줄여야 한다."}
{"headword": "minimum", "meanings": [{"pos": "n.", "ko": "최소, 최저"}, {"pos": "a.", "ko": "최소의, 최저의"}], "meaning_ko": "최소", "example_en": "The minimum age to get a driver's license is eighteen in many countries.", "example_ko": "많은 나라에서 운전면허를 취득할 수 있는 최소 연령은 18세이다."}
{"headword": "minister", "meanings": [{"pos": "n.", "ko": "장관"}, {"pos": "n.", "ko": "성직자, 목사"}], "meaning_ko": "장관", "example_en": "The minister announced a new policy to improve public health.", "example_ko": "장관은 공중보건을 개선하기 위한 새로운 정책을 발표했다."}
{"headword": "ministry", "meanings": [{"pos": "n.", "ko": "정부 부처, 부"}, {"pos": "n.", "ko": "장관의 직책"}, {"pos": "n.", "ko": "성직자의 직분"}], "meaning_ko": "정부 부처", "example_en": "The Ministry of Education introduced new guidelines for schools.", "example_ko": "교육부는 학교를 위한 새로운 지침을 도입했다."}
{"headword": "minor", "meanings": [{"pos": "a.", "ko": "작은, 덜 중요한"}, {"pos": "n.", "ko": "미성년자"}, {"pos": "n.", "ko": "부전공"}], "meaning_ko": "작은", "example_en": "The mistake was minor, so it did not affect the final result.", "example_ko": "그 실수는 사소해서 최종 결과에 영향을 주지 않았다."}
{"headword": "minority", "meanings": [{"pos": "n.", "ko": "소수, 소수 집단"}, {"pos": "n.", "ko": "소수 민족"}, {"pos": "n.", "ko": "미성년기"}], "meaning_ko": "소수", "example_en": "The minority in the group expressed different opinions from the majority.", "example_ko": "그 집단의 소수는 다수와 다른 의견을 밝혔다."}
{"headword": "miracle", "meanings": [{"pos": "n.", "ko": "기적"}, {"pos": "n.", "ko": "놀라운 일"}], "meaning_ko": "기적", "example_en": "It was a miracle that everyone survived the accident without injury.", "example_ko": "모두가 다치지 않고 사고에서 살아남은 것은 기적이었다."}
{"headword": "miraculous", "meanings": [{"pos": "a.", "ko": "기적 같은"}, {"pos": "a.", "ko": "놀라운"}], "meaning_ko": "기적 같은", "example_en": "Her miraculous recovery surprised all the doctors at the hospital.", "example_ko": "그녀의 기적 같은 회복은 병원에 있는 모든 의사들을 놀라게 했다."}
{"headword": "misbehave", "meanings": [{"pos": "v.", "ko": "버릇없이 굴다"}, {"pos": "v.", "ko": "나쁜 행동을 하다"}], "meaning_ko": "버릇없이 굴다", "example_en": "Children who misbehave in class may be sent to the principal's office.", "example_ko": "수업 시간에 버릇없이 구는 아이들은 교장실로 보내질 수 있다."}
{"headword": "mischief", "meanings": [{"pos": "n.", "ko": "장난, 못된 짓"}, {"pos": "n.", "ko": "해, 손해"}], "meaning_ko": "장난", "example_en": "The boy's mischief often made his teachers laugh and shake their heads.", "example_ko": "그 소년의 장난은 종종 선생님들을 웃게 하고 고개를 젓게 만들었다."}
{"headword": "miserable", "meanings": [{"pos": "a.", "ko": "비참한, 불행한"}, {"pos": "a.", "ko": "우울한, 우울하게 만드는"}], "meaning_ko": "비참한", "example_en": "He felt miserable after losing his wallet on the way home.", "example_ko": "그는 집에 가는 길에 지갑을 잃어버리고 비참함을 느꼈다."}
{"headword": "misfortune", "meanings": [{"pos": "n.", "ko": "불운, 불행"}, {"pos": "n.", "ko": "역경"}], "meaning_ko": "불운", "example_en": "She faced a great misfortune when her business failed suddenly.", "example_ko": "그녀는 사업이 갑자기 망하는 큰 불운을 겪었다."}
{"headword": "mislead", "meanings": [{"pos": "v.", "ko": "잘못 이끌다, 오도하다"}, {"pos": "v.", "ko": "속이다, 오해하게 하다"}], "meaning_ko": "오도하다", "example_en": "The advertisement was designed to mislead customers about the product's quality.", "example_ko": "그 광고는 제품의 품질에 대해 소비자를 오도하도록 만들어졌다."}
{"headword": "misleading", "meanings": [{"pos": "a.", "ko": "오해의 소지가 있는"}, {"pos": "a.", "ko": "잘못 인도하는"}], "meaning_ko": "오해의 소지가 있는", "example_en": "The headline was misleading and did not reflect the true story.", "example_ko": "그 제목은 오해의 소지가 있었고 실제 내용을 반영하지 않았다."}
{"headword": "misplace", "meanings": [{"pos": "v.", "ko": "잘못 두다, 잃어버리다"}, {"pos": "v.", "ko": "위치를 잘못 잡다"}], "meaning_ko": "잘못 두다", "example_en": "If you misplace your keys, you might be late for your appointment.", "example_ko": "열쇠를 잘못 두면 약속에 늦을 수도 있다."}
{"headword": "mission", "meanings": [{"pos": "n.", "ko": "임무, 사명"}, {"pos": "n.", "ko": "목표, 목적"}, {"pos": "n.", "ko": "사절단, 특파단"}], "meaning_ko": "임무", "example_en": "The team's mission was to deliver supplies to the remote village.", "example_ko": "그 팀의 임무는 외진 마을에 물자를 전달하는 것이었다."}
{"headword": "missionary", "meanings": [{"pos": "n.", "ko": "선교사, 전도사"}, {"pos": "a.", "ko": "선교의, 전도의"}], "meaning_ko": "선교사", "example_en": "The missionary traveled to many countries to share his beliefs.", "example_ko": "그 선교사는 자신의 신념을 전하기 위해 여러 나라를 다녔다."}
{"headword": "mistake", "meanings": [{"pos": "n.", "ko": "실수, 잘못"}, {"pos": "v.", "ko": "오해하다, 잘못 판단하다"}], "meaning_ko": "실수", "example_en": "I made a mistake on my math test and got a lower score.", "example_ko": "나는 수학 시험에서 실수를 해서 점수가 낮게 나왔다."}
{"headword": "mistakenly", "meanings": [{"pos": "ad.", "ko": "실수로, 잘못하여"}, {"pos": "ad.", "ko": "틀리게"}], "meaning_ko": "실수로", "example_en": "He mistakenly sent the email to the wrong person at work.", "example_ko": "그는 실수로 직장에서 이메일을 잘못된 사람에게 보냈다."}
{"headword": "mixture", "meanings": [{"pos": "n.", "ko": "혼합물, 섞인 것"}, {"pos": "n.", "ko": "혼합, 섞기"}], "meaning_ko": "혼합물", "example_en": "The cake batter is a mixture of flour, eggs, and sugar.", "example_ko": "케이크 반죽은 밀가루, 달걀, 설탕이 섞인 혼합물이다."}
{"headword": "mow", "meanings": [{"pos": "v.", "ko": "(잔디 등을) 깎다, 베다"}, {"pos": "v.", "ko": "(풀 등을) 베어서 치우다"}], "meaning_ko": "잔디를 깎다", "example_en": "Every weekend, he mows the lawn in his backyard to keep it neat.", "example_ko": "그는 뒷마당 잔디를 깔끔하게 유지하려고 주말마다 깎는다."}
{"headword": "multimedia", "meanings": [{"pos": "n.", "ko": "멀티미디어, 다양한 매체의 결합"}, {"pos": "a.", "ko": "멀티미디어의, 여러 매체를 활용한"}], "meaning_ko": "멀티미디어", "example_en": "The teacher used multimedia presentations to make the lesson more interesting.", "example_ko": "선생님은 수업을 더 흥미롭게 하려고 멀티미디어 자료를 활용했다."}
{"headword": "multiple", "meanings": [{"pos": "a.", "ko": "다수의, 다양한"}, {"pos": "a.", "ko": "배수의"}, {"pos": "n.", "ko": "배수"}], "meaning_ko": "다수의", "example_en": "There are multiple ways to solve this math problem efficiently.", "example_ko": "이 수학 문제를 효율적으로 푸는 방법이 여러 가지 있다."}
{"headword": "multiply", "meanings": [{"pos": "v.", "ko": "증가하다, 늘어나다"}, {"pos": "v.", "ko": "증가시키다, 늘리다"}, {"pos": "v.", "ko": "곱하다"}, {"pos": "v.", "ko": "번식하다"}], "meaning_ko": "증가하다", "example_en": "If the bacteria multiply quickly, the infection can become dangerous.", "example_ko": "세균이 빠르게 늘어나면 감염이 위험해질 수 있다."}
{"headword": "multitask", "meanings": [{"pos": "v.", "ko": "여러 가지 일을 동시에 하다"}], "meaning_ko": "동시에 일하다", "example_en": "She can multitask by listening to music while doing her homework.", "example_ko": "그녀는 숙제를 하면서 음악도 듣는 등 동시에 여러 일을 할 수 있다."}
{"headword": "multitude", "meanings": [{"pos": "n.", "ko": "다수, 아주 많은 수"}, {"pos": "n.", "ko": "군중, 많은 사람들"}], "meaning_ko": "다수", "example_en": "A multitude of stars could be seen in the clear night sky.", "example_ko": "맑은 밤하늘에는 수많은 별들이 보였다."}
{"headword": "municipal", "meanings": [{"pos": "a.", "ko": "지방 자치의, 시의"}, {"pos": "a.", "ko": "지방 정부 소속의"}], "meaning_ko": "시의", "example_en": "The municipal government announced a new recycling program for the city.", "example_ko": "시 정부는 새로운 재활용 프로그램을 발표했다."}
{"headword": "murder", "meanings": [{"pos": "n.", "ko": "살인, 살해"}, {"pos": "n.", "ko": "살인죄"}, {"pos": "v.", "ko": "살해하다, 죽이다"}], "meaning_ko": "살인", "example_en": "The detective investigated the murder that occurred last night.", "example_ko": "형사는 어젯밤 발생한 살인 사건을 조사했다."}
{"headword": "murderer", "meanings": [{"pos": "n.", "ko": "살인자, 살해범"}], "meaning_ko": "살인자", "example_en": "The police arrested the murderer after a long investigation.", "example_ko": "경찰은 오랜 수사 끝에 살인자를 체포했다."}
{"headword": "muscle", "meanings": [{"pos": "n.", "ko": "근육"}, {"pos": "n.", "ko": "근력, 힘"}], "meaning_ko": "근육", "example_en": "Regular exercise helps you build muscle and stay healthy.", "example_ko": "규칙적인 운동은 근육을 키우고 건강을 유지하는 데 도움이 된다."}
{"headword": "mutation", "meanings": [{"pos": "n.", "ko": "변화, 변형"}, {"pos": "n.", "ko": "(생물) 돌연변이"}], "meaning_ko": "변화", "example_en": "A small genetic mutation can sometimes lead to significant changes in an organism.", "example_ko": "작은 유전적 변화가 생물체에 큰 변화를 가져올 수 있다."}
{"headword": "mutual", "meanings": [{"pos": "a.", "ko": "상호간의, 서로의"}, {"pos": "a.", "ko": "공통의, 공동의"}], "meaning_ko": "상호간의", "example_en": "Mutual respect is essential for a healthy relationship.", "example_ko": "건강한 관계를 위해서는 상호 존중이 필수적이다."}
{"headword": "mutually", "meanings": [{"pos": "ad.", "ko": "서로, 상호간에"}, {"pos": "ad.", "ko": "공통으로"}], "meaning_ko": "서로", "example_en": "The two countries agreed to mutually reduce their nuclear weapons.", "example_ko": "두 나라는 서로 핵무기를 줄이기로 합의했다."}
{"headword": "myth", "meanings": [{"pos": "n.", "ko": "신화"}, {"pos": "n.", "ko": "잘못된 믿음, 근거 없는 이야기"}], "meaning_ko": "신화", "example_en": "The myth of the phoenix has inspired countless stories and artworks.", "example_ko": "불사조 신화는 수많은 이야기와 예술 작품에 영감을 주었다."}
{"headword": "naive", "meanings": [{"pos": "a.", "ko": "순진한, 세상 물정 모르는"}, {"pos": "a.", "ko": "경험이 없는, 단순한"}], "meaning_ko": "순진한", "example_en": "It was naive of him to trust a stranger so easily.", "example_ko": "그가 낯선 사람을 그렇게 쉽게 믿은 것은 순진한 행동이었다."}
{"headword": "narrative", "meanings": [{"pos": "n.", "ko": "이야기, 서술"}, {"pos": "a.", "ko": "이야기 형식의, 서술적인"}], "meaning_ko": "이야기", "example_en": "The novel's narrative is told from the main character's point of view.", "example_ko": "그 소설의 이야기는 주인공의 시점에서 전개된다."}
{"headword": "nasty", "meanings": [{"pos": "a.", "ko": "불쾌한, 고약한"}, {"pos": "a.", "ko": "심술궂은, 못된"}], "meaning_ko": "불쾌한", "example_en": "There was a nasty smell coming from the garbage can.", "example_ko": "쓰레기통에서 불쾌한 냄새가 났다."}
{"headword": "nation", "meanings": [{"pos": "n.", "ko": "국가, 나라"}, {"pos": "n.", "ko": "국민, 민족"}], "meaning_ko": "국가", "example_en": "The nation celebrated its independence day with fireworks and parades.", "example_ko": "그 나라는 독립기념일을 불꽃놀이와 퍼레이드로 기념했다."}
{"headword": "national", "meanings": [{"pos": "a.", "ko": "국가의, 국가적인"}, {"pos": "a.", "ko": "국립의, 국영의"}], "meaning_ko": "국가의", "example_en": "The national museum displays important historical artifacts.", "example_ko": "국립 박물관에는 중요한 역사 유물이 전시되어 있다."}
{"headword": "nationality", "meanings": [{"pos": "n.", "ko": "국적"}, {"pos": "n.", "ko": "국민성"}], "meaning_ko": "국적", "example_en": "She has Korean nationality but grew up in another country.", "example_ko": "그녀는 국적은 한국이지만 다른 나라에서 자랐다."}
{"headword": "nobility", "meanings": [{"pos": "n.", "ko": "고귀함, 숭고함"}, {"pos": "n.", "ko": "귀족 계급"}], "meaning_ko": "고귀함", "example_en": "Her actions showed great nobility in the face of hardship.", "example_ko": "그녀의 행동은 어려움 속에서도 고귀함을 드러냈다."}
{"headword": "noble", "meanings": [{"pos": "a.", "ko": "고상한, 숭고한"}, {"pos": "a.", "ko": "귀족의"}, {"pos": "n.", "ko": "귀족"}], "meaning_ko": "고상한", "example_en": "He is admired for his noble character and selfless acts.", "example_ko": "그는 고상한 성품과 이타적인 행동으로 존경받는다."}
{"headword": "nomad", "meanings": [{"pos": "n.", "ko": "유목민, 방랑자"}], "meaning_ko": "유목민", "example_en": "The nomad moved from place to place in search of water and food.", "example_ko": "그 유목민은 물과 음식을 찾아 이곳저곳을 옮겨 다녔다."}
{"headword": "nominate", "meanings": [{"pos": "v.", "ko": "지명하다, 추천하다"}, {"pos": "v.", "ko": "임명하다"}], "meaning_ko": "지명하다", "example_en": "The committee will nominate three candidates for the award.", "example_ko": "위원회는 그 상을 받을 세 명의 후보를 지명할 것이다."}
{"headword": "nonsense", "meanings": [{"pos": "n.", "ko": "터무니없는 말, 허튼소리"}, {"pos": "n.", "ko": "무의미한 행동"}], "meaning_ko": "허튼소리", "example_en": "Most people ignored his story because it was complete nonsense.", "example_ko": "대부분의 사람들은 그의 이야기가 완전히 허튼소리라며 무시했다."}
{"headword": "norm", "meanings": [{"pos": "n.", "ko": "표준, 기준"}, {"pos": "n.", "ko": "규범, 관례"}], "meaning_ko": "표준", "example_en": "Wearing a school uniform is the norm in many countries.", "example_ko": "많은 나라에서 교복을 입는 것이 표준이다."}
{"headword": "normal", "meanings": [{"pos": "a.", "ko": "보통의, 평범한"}, {"pos": "a.", "ko": "정상적인"}], "meaning_ko": "보통의", "example_en": "It is normal to feel nervous before an important exam.", "example_ko": "중요한 시험을 앞두고 긴장하는 것은 보통이다."}
{"headword": "notable", "meanings": [{"pos": "a.", "ko": "주목할 만한, 눈에 띄는"}, {"pos": "a.", "ko": "뛰어난, 탁월한"}], "meaning_ko": "주목할만한", "example_en": "There was a notable improvement in his English skills this year.", "example_ko": "올해 그의 영어 실력에 주목할만한 향상이 있었다."}
{"headword": "note", "meanings": [{"pos": "n.", "ko": "메모, 짧은 글"}, {"pos": "n.", "ko": "음, 음표"}, {"pos": "v.", "ko": "주목하다, 언급하다"}], "meaning_ko": "메모", "example_en": "She left a note on the table to remind her brother about dinner.", "example_ko": "그녀는 동생에게 저녁을 상기시키려고 탁자에 메모를 남겼다."}
{"headword": "noted", "meanings": [{"pos": "a.", "ko": "유명한, 저명한"}], "meaning_ko": "유명한", "example_en": "He is a noted scientist in the field of genetics.", "example_ko": "그는 유전학 분야에서 유명한 과학자이다."}
{"headword": "notice", "meanings": [{"pos": "n.", "ko": "주목, 주의"}, {"pos": "n.", "ko": "안내문, 공고"}, {"pos": "v.", "ko": "알아차리다, 인지하다"}], "meaning_ko": "주목", "example_en": "The teacher's notice of small changes helped the students improve.", "example_ko": "선생님의 작은 변화에 대한 주목이 학생들의 발전에 도움이 되었다."}
{"headword": "noticeable", "meanings": [{"pos": "a.", "ko": "뚜렷한, 눈에 띄는"}], "meaning_ko": "뚜렷한", "example_en": "There was a noticeable difference in her attitude after the trip.", "example_ko": "여행 후 그녀의 태도에는 뚜렷한 변화가 있었다."}
{"headword": "notification", "meanings": [{"pos": "n.", "ko": "알림, 통지"}], "meaning_ko": "알림", "example_en": "You will receive a notification when your package has shipped.", "example_ko": "택배가 발송되면 알림을 받게 됩니다."}
{"headword": "notify", "meanings": [{"pos": "v.", "ko": "알리다, 통보하다"}], "meaning_ko": "알리다", "example_en": "Please notify me if there are any changes to the schedule.", "example_ko": "일정에 변경이 있으면 저에게 알려주세요."}
{"headword": "notion", "meanings": [{"pos": "n.", "ko": "생각, 관념"}, {"pos": "n.", "ko": "개념"}], "meaning_ko": "생각", "example_en": "She had a clear notion of what she wanted to achieve.", "example_ko": "그녀는 자신이 이루고 싶은 것에 대한 분명한 생각이 있었다."}
{"headword": "nourish", "meanings": [{"pos": "v.", "ko": "영양분을 공급하다"}, {"pos": "v.", "ko": "(감정·생각 등을) 키우다, 기르다"}], "meaning_ko": "영양을 주다", "example_en": "Parents should nourish their children with healthy food and love.", "example_ko": "부모는 자녀에게 건강한 음식과 사랑으로 영양을 줘야 한다."}
{"headword": "nourishment", "meanings": [{"pos": "n.", "ko": "영양, 음식"}, {"pos": "n.", "ko": "육성, 양육"}], "meaning_ko": "영양", "example_en": "Proper nourishment is essential for a child's growth and development.", "example_ko": "적절한 영양은 아이의 성장과 발달에 꼭 필요하다."}
{"headword": "novel", "meanings": [{"pos": "n.", "ko": "(장편) 소설"}, {"pos": "a.", "ko": "새로운, 신기한"}], "meaning_ko": "소설", "example_en": "She spent the weekend reading a novel by her favorite author.", "example_ko": "그녀는 주말 내내 좋아하는 작가의 소설을 읽었다."}
{"headword": "novelist", "meanings": [{"pos": "n.", "ko": "소설가"}], "meaning_ko": "소설가", "example_en": "The novelist is working on a new book set in the future.", "example_ko": "그 소설가는 미래를 배경으로 한 새 책을 집필 중이다."}
{"headword": "novelty", "meanings": [{"pos": "n.", "ko": "새로움, 참신함"}, {"pos": "n.", "ko": "새로운 것, 신기한 물건"}], "meaning_ko": "새로움", "example_en": "The novelty of the new technology quickly attracted many users.", "example_ko": "새로운 기술의 새로움이 많은 이용자를 빠르게 끌어들였다."}
{"headword": "native", "meanings": [{"pos": "a.", "ko": "태어난 곳의, 토착의"}, {"pos": "n.", "ko": "토박이, 원주민"}], "meaning_ko": "출생지의", "example_en": "She speaks her native language fluently with her family at home.", "example_ko": "그녀는 집에서 가족과 모국어로 유창하게 대화한다."}
{"headword": "natural", "meanings": [{"pos": "a.", "ko": "자연의, 천연의"}, {"pos": "a.", "ko": "자연스러운, 인위적이지 않은"}, {"pos": "a.", "ko": "타고난, 선천적인"}], "meaning_ko": "자연의", "example_en": "Natural resources like water and trees must be protected for the future.", "example_ko": "물과 나무 같은 천연 자원은 미래를 위해 보호되어야 한다."}
{"headword": "nature", "meanings": [{"pos": "n.", "ko": "자연, 자연계"}, {"pos": "n.", "ko": "본성, 천성"}, {"pos": "n.", "ko": "특성, 성질"}], "meaning_ko": "자연", "example_en": "Spending time in nature helps people relax and reduce stress.", "example_ko": "자연 속에서 시간을 보내면 사람들이 편안해지고 스트레스가 줄어든다."}
{"headword": "navigate", "meanings": [{"pos": "v.", "ko": "길을 찾다, 항해하다"}, {"pos": "v.", "ko": "(어려운 상황을) 헤쳐 나가다"}], "meaning_ko": "길을 찾다", "example_en": "He used a map to navigate through the unfamiliar city streets.", "example_ko": "그는 낯선 도시의 거리를 지도로 길을 찾았다."}
{"headword": "navigation", "meanings": [{"pos": "n.", "ko": "항해, 운항"}, {"pos": "n.", "ko": "길 찾기, 방향 설정"}], "meaning_ko": "항해", "example_en": "Modern ships rely on advanced navigation systems for safe travel.", "example_ko": "현대 선박은 안전한 항해를 위해 첨단 항법 시스템에 의존한다."}
{"headword": "near", "meanings": [{"pos": "a.", "ko": "가까운, 인접한"}, {"pos": "ad.", "ko": "가까이, 근처에"}], "meaning_ko": "가까운", "example_en": "The library is near my school, so I visit it often after class.", "example_ko": "도서관이 학교 가까이에 있어서 나는 수업 후 자주 간다."}
{"headword": "nearly", "meanings": [{"pos": "ad.", "ko": "거의, 대략"}, {"pos": "ad.", "ko": "하마터면, 가까스로"}], "meaning_ko": "거의", "example_en": "Nearly all the students passed the final exam this semester.", "example_ko": "이번 학기에 거의 모든 학생이 기말고사를 통과했다."}
{"headword": "necessity", "meanings": [{"pos": "n.", "ko": "필요, 필수품"}, {"pos": "n.", "ko": "불가피함, 필연성"}], "meaning_ko": "필요", "example_en": "Clean water is a necessity for every human being to survive.", "example_ko": "깨끗한 물은 모든 사람이 생존하는 데 꼭 필요하다."}
{"headword": "negative", "meanings": [{"pos": "a.", "ko": "부정적인, 비관적인"}, {"pos": "a.", "ko": "반대의, 거부하는"}, {"pos": "n.", "ko": "부정, 거절"}], "meaning_ko": "부정적인", "example_en": "Constant negative thoughts can affect your mental health over time.", "example_ko": "지속적인 부정적인 생각은 시간이 지나면 정신 건강에 영향을 줄 수 있다."}
{"headword": "neglect", "meanings": [{"pos": "v.", "ko": "(의무·일을) 소홀히 하다, 게을리하다"}, {"pos": "v.", "ko": "무시하다, 간과하다"}, {"pos": "n.", "ko": "태만, 방치"}], "meaning_ko": "소홀히 하다", "example_en": "If you neglect your homework, your grades will eventually drop.", "example_ko": "숙제를 소홀히 하면 결국 성적이 떨어질 것이다."}
{"headword": "negotiate", "meanings": [{"pos": "v.", "ko": "협상하다, 교섭하다"}, {"pos": "v.", "ko": "(어려움을) 극복하다"}], "meaning_ko": "협상하다", "example_en": "The two companies will negotiate the terms of their new partnership.", "example_ko": "두 회사는 새로운 협력 조건을 협상할 예정이다."}
{"headword": "negotiation", "meanings": [{"pos": "n.", "ko": "협상, 교섭"}, {"pos": "n.", "ko": "조정, 타협"}], "meaning_ko": "협상", "example_en": "Successful negotiation requires patience and good communication skills.", "example_ko": "성공적인 협상에는 인내와 좋은 의사소통 능력이 필요하다."}
{"headword": "neighbor", "meanings": [{"pos": "n.", "ko": "이웃, 근처 사람"}, {"pos": "v.", "ko": "인접하다, 이웃하다"}], "meaning_ko": "이웃", "example_en": "My neighbor always greets me with a smile every morning.", "example_ko": "우리 이웃은 매일 아침 나에게 웃으며 인사한다."}
{"headword": "neighborhood", "meanings": [{"pos": "n.", "ko": "동네, 근처"}, {"pos": "n.", "ko": "이웃 사람들"}], "meaning_ko": "동네", "example_en": "There is a new park in our neighborhood where children can play safely.", "example_ko": "우리 동네에는 아이들이 안전하게 놀 수 있는 새 공원이 있다."}
{"headword": "nerve", "meanings": [{"pos": "n.", "ko": "신경"}, {"pos": "n.", "ko": "용기, 담력"}, {"pos": "n.", "ko": "긴장, 불안"}], "meaning_ko": "신경", "example_en": "The doctor explained how a damaged nerve can affect movement.", "example_ko": "의사는 손상된 신경이 움직임에 어떤 영향을 주는지 설명했다."}
{"headword": "nest", "meanings": [{"pos": "n.", "ko": "둥지, 보금자리"}, {"pos": "v.", "ko": "둥지를 틀다"}], "meaning_ko": "둥지", "example_en": "The bird built its nest in the tall tree behind our house.", "example_ko": "그 새는 우리 집 뒤의 큰 나무에 둥지를 지었다."}
{"headword": "neural", "meanings": [{"pos": "a.", "ko": "신경의, 신경계의"}], "meaning_ko": "신경의", "example_en": "Neural networks are used in artificial intelligence to process information.", "example_ko": "신경망은 정보를 처리하기 위해 인공지능에서 사용된다."}
{"headword": "neutral", "meanings": [{"pos": "a.", "ko": "중립의, 어느 쪽도 아닌"}, {"pos": "a.", "ko": "중간의, 특별하지 않은"}, {"pos": "n.", "ko": "중립국, 중립 상태"}], "meaning_ko": "중립의", "example_en": "The judge remained neutral during the heated discussion in court.", "example_ko": "판사는 법정에서 뜨거운 논쟁 중에도 중립을 지켰다."}
{"headword": "neutrality", "meanings": [{"pos": "n.", "ko": "중립, 중립성"}], "meaning_ko": "중립", "example_en": "The country's neutrality allowed it to avoid involvement in the war.", "example_ko": "그 나라가 중립을 지켜 전쟁에 휘말리지 않았다."}
{"headword": "nevertheless", "meanings": [{"pos": "ad.", "ko": "그럼에도 불구하고, 그렇지만"}], "meaning_ko": "그럼에도", "example_en": "It was raining heavily; nevertheless, the soccer game continued as planned.", "example_ko": "비가 많이 왔지만 축구 경기는 예정대로 계속되었다."}
{"headword": "nuclear", "meanings": [{"pos": "a.", "ko": "핵의, 원자력의"}, {"pos": "a.", "ko": "핵심적인"}], "meaning_ko": "핵의", "example_en": "Nuclear energy is used to generate electricity in many countries.", "example_ko": "핵에너지는 많은 나라에서 전기 생산에 사용된다."}
{"headword": "nuisance", "meanings": [{"pos": "n.", "ko": "성가신 것, 귀찮은 존재"}, {"pos": "n.", "ko": "방해, 불편"}, {"pos": "n.", "ko": "소란"}], "meaning_ko": "성가신 것", "example_en": "The loud construction noise became a nuisance to the residents.", "example_ko": "시끄러운 공사 소음이 주민들에게 성가신 일이 되었다."}
{"headword": "numeral", "meanings": [{"pos": "n.", "ko": "숫자, 수자"}, {"pos": "a.", "ko": "숫자를 나타내는"}], "meaning_ko": "숫자", "example_en": "The teacher wrote each numeral on the board for the students to read.", "example_ko": "선생님이 칠판에 각 숫자를 써서 학생들이 읽게 했다."}
{"headword": "numerical", "meanings": [{"pos": "a.", "ko": "수와 관련된"}, {"pos": "a.", "ko": "숫자로 나타낸"}], "meaning_ko": "수와 관련된", "example_en": "The report included a numerical analysis of the survey results.", "example_ko": "그 보고서에는 설문 결과에 대한 수치 분석이 포함되어 있었다."}
{"headword": "numerous", "meanings": [{"pos": "a.", "ko": "많은, 수많은"}, {"pos": "a.", "ko": "다수의"}], "meaning_ko": "많은", "example_en": "There are numerous reasons why people choose to study abroad.", "example_ko": "사람들이 유학을 선택하는 이유는 매우 많다."}
{"headword": "numerously", "meanings": [{"pos": "ad.", "ko": "수없이, 많이"}], "meaning_ko": "수없이", "example_en": "Wildflowers grew numerously along the side of the mountain trail.", "example_ko": "야생화가 산길 옆에 수없이 피어 있었다."}
{"headword": "nurse", "meanings": [{"pos": "n.", "ko": "간호사"}, {"pos": "v.", "ko": "간호하다, 돌보다"}, {"pos": "n.", "ko": "유모"}], "meaning_ko": "간호사", "example_en": "The nurse checked the patient's temperature every hour.", "example_ko": "간호사는 환자의 체온을 매시간 확인했다."}
{"headword": "nursery", "meanings": [{"pos": "n.", "ko": "유치원, 탁아소"}, {"pos": "n.", "ko": "아이 방"}, {"pos": "a.", "ko": "유치원의"}], "meaning_ko": "유치원", "example_en": "Parents dropped their children off at the nursery before going to work.", "example_ko": "부모들은 출근 전에 아이를 유치원에 데려다주었다."}
{"headword": "nurture", "meanings": [{"pos": "v.", "ko": "양육하다, 키우다"}, {"pos": "n.", "ko": "양육, 육성"}, {"pos": "v.", "ko": "(계획·생각 등을) 키우다"}], "meaning_ko": "양육하다", "example_en": "It is important to nurture children's creativity from an early age.", "example_ko": "어릴 때부터 아이들의 창의성을 키우는 것이 중요하다."}
{"headword": "nutrient", "meanings": [{"pos": "n.", "ko": "영양소, 영양분"}], "meaning_ko": "영양소", "example_en": "Vitamins and minerals are essential nutrients for our health.", "example_ko": "비타민과 미네랄은 건강에 꼭 필요한 영양소다."}
{"headword": "nutrition", "meanings": [{"pos": "n.", "ko": "영양, 영양 섭취"}], "meaning_ko": "영양", "example_en": "Good nutrition is necessary for proper growth and development.", "example_ko": "올바른 성장을 위해서는 좋은 영양이 필요하다."}
{"headword": "nutritional", "meanings": [{"pos": "a.", "ko": "영양상의, 영양과 관련된"}], "meaning_ko": "영양상의", "example_en": "The nutritional value of fruits makes them a healthy snack.", "example_ko": "과일은 영양가가 높아 건강한 간식이 된다."}
{"headword": "nutritious", "meanings": [{"pos": "a.", "ko": "영양가 있는, 영양분이 많은"}], "meaning_ko": "영양가 있는", "example_en": "A nutritious breakfast helps you concentrate better in class.", "example_ko": "영양가 있는 아침 식사는 수업에 더 잘 집중하게 해준다."}
{"headword": "obedience", "meanings": [{"pos": "n.", "ko": "복종, 순종"}, {"pos": "n.", "ko": "준수"}], "meaning_ko": "복종", "example_en": "Obedience to rules is important for a safe school environment.", "example_ko": "안전한 학교 환경을 위해 규칙에 복종하는 것이 중요하다."}
{"headword": "obedient", "meanings": [{"pos": "a.", "ko": "복종하는, 순종하는"}], "meaning_ko": "복종하는", "example_en": "The obedient dog followed every command given by its owner.", "example_ko": "그 개는 주인의 모든 명령에 복종했다."}
{"headword": "obesity", "meanings": [{"pos": "n.", "ko": "비만"}], "meaning_ko": "비만", "example_en": "Obesity increases the risk of many health problems.", "example_ko": "비만은 여러 건강 문제의 위험을 높인다."}
{"headword": "obey", "meanings": [{"pos": "v.", "ko": "복종하다, 따르다"}], "meaning_ko": "복종하다", "example_en": "Students are expected to obey the school's rules at all times.", "example_ko": "학생들은 항상 학교 규칙을 따라야 한다."}
{"headword": "object", "meanings": [{"pos": "n.", "ko": "물체, 사물"}, {"pos": "n.", "ko": "목적, 목표"}, {"pos": "n.", "ko": "대상"}, {"pos": "v.", "ko": "반대하다, 이의를 제기하다"}], "meaning_ko": "물체", "example_en": "The object on the table was made of glass and looked fragile.", "example_ko": "탁자 위의 물체는 유리로 만들어져 쉽게 깨질 것 같았다."}
{"headword": "objection", "meanings": [{"pos": "n.", "ko": "반대, 이의"}, {"pos": "n.", "ko": "거부"}], "meaning_ko": "반대", "example_en": "She raised an objection to the proposed changes in the schedule.", "example_ko": "그녀는 일정 변경안에 대해 반대 의견을 냈다."}
{"headword": "objective", "meanings": [{"pos": "n.", "ko": "목적, 목표"}, {"pos": "a.", "ko": "객관적인"}], "meaning_ko": "목적", "example_en": "Our main objective is to improve the quality of education.", "example_ko": "우리의 주된 목적은 교육의 질을 높이는 것이다."}
{"headword": "obligate", "meanings": [{"pos": "v.", "ko": "의무를 지우다, 강제로 하게 하다"}, {"pos": "a.", "ko": "의무적인, 필수의"}], "meaning_ko": "의무를 지우다", "example_en": "The new law will obligate companies to reduce their carbon emissions.", "example_ko": "새 법은 기업들에게 탄소 배출을 줄일 의무를 부과할 것이다."}
{"headword": "obligation", "meanings": [{"pos": "n.", "ko": "의무, 해야 할 일"}, {"pos": "n.", "ko": "책임, 빚짐"}], "meaning_ko": "의무", "example_en": "You have an obligation to complete your assignments on time.", "example_ko": "너는 과제를 제때 끝내야 할 의무가 있다."}
{"headword": "obligatory", "meanings": [{"pos": "a.", "ko": "의무적인, 반드시 해야 하는"}, {"pos": "a.", "ko": "강제적인, 필수의"}], "meaning_ko": "의무적인", "example_en": "Wearing a helmet is obligatory when riding a motorcycle in this country.", "example_ko": "이 나라에서는 오토바이를 탈 때 헬멧 착용이 의무적이다."}
{"headword": "oblige", "meanings": [{"pos": "v.", "ko": "(어떤 일을) 하도록 강요하다, 의무를 지우다"}, {"pos": "v.", "ko": "(도움이나 부탁을) 들어주다, 도와주다"}], "meaning_ko": "강요하다", "example_en": "The rules oblige all students to attend the safety training.", "example_ko": "규칙에 따라 모든 학생은 안전 교육에 참석해야 한다."}
{"headword": "obscure", "meanings": [{"pos": "a.", "ko": "잘 알려지지 않은, 무명의"}, {"pos": "a.", "ko": "이해하기 어려운, 모호한"}, {"pos": "v.", "ko": "가리다, 흐리게 하다"}], "meaning_ko": "모호한", "example_en": "The meaning of the poem remains obscure even after several readings.", "example_ko": "그 시의 의미는 여러 번 읽어도 여전히 모호하다."}
{"headword": "observance", "meanings": [{"pos": "n.", "ko": "(법, 규칙 등의) 준수, 지킴"}, {"pos": "n.", "ko": "(의식, 행사 등의) 거행"}], "meaning_ko": "준수", "example_en": "Strict observance of the rules is required during the exam.", "example_ko": "시험 중에는 규칙을 엄격히 지켜야 한다."}
{"headword": "observation", "meanings": [{"pos": "n.", "ko": "관찰, 주시"}, {"pos": "n.", "ko": "관측, 조사"}, {"pos": "n.", "ko": "의견, 논평"}], "meaning_ko": "관찰", "example_en": "Careful observation of animal behavior can reveal many interesting facts.", "example_ko": "동물의 행동을 주의 깊게 관찰하면 많은 흥미로운 사실을 알 수 있다."}
{"headword": "observatory", "meanings": [{"pos": "n.", "ko": "관측소, 천문대"}, {"pos": "n.", "ko": "기상대"}], "meaning_ko": "관측소", "example_en": "The observatory allows scientists to study stars and planets in detail.", "example_ko": "관측소에서는 과학자들이 별과 행성을 자세히 연구할 수 있다."}
{"headword": "observe", "meanings": [{"pos": "v.", "ko": "관찰하다, 주시하다"}, {"pos": "v.", "ko": "지키다, 준수하다"}, {"pos": "v.", "ko": "알아차리다, 인지하다"}, {"pos": "v.", "ko": "(의견을) 말하다, 진술하다"}], "meaning_ko": "관찰하다", "example_en": "Scientists observe the changes in temperature during the experiment.", "example_ko": "과학자들은 실험 중 온도의 변화를 관찰한다."}
{"headword": "observer", "meanings": [{"pos": "n.", "ko": "관찰자, 지켜보는 사람"}, {"pos": "n.", "ko": "참관인, 감시자"}], "meaning_ko": "관찰자", "example_en": "An independent observer monitored the election to ensure fairness.", "example_ko": "공정성을 위해 독립된 관찰자가 선거를 감시했다."}
{"headword": "obsess", "meanings": [{"pos": "v.", "ko": "(생각이) 사로잡다, 집착하게 하다"}, {"pos": "v.", "ko": "강박감을 갖게 하다"}], "meaning_ko": "사로잡다", "example_en": "She tends to obsess over small details in her work.", "example_ko": "그녀는 일할 때 사소한 것에 집착하는 경향이 있다."}
{"headword": "obsession", "meanings": [{"pos": "n.", "ko": "강박, 집착"}, {"pos": "n.", "ko": "집념, 몰두"}], "meaning_ko": "집착", "example_en": "His obsession with perfection often slows down his progress.", "example_ko": "완벽에 대한 그의 집착이 종종 진도를 늦춘다."}
{"headword": "obstacle", "meanings": [{"pos": "n.", "ko": "장애물, 방해물"}, {"pos": "n.", "ko": "어려움, 곤란"}], "meaning_ko": "장애물", "example_en": "Lack of money became the biggest obstacle to their project.", "example_ko": "자금 부족이 그들의 프로젝트에 가장 큰 장애물이 되었다."}
{"headword": "obstruct", "meanings": [{"pos": "v.", "ko": "막다, 방해하다"}, {"pos": "v.", "ko": "(진로·시야 등을) 차단하다"}], "meaning_ko": "막다", "example_en": "A fallen tree obstructed the road after the storm.", "example_ko": "폭풍 후 쓰러진 나무가 도로를 막았다."}
{"headword": "obtain", "meanings": [{"pos": "v.", "ko": "얻다, 획득하다"}, {"pos": "v.", "ko": "손에 넣다"}], "meaning_ko": "얻다", "example_en": "You must obtain permission before using these materials.", "example_ko": "이 자료를 사용하려면 반드시 허가를 받아야 한다."}
{"headword": "obvious", "meanings": [{"pos": "a.", "ko": "분명한, 명백한"}, {"pos": "a.", "ko": "쉽게 알 수 있는"}], "meaning_ko": "분명한", "example_en": "It was obvious that he had not prepared for the presentation.", "example_ko": "그가 발표 준비를 안 했다는 건 분명했다."}
{"headword": "obviously", "meanings": [{"pos": "ad.", "ko": "명백히, 분명히"}, {"pos": "ad.", "ko": "확실히"}], "meaning_ko": "명백히", "example_en": "Obviously, the team needs to practice more before the next game.", "example_ko": "명백히, 그 팀은 다음 경기를 위해 더 연습해야 한다."}
{"headword": "occasion", "meanings": [{"pos": "n.", "ko": "(특정한) 때, 경우"}, {"pos": "n.", "ko": "특별한 일, 행사"}], "meaning_ko": "경우", "example_en": "On this occasion, we decided to try something new.", "example_ko": "이번에는 새로운 것을 시도하기로 했다."}
{"headword": "occasional", "meanings": [{"pos": "a.", "ko": "가끔의, 때때로 일어나는"}, {"pos": "a.", "ko": "이따금씩의"}], "meaning_ko": "가끔의", "example_en": "He makes occasional visits to his hometown during the holidays.", "example_ko": "그는 명절에 가끔 고향을 방문한다."}
{"headword": "occasionally", "meanings": [{"pos": "ad.", "ko": "가끔, 때때로"}, {"pos": "ad.", "ko": "이따금"}], "meaning_ko": "가끔", "example_en": "I occasionally go for a walk in the park after dinner.", "example_ko": "나는 저녁 식사 후에 가끔 공원 산책을 한다."}
{"headword": "occupation", "meanings": [{"pos": "n.", "ko": "직업, 일"}, {"pos": "n.", "ko": "점령, 점유"}, {"pos": "n.", "ko": "여가 활동"}], "meaning_ko": "직업", "example_en": "She chose teaching as her main occupation after graduating from university.", "example_ko": "그녀는 대학을 졸업한 후 교직을 자신의 주요 직업으로 선택했다."}
{"headword": "occupy", "meanings": [{"pos": "v.", "ko": "차지하다, 점유하다"}, {"pos": "v.", "ko": "(방, 건물 등을) 사용하다"}, {"pos": "v.", "ko": "점령하다"}], "meaning_ko": "차지하다", "example_en": "The students occupy most of the seats in the library during exam season.", "example_ko": "시험 기간에는 학생들이 도서관 좌석 대부분을 차지한다."}
{"headword": "occur", "meanings": [{"pos": "v.", "ko": "일어나다, 발생하다"}, {"pos": "v.", "ko": "(생각 등이) 떠오르다"}], "meaning_ko": "일어나다", "example_en": "Several unexpected problems may occur during the experiment.", "example_ko": "실험 중에 여러 예상치 못한 문제가 일어날 수 있다."}
{"headword": "occurrence", "meanings": [{"pos": "n.", "ko": "발생, 일어남"}, {"pos": "n.", "ko": "사건, 일어난 일"}], "meaning_ko": "발생", "example_en": "The sudden occurrence of the storm surprised everyone in the town.", "example_ko": "갑작스러운 폭풍의 발생이 마을 사람 모두를 놀라게 했다."}
{"headword": "odd", "meanings": [{"pos": "a.", "ko": "이상한, 특이한"}, {"pos": "a.", "ko": "홀수의"}, {"pos": "a.", "ko": "어울리지 않는, 남는"}], "meaning_ko": "이상한", "example_en": "It seemed odd that nobody answered the phone during business hours.", "example_ko": "영업 시간에 아무도 전화를 받지 않는 것이 이상하게 느껴졌다."}
{"headword": "offend", "meanings": [{"pos": "v.", "ko": "기분 상하게 하다, 불쾌하게 하다"}, {"pos": "v.", "ko": "위반하다, 죄를 짓다"}], "meaning_ko": "기분 상하게 하다", "example_en": "He did not mean to offend anyone with his careless words.", "example_ko": "그는 부주의한 말로 누구의 기분을 상하게 할 의도가 아니었다."}
{"headword": "offender", "meanings": [{"pos": "n.", "ko": "범죄자, 위반자"}], "meaning_ko": "범죄자", "example_en": "The police quickly arrested the offender after the theft was reported.", "example_ko": "경찰은 도난 신고 후 신속히 범죄자를 체포했다."}
{"headword": "offense", "meanings": [{"pos": "n.", "ko": "위반, 범죄"}, {"pos": "n.", "ko": "무례, 모욕"}, {"pos": "n.", "ko": "공격"}], "meaning_ko": "위반", "example_en": "Driving without a license is considered a serious offense in many countries.", "example_ko": "무면허 운전은 많은 나라에서 심각한 위반으로 간주된다."}
{"headword": "offensive", "meanings": [{"pos": "a.", "ko": "불쾌한, 모욕적인"}, {"pos": "a.", "ko": "공격적인, 공격용의"}], "meaning_ko": "불쾌한", "example_en": "His offensive remarks upset many people at the meeting.", "example_ko": "그의 불쾌한 발언이 회의에서 많은 사람들을 불쾌하게 했다."}
{"headword": "offer", "meanings": [{"pos": "v.", "ko": "제안하다, 권하다"}, {"pos": "v.", "ko": "제공하다, 내놓다"}, {"pos": "n.", "ko": "제안, 제공"}], "meaning_ko": "제안하다", "example_en": "She offered to help me with my homework after school.", "example_ko": "그녀는 방과 후 내 숙제를 도와주겠다고 제안했다."}
{"headword": "official", "meanings": [{"pos": "a.", "ko": "공식적인, 공무상의"}, {"pos": "n.", "ko": "공무원, 임원"}], "meaning_ko": "공식적인", "example_en": "The official announcement was made by the school principal this morning.", "example_ko": "공식 발표는 오늘 아침 교장 선생님에 의해 이루어졌다."}
{"headword": "offspring", "meanings": [{"pos": "n.", "ko": "자식, 자손"}, {"pos": "n.", "ko": "결과, 산물"}], "meaning_ko": "자식", "example_en": "The mother bird feeds her offspring every morning in the nest.", "example_ko": "어미 새는 매일 아침 둥지에서 새끼들에게 먹이를 준다."}
{"headword": "omission", "meanings": [{"pos": "n.", "ko": "생략, 누락"}, {"pos": "n.", "ko": "빠진 것"}], "meaning_ko": "생략", "example_en": "The omission of important details made the report unclear.", "example_ko": "중요한 세부 사항의 생략으로 보고서가 불분명해졌다."}
{"headword": "omit", "meanings": [{"pos": "v.", "ko": "생략하다, 빼다"}, {"pos": "v.", "ko": "빠뜨리다"}], "meaning_ko": "생략하다", "example_en": "You should not omit any steps when following the instructions.", "example_ko": "지침을 따를 때 어떤 단계도 생략해서는 안 된다."}
{"headword": "ongoing", "meanings": [{"pos": "a.", "ko": "진행 중인, 계속되는"}], "meaning_ko": "진행 중인", "example_en": "There is an ongoing investigation into the cause of the accident.", "example_ko": "사고 원인에 대한 조사가 진행 중이다."}
{"headword": "operate", "meanings": [{"pos": "v.", "ko": "작동하다, 움직이다"}, {"pos": "v.", "ko": "작동시키다, 조작하다"}, {"pos": "v.", "ko": "영업하다, 운영하다"}, {"pos": "v.", "ko": "수술하다"}], "meaning_ko": "작동하다", "example_en": "This machine will not operate without a proper power supply.", "example_ko": "이 기계는 적절한 전원이 없으면 작동하지 않는다."}
{"headword": "operation", "meanings": [{"pos": "n.", "ko": "수술"}, {"pos": "n.", "ko": "사업, 영업"}, {"pos": "n.", "ko": "작업, 조작"}], "meaning_ko": "수술", "example_en": "The operation was successful, and the patient is now recovering.", "example_ko": "수술이 성공적으로 끝나 환자가 회복 중이다."}
{"headword": "operator", "meanings": [{"pos": "n.", "ko": "조작자, 운영자"}, {"pos": "n.", "ko": "경영자"}], "meaning_ko": "조작자", "example_en": "The elevator operator pressed the button to take us to the top floor.", "example_ko": "엘리베이터 조작자가 우리를 꼭대기 층으로 데려다주기 위해 버튼을 눌렀다."}
{"headword": "opinion", "meanings": [{"pos": "n.", "ko": "의견, 생각, 견해"}], "meaning_ko": "의견", "example_en": "In my opinion, reading books is the best way to learn new things.", "example_ko": "내 생각에는 책을 읽는 것이 새로운 것을 배우는 가장 좋은 방법이다."}
{"headword": "opponent", "meanings": [{"pos": "n.", "ko": "상대, 적"}, {"pos": "n.", "ko": "반대자"}], "meaning_ko": "상대", "example_en": "Her opponent in the debate was well-prepared and confident.", "example_ko": "토론에서 그녀의 상대는 준비가 잘 되어 있었고 자신감이 있었다."}
{"headword": "opportunity", "meanings": [{"pos": "n.", "ko": "좋은 기회"}, {"pos": "n.", "ko": "가능성"}, {"pos": "n.", "ko": "유리한 상황"}], "meaning_ko": "좋은 기회", "example_en": "This competition gives students an excellent opportunity to show their talents.", "example_ko": "이 대회는 학생들에게 재능을 보여줄 좋은 기회를 제공합니다."}
{"headword": "oppose", "meanings": [{"pos": "v.", "ko": "반대하다"}, {"pos": "v.", "ko": "저항하다"}, {"pos": "v.", "ko": "대립하다"}], "meaning_ko": "반대하다", "example_en": "Many citizens strongly oppose the new law proposed by the government.", "example_ko": "많은 시민들이 정부가 제안한 새 법안에 강하게 반대한다."}
{"headword": "opposite", "meanings": [{"pos": "a.", "ko": "정반대의"}, {"pos": "a.", "ko": "맞은편의"}, {"pos": "n.", "ko": "반대되는 사람 또는 것"}], "meaning_ko": "정반대의", "example_en": "Her opinion is completely opposite to what I believe about the issue.", "example_ko": "그녀의 의견은 내가 그 문제에 대해 생각하는 것과 완전히 정반대다."}
{"headword": "oppress", "meanings": [{"pos": "v.", "ko": "억압하다"}, {"pos": "v.", "ko": "탄압하다"}, {"pos": "v.", "ko": "압박하다"}], "meaning_ko": "억압하다", "example_en": "The regime continued to oppress people who spoke out against its policies.", "example_ko": "그 정권은 정책에 반대 목소리를 낸 사람들을 계속 억압했다."}
{"headword": "oppression", "meanings": [{"pos": "n.", "ko": "억압"}, {"pos": "n.", "ko": "탄압"}, {"pos": "n.", "ko": "압제"}], "meaning_ko": "억압", "example_en": "Throughout history, many groups have suffered from oppression and injustice.", "example_ko": "역사적으로 많은 집단이 억압과 불의를 겪어 왔다."}
{"headword": "optical", "meanings": [{"pos": "a.", "ko": "시각의"}, {"pos": "a.", "ko": "광학의"}, {"pos": "a.", "ko": "눈으로 볼 수 있는"}], "meaning_ko": "시각의", "example_en": "The scientist used an optical instrument to closely examine the tiny object.", "example_ko": "과학자는 작은 물체를 자세히 살피기 위해 광학 기기를 사용했다."}
{"headword": "optimal", "meanings": [{"pos": "a.", "ko": "최적의"}, {"pos": "a.", "ko": "가장 알맞은"}, {"pos": "a.", "ko": "최상의"}], "meaning_ko": "최적의", "example_en": "For optimal results, you should follow the instructions carefully.", "example_ko": "최적의 결과를 얻으려면 지침을 꼼꼼히 따라야 한다."}
{"headword": "optimism", "meanings": [{"pos": "n.", "ko": "낙관주의"}, {"pos": "n.", "ko": "낙천적인 태도"}, {"pos": "n.", "ko": "긍정적 생각"}], "meaning_ko": "낙관주의", "example_en": "Her optimism helped the team stay positive during difficult times.", "example_ko": "그녀의 낙관주의 덕분에 팀은 힘든 시기에도 긍정적으로 지낼 수 있었다."}
{"headword": "optimist", "meanings": [{"pos": "n.", "ko": "낙관주의자"}, {"pos": "n.", "ko": "낙천적인 사람"}], "meaning_ko": "낙관주의자", "example_en": "As an optimist, he always expects things to turn out well.", "example_ko": "그는 낙관주의자라서 항상 일이 잘 풀릴 거라고 기대한다."}
{"headword": "optimistic", "meanings": [{"pos": "a.", "ko": "낙관적인"}, {"pos": "a.", "ko": "긍정적인"}, {"pos": "a.", "ko": "희망적인"}], "meaning_ko": "낙관적인", "example_en": "Despite the challenges, she remains optimistic about the future.", "example_ko": "어려움에도 불구하고 그녀는 미래에 대해 낙관적이다."}
{"headword": "option", "meanings": [{"pos": "n.", "ko": "선택권"}, {"pos": "n.", "ko": "선택지"}, {"pos": "n.", "ko": "옵션"}], "meaning_ko": "선택권", "example_en": "You have the option to take either the bus or the subway to school.", "example_ko": "학교에 갈 때 버스나 지하철 중에서 선택할 수 있다."}
{"headword": "optional", "meanings": [{"pos": "a.", "ko": "선택적인"}, {"pos": "a.", "ko": "필수가 아닌"}], "meaning_ko": "선택적인", "example_en": "Wearing a uniform is optional at this school, not mandatory.", "example_ko": "이 학교에서는 교복 착용이 선택적이며 필수는 아니다."}
{"headword": "oral", "meanings": [{"pos": "a.", "ko": "구두의"}, {"pos": "a.", "ko": "입의"}, {"pos": "a.", "ko": "말로 하는"}], "meaning_ko": "구두의", "example_en": "The final exam will include both written and oral questions.", "example_ko": "기말고사에는 필기와 구두 시험이 모두 포함된다."}
{"headword": "orbit", "meanings": [{"pos": "n.", "ko": "궤도"}, {"pos": "v.", "ko": "궤도를 돌다"}], "meaning_ko": "궤도", "example_en": "The satellite will remain in orbit around the Earth for several years.", "example_ko": "그 인공위성은 몇 년 동안 지구 궤도를 돌게 된다."}
{"headword": "orchard", "meanings": [{"pos": "n.", "ko": "과수원"}], "meaning_ko": "과수원", "example_en": "We visited an apple orchard to pick fresh fruit during the fall.", "example_ko": "가을에 우리는 신선한 과일을 따려고 사과 과수원에 갔다."}
{"headword": "orchestra", "meanings": [{"pos": "n.", "ko": "관현악단"}, {"pos": "n.", "ko": "오케스트라"}], "meaning_ko": "관현악단", "example_en": "The orchestra performed a beautiful piece at the concert last night.", "example_ko": "어젯밤 콘서트에서 관현악단이 아름다운 곡을 연주했다."}
{"headword": "orderly", "meanings": [{"pos": "a.", "ko": "정돈된"}, {"pos": "a.", "ko": "질서 있는"}], "meaning_ko": "정돈된", "example_en": "The students lined up in an orderly fashion before entering the classroom.", "example_ko": "학생들은 교실에 들어가기 전에 질서 있게 줄을 섰다."}
{"headword": "ordinarily", "meanings": [{"pos": "ad.", "ko": "보통"}, {"pos": "ad.", "ko": "대체로"}, {"pos": "ad.", "ko": "일반적으로"}], "meaning_ko": "보통", "example_en": "Ordinarily, she takes the bus to work, but today she walked.", "example_ko": "평소에는 버스를 타고 출근하지만 오늘은 걸어갔다."}
{"headword": "ordinary", "meanings": [{"pos": "a.", "ko": "평범한"}, {"pos": "a.", "ko": "보통의"}, {"pos": "a.", "ko": "특별하지 않은"}], "meaning_ko": "평범한", "example_en": "He wore an ordinary shirt, nothing special or fancy.", "example_ko": "그는 특별하거나 화려하지 않은 평범한 셔츠를 입었다."}
{"headword": "organ", "meanings": [{"pos": "n.", "ko": "(생물의) 기관"}, {"pos": "n.", "ko": "오르간(악기)"}], "meaning_ko": "기관", "example_en": "The heart is a vital organ that pumps blood throughout the body.", "example_ko": "심장은 온몸에 피를 보내는 중요한 기관이다."}
{"headword": "partially", "meanings": [{"pos": "ad.", "ko": "부분적으로"}, {"pos": "ad.", "ko": "어느 정도"}], "meaning_ko": "부분적으로", "example_en": "The project was only partially completed due to a lack of time.", "example_ko": "시간 부족으로 그 프로젝트는 부분적으로만 완성되었다."}
{"headword": "participant", "meanings": [{"pos": "n.", "ko": "참가자"}, {"pos": "n.", "ko": "참여자"}], "meaning_ko": "참가자", "example_en": "Each participant received a certificate after finishing the race.", "example_ko": "각 참가자는 경주를 마친 후에 증서를 받았다."}
{"headword": "participate", "meanings": [{"pos": "v.", "ko": "참가하다"}, {"pos": "v.", "ko": "참여하다"}], "meaning_ko": "참가하다", "example_en": "Students are encouraged to participate in school activities.", "example_ko": "학생들은 학교 활동에 참가하도록 권장된다."}
{"headword": "participate in", "meanings": [{"pos": "phr.", "ko": "~에 참가하다"}, {"pos": "phr.", "ko": "~에 참여하다"}], "meaning_ko": "~에 참가하다", "example_en": "Many citizens participate in the annual city marathon.", "example_ko": "많은 시민들이 매년 열리는 시 마라톤에 참가한다."}
{"headword": "participation", "meanings": [{"pos": "n.", "ko": "참가"}, {"pos": "n.", "ko": "참여"}], "meaning_ko": "참가", "example_en": "Active participation in class helps students understand the material better.", "example_ko": "수업에 적극적으로 참가하면 학생들이 내용을 더 잘 이해할 수 있다."}
{"headword": "particle", "meanings": [{"pos": "n.", "ko": "작은 조각"}, {"pos": "n.", "ko": "입자"}, {"pos": "n.", "ko": "소량"}], "meaning_ko": "작은 조각", "example_en": "A single dust particle can be seen under a microscope.", "example_ko": "현미경으로 보면 먼지의 작은 조각 하나도 볼 수 있다."}
{"headword": "particular", "meanings": [{"pos": "a.", "ko": "특정한"}, {"pos": "a.", "ko": "특별한"}, {"pos": "a.", "ko": "까다로운"}], "meaning_ko": "특정한", "example_en": "He is looking for a particular book that is hard to find.", "example_ko": "그는 찾기 힘든 특정한 책을 찾고 있다."}
{"headword": "particularly", "meanings": [{"pos": "ad.", "ko": "특히"}, {"pos": "ad.", "ko": "그 중에서도"}], "meaning_ko": "특히", "example_en": "She was particularly interested in environmental issues.", "example_ko": "그녀는 특히 환경 문제에 관심이 많았다."}
{"headword": "passage", "meanings": [{"pos": "n.", "ko": "통로"}, {"pos": "n.", "ko": "구절"}, {"pos": "n.", "ko": "통과"}], "meaning_ko": "통로", "example_en": "The narrow passage led to a beautiful garden.", "example_ko": "좁은 통로가 아름다운 정원으로 이어졌다."}
{"headword": "passenger", "meanings": [{"pos": "n.", "ko": "승객"}, {"pos": "n.", "ko": "여객"}], "meaning_ko": "승객", "example_en": "Each passenger must show a ticket before boarding the train.", "example_ko": "모든 승객은 기차에 타기 전에 표를 보여야 한다."}
{"headword": "passerby", "meanings": [{"pos": "n.", "ko": "지나가는 사람"}, {"pos": "n.", "ko": "통행인"}], "meaning_ko": "지나가는 사람", "example_en": "A passerby helped the child cross the busy street safely.", "example_ko": "지나가는 사람이 아이가 복잡한 길을 안전하게 건너도록 도와주었다."}
{"headword": "passion", "meanings": [{"pos": "n.", "ko": "열정"}, {"pos": "n.", "ko": "애착"}], "meaning_ko": "열정", "example_en": "She spoke about her passion for music during the interview.", "example_ko": "그녀는 인터뷰에서 음악에 대한 열정을 이야기했다."}
{"headword": "passionate", "meanings": [{"pos": "a.", "ko": "열렬한"}, {"pos": "a.", "ko": "정열적인"}], "meaning_ko": "열렬한", "example_en": "He is a passionate supporter of animal rights.", "example_ko": "그는 동물 권리의 열렬한 지지자이다."}
{"headword": "passionately", "meanings": [{"pos": "ad.", "ko": "열정적으로"}], "meaning_ko": "열정적으로", "example_en": "The artist passionately described her creative process to the audience.", "example_ko": "그 예술가는 자신의 창작 과정을 청중에게 열정적으로 설명했다."}
{"headword": "passive", "meanings": [{"pos": "a.", "ko": "수동적인"}, {"pos": "a.", "ko": "소극적인"}], "meaning_ko": "수동적인", "example_en": "A passive attitude can make it hard to achieve your goals.", "example_ko": "수동적인 태도는 목표를 이루기 어렵게 만들 수 있다."}
{"headword": "paste", "meanings": [{"pos": "n.", "ko": "풀"}, {"pos": "v.", "ko": "붙이다"}], "meaning_ko": "풀", "example_en": "Use some paste to attach the poster to the wall.", "example_ko": "포스터를 벽에 붙이려면 풀을 사용해라."}
{"headword": "pastime", "meanings": [{"pos": "n.", "ko": "오락"}, {"pos": "n.", "ko": "놀이"}], "meaning_ko": "오락", "example_en": "Reading novels is a popular pastime among teenagers.", "example_ko": "소설 읽기는 청소년들 사이에서 인기 있는 오락이다."}
{"headword": "pasture", "meanings": [{"pos": "n.", "ko": "목초지"}, {"pos": "n.", "ko": "방목장"}], "meaning_ko": "목초지", "example_en": "Cows were grazing peacefully in the green pasture.", "example_ko": "소들이 푸른 목초지에서 평화롭게 풀을 뜯고 있었다."}
{"headword": "patch", "meanings": [{"pos": "n.", "ko": "조각"}, {"pos": "n.", "ko": "헝겊 조각"}, {"pos": "v.", "ko": "수선하다"}], "meaning_ko": "조각", "example_en": "There is a small patch of flowers in the corner of the yard.", "example_ko": "마당 한쪽 구석에 작은 꽃밭이 있다."}
{"headword": "patent", "meanings": [{"pos": "n.", "ko": "특허"}, {"pos": "v.", "ko": "특허를 얻다"}, {"pos": "a.", "ko": "특허의"}], "meaning_ko": "특허", "example_en": "She applied for a patent for her new invention last year.", "example_ko": "그녀는 작년에 자신의 새 발명품에 대해 특허를 신청했다."}
{"headword": "overturn", "meanings": [{"pos": "v.", "ko": "뒤집다, 전복시키다"}, {"pos": "v.", "ko": "(판결·결정 등을) 뒤엎다"}, {"pos": "n.", "ko": "전복, 전도"}], "meaning_ko": "뒤집다", "example_en": "The strong wind could easily overturn small boats in the lake.", "example_ko": "강한 바람이 호수의 작은 배를 쉽게 뒤집을 수 있다."}
{"headword": "overweight", "meanings": [{"pos": "a.", "ko": "과체중인, 너무 무거운"}, {"pos": "n.", "ko": "과체중, 초과 중량"}], "meaning_ko": "과체중인", "example_en": "Doctors advise people who are overweight to exercise regularly.", "example_ko": "의사들은 과체중인 사람들에게 규칙적인 운동을 권한다."}
{"headword": "overwhelm", "meanings": [{"pos": "v.", "ko": "압도하다, 제압하다"}, {"pos": "v.", "ko": "(감정 등이) 휩싸다, 당황하게 하다"}, {"pos": "v.", "ko": "(수·양으로) 압도하다"}], "meaning_ko": "압도하다", "example_en": "The amount of homework can overwhelm students during exam periods.", "example_ko": "시험 기간에는 숙제 양이 학생들을 압도할 수 있다."}
{"headword": "overwhelmed", "meanings": [{"pos": "a.", "ko": "압도된, 감당하지 못하는"}, {"pos": "a.", "ko": "(감정에) 휩싸인, 어쩔 줄 모르는"}], "meaning_ko": "압도된", "example_en": "She felt overwhelmed by the number of tasks she had to finish.", "example_ko": "그녀는 해야 할 일이 너무 많아 압도된 기분이었다."}
{"headword": "overwhelming", "meanings": [{"pos": "a.", "ko": "압도적인, 저항할 수 없는"}, {"pos": "a.", "ko": "(감정 등이) 엄청난, 벅찬"}], "meaning_ko": "압도적인", "example_en": "The evidence against the suspect was overwhelming in court.", "example_ko": "법정에서 피의자에게 불리한 증거가 압도적으로 많았다."}
{"headword": "owe", "meanings": [{"pos": "v.", "ko": "빚지고 있다, (돈을) 갚아야 하다"}, {"pos": "v.", "ko": "(감사·명예 등을) ~의 덕분으로 여기다"}], "meaning_ko": "빚지다", "example_en": "I still owe my friend some money from last month.", "example_ko": "나는 아직 지난달에 친구에게 빌린 돈을 갚지 않았다."}
{"headword": "pace", "meanings": [{"pos": "n.", "ko": "속도, 페이스"}, {"pos": "n.", "ko": "걸음, 보폭"}, {"pos": "v.", "ko": "천천히 걷다, 서성이다"}], "meaning_ko": "속도", "example_en": "The pace of technological change is increasing every year.", "example_ko": "기술 변화의 속도가 해마다 빨라지고 있다."}
{"headword": "package", "meanings": [{"pos": "n.", "ko": "꾸러미, 소포"}, {"pos": "n.", "ko": "포장, 패키지"}, {"pos": "v.", "ko": "포장하다, 꾸리다"}], "meaning_ko": "소포", "example_en": "The package arrived at my house earlier than I expected.", "example_ko": "그 소포는 내가 예상한 것보다 일찍 우리 집에 도착했다."}
{"headword": "paddle", "meanings": [{"pos": "n.", "ko": "노, 패들"}, {"pos": "v.", "ko": "노를 젓다"}, {"pos": "v.", "ko": "(얕은 물에서) 첨벙거리다"}], "meaning_ko": "노", "example_en": "Each person used a paddle to move the canoe across the river.", "example_ko": "각자는 노를 사용해 카누를 강 건너로 움직였다."}
{"headword": "painkiller", "meanings": [{"pos": "n.", "ko": "진통제"}], "meaning_ko": "진통제", "example_en": "He took a painkiller to relieve his headache before the test.", "example_ko": "그는 시험 전에 두통을 완화하려고 진통제를 먹었다."}
{"headword": "pair", "meanings": [{"pos": "n.", "ko": "한 쌍, 두 개가 한 조인 것"}, {"pos": "n.", "ko": "한 개(쌍을 이루는 것 중 하나)"}, {"pos": "v.", "ko": "짝을 짓다, 한 쌍이 되다"}], "meaning_ko": "한 쌍", "example_en": "I bought a new pair of shoes for the school festival.", "example_ko": "나는 학교 축제를 위해 새 신발 한 켤레를 샀다."}
{"headword": "panel", "meanings": [{"pos": "n.", "ko": "토론단, 심사위원단"}, {"pos": "n.", "ko": "판, 널빤지"}, {"pos": "n.", "ko": "(기계의) 제어판, 패널"}], "meaning_ko": "토론단", "example_en": "A panel of experts discussed climate change at the conference.", "example_ko": "전문가 토론단이 회의에서 기후 변화에 대해 논의했다."}
{"headword": "panic", "meanings": [{"pos": "n.", "ko": "공황, 극심한 두려움"}, {"pos": "v.", "ko": "공포에 질리다, 당황하다"}], "meaning_ko": "공황", "example_en": "There was a brief panic when the fire alarm suddenly rang.", "example_ko": "화재 경보가 갑자기 울리자 잠시 공황 상태가 됐다."}
{"headword": "paradigm", "meanings": [{"pos": "n.", "ko": "전형, 모범"}, {"pos": "n.", "ko": "사고의 틀, 패러다임"}], "meaning_ko": "전형", "example_en": "The company created a new paradigm for customer service.", "example_ko": "그 회사는 고객 서비스의 새로운 전형을 만들었다."}
{"headword": "paradox", "meanings": [{"pos": "n.", "ko": "역설, 모순된 말"}, {"pos": "n.", "ko": "모순, 상반되는 상황"}], "meaning_ko": "역설", "example_en": "It is a paradox that technology can both connect and isolate people.", "example_ko": "기술이 사람을 연결하면서도 고립시킬 수 있다는 점이 역설이다."}
{"headword": "paradoxically", "meanings": [{"pos": "ad.", "ko": "역설적으로, 모순되게도"}], "meaning_ko": "역설적으로", "example_en": "Paradoxically, working less can sometimes make you more productive.", "example_ko": "역설적으로, 일을 덜 하면 오히려 생산성이 높아질 때도 있다."}
{"headword": "parallel", "meanings": [{"pos": "a.", "ko": "평행한, 나란한"}, {"pos": "n.", "ko": "유사점, 평행선"}, {"pos": "v.", "ko": "~와 유사하다, 평행하다"}], "meaning_ko": "평행한", "example_en": "The two roads run parallel to each other for several kilometers.", "example_ko": "두 도로는 몇 킬로미터 동안 서로 평행하게 뻗어 있다."}
{"headword": "paralysis", "meanings": [{"pos": "n.", "ko": "마비, 활동 불능 (상태)"}], "meaning_ko": "마비", "example_en": "The accident caused temporary paralysis in his legs.", "example_ko": "그 사고로 그는 다리에 일시적인 마비가 왔다."}
{"headword": "paralyze", "meanings": [{"pos": "v.", "ko": "마비시키다, 움직이지 못하게 하다"}, {"pos": "v.", "ko": "(기능·활동을) 정지시키다"}], "meaning_ko": "마비시키다", "example_en": "A severe injury can paralyze a person for life.", "example_ko": "심한 부상은 사람을 평생 마비시킬 수 있다."}
{"headword": "partial", "meanings": [{"pos": "a.", "ko": "부분적인, 일부분의"}, {"pos": "a.", "ko": "불공평한, 편파적인"}, {"pos": "a.", "ko": "특히 좋아하는, 편애하는"}], "meaning_ko": "부분적인", "example_en": "We only have partial information about the new policy.", "example_ko": "우리는 새 정책에 대해 부분적인 정보만 가지고 있다."}
{"headword": "pathetic", "meanings": [{"pos": "a.", "ko": "한심한, 형편없는"}, {"pos": "a.", "ko": "불쌍한, 애처로운"}], "meaning_ko": "한심한", "example_en": "His excuse for being late was so pathetic that no one believed him.", "example_ko": "그가 늦은 이유는 너무 한심해서 아무도 믿지 않았다."}
{"headword": "patience", "meanings": [{"pos": "n.", "ko": "참을성, 인내"}, {"pos": "n.", "ko": "끈기"}], "meaning_ko": "참을성", "example_en": "You need a lot of patience to solve difficult math problems.", "example_ko": "어려운 수학 문제를 풀려면 많은 참을성이 필요하다."}
{"headword": "patient", "meanings": [{"pos": "a.", "ko": "참을성 있는, 인내심 있는"}, {"pos": "n.", "ko": "환자"}], "meaning_ko": "참을성 있는", "example_en": "A good teacher is always patient with students who learn slowly.", "example_ko": "좋은 선생님은 느리게 배우는 학생들에게 항상 참을성이 있다."}
{"headword": "patriot", "meanings": [{"pos": "n.", "ko": "애국자"}], "meaning_ko": "애국자", "example_en": "A true patriot always puts the country's interests first.", "example_ko": "진정한 애국자는 언제나 나라의 이익을 우선시한다."}
{"headword": "patriotic", "meanings": [{"pos": "a.", "ko": "애국적인"}, {"pos": "a.", "ko": "애국자의"}], "meaning_ko": "애국적인", "example_en": "The crowd sang a patriotic song during the national holiday parade.", "example_ko": "군중은 국경일 퍼레이드에서 애국가를 불렀다."}
{"headword": "patriotism", "meanings": [{"pos": "n.", "ko": "애국심"}], "meaning_ko": "애국심", "example_en": "Patriotism can unite people to work for the good of their country.", "example_ko": "애국심은 사람들이 나라를 위해 힘을 합치게 할 수 있다."}
{"headword": "patrol", "meanings": [{"pos": "v.", "ko": "순찰하다"}, {"pos": "n.", "ko": "순찰"}], "meaning_ko": "순찰하다", "example_en": "Police officers patrol the streets every night to keep the area safe.", "example_ko": "경찰관들은 지역의 안전을 위해 매일 밤 거리를 순찰한다."}
{"headword": "patron", "meanings": [{"pos": "n.", "ko": "후원자, 지원자"}, {"pos": "n.", "ko": "고객, 단골"}], "meaning_ko": "후원자", "example_en": "The museum was able to open a new gallery thanks to its generous patron.", "example_ko": "박물관은 후원자의 도움으로 새 전시실을 열 수 있었다."}
{"headword": "pattern", "meanings": [{"pos": "n.", "ko": "양식, 형태, 패턴"}, {"pos": "n.", "ko": "무늬, 도안"}, {"pos": "n.", "ko": "본보기, 모범"}], "meaning_ko": "양식", "example_en": "Scientists observed a repeating pattern in the animal's behavior.", "example_ko": "과학자들은 그 동물의 행동에서 반복되는 양식을 관찰했다."}
{"headword": "pause", "meanings": [{"pos": "v.", "ko": "잠시 멈추다, 중단하다"}, {"pos": "n.", "ko": "일시 정지, 멈춤"}], "meaning_ko": "잠시 멈추다", "example_en": "She paused before answering the difficult question in the interview.", "example_ko": "그녀는 면접에서 어려운 질문에 답하기 전에 잠시 멈췄다."}
{"headword": "pavement", "meanings": [{"pos": "n.", "ko": "인도, 보도"}], "meaning_ko": "인도", "example_en": "Children should walk on the pavement to avoid traffic accidents.", "example_ko": "어린이들은 교통사고를 피하려면 인도를 걸어야 한다."}
{"headword": "pay attention to", "meanings": [{"pos": "phr.", "ko": "~에 주의를 기울이다, 집중하다"}], "meaning_ko": "주의를 기울이다", "example_en": "You should pay attention to the teacher's instructions during class.", "example_ko": "수업 시간에는 선생님의 지시에 주의를 기울여야 한다."}
{"headword": "peak", "meanings": [{"pos": "n.", "ko": "정상, 절정"}, {"pos": "v.", "ko": "최고조에 달하다"}], "meaning_ko": "정상", "example_en": "The mountain climbers finally reached the peak after hours of hiking.", "example_ko": "등산객들은 몇 시간의 등산 끝에 마침내 정상에 도달했다."}
{"headword": "peasant", "meanings": [{"pos": "n.", "ko": "소작농, 농부"}], "meaning_ko": "농부", "example_en": "In the past, most peasants worked long hours in the fields.", "example_ko": "과거에는 대부분의 농부들이 들에서 오랜 시간 일했다."}
{"headword": "peculiar", "meanings": [{"pos": "a.", "ko": "이상한, 기이한"}, {"pos": "a.", "ko": "독특한"}], "meaning_ko": "이상한", "example_en": "There was a peculiar smell coming from the old building.", "example_ko": "오래된 건물에서 이상한 냄새가 났다."}
{"headword": "pedal", "meanings": [{"pos": "n.", "ko": "페달, 발판"}, {"pos": "v.", "ko": "페달을 밟다, 페달을 밟으며 가다"}], "meaning_ko": "페달", "example_en": "He pushed the pedal hard to make the bicycle go faster.", "example_ko": "그는 자전거를 더 빨리 가게 하려고 페달을 세게 밟았다."}
{"headword": "pedestrian", "meanings": [{"pos": "n.", "ko": "보행자"}, {"pos": "a.", "ko": "보행자의, 보행자용의"}], "meaning_ko": "보행자", "example_en": "Pedestrians must use the crosswalk to cross the busy street safely.", "example_ko": "보행자들은 번화한 거리를 안전하게 건너려면 횡단보도를 이용해야 한다."}
{"headword": "peel", "meanings": [{"pos": "v.", "ko": "껍질을 벗기다"}, {"pos": "n.", "ko": "껍질"}], "meaning_ko": "껍질을 벗기다", "example_en": "Please peel the apples before adding them to the salad.", "example_ko": "샐러드에 넣기 전에 사과 껍질을 벗겨 주세요."}
{"headword": "peer", "meanings": [{"pos": "n.", "ko": "동료, 또래"}, {"pos": "v.", "ko": "자세히 들여다보다, 응시하다"}], "meaning_ko": "동료", "example_en": "Teenagers are often influenced by the opinions of their peers.", "example_ko": "십대들은 또래의 의견에 자주 영향을 받는다."}
{"headword": "penalize", "meanings": [{"pos": "v.", "ko": "처벌하다, 벌하다"}, {"pos": "v.", "ko": "불이익을 주다"}], "meaning_ko": "처벌하다", "example_en": "The referee penalized the player for breaking the rules during the game.", "example_ko": "심판은 경기 중 규칙을 어긴 선수에게 벌을 주었다."}
{"headword": "penalty", "meanings": [{"pos": "n.", "ko": "처벌, 형벌"}, {"pos": "n.", "ko": "벌금"}, {"pos": "n.", "ko": "불이익, 불이득"}], "meaning_ko": "처벌", "example_en": "The player received a penalty for breaking the rules during the game.", "example_ko": "그 선수는 경기 중 규칙을 어겨 처벌을 받았다."}
{"headword": "penetrate", "meanings": [{"pos": "v.", "ko": "관통하다, 꿰뚫다"}, {"pos": "v.", "ko": "침투하다, 스며들다"}, {"pos": "v.", "ko": "이해하다, 파악하다"}], "meaning_ko": "관통하다", "example_en": "The sunlight could not penetrate the thick forest canopy.", "example_ko": "햇빛이 빽빽한 숲의 덮개를 관통하지 못했다."}
{"headword": "pension", "meanings": [{"pos": "n.", "ko": "연금"}, {"pos": "n.", "ko": "생활 보조금"}], "meaning_ko": "연금", "example_en": "After retiring, she lived comfortably on her pension.", "example_ko": "은퇴 후 그녀는 연금으로 편안하게 살았다."}
{"headword": "perceive", "meanings": [{"pos": "v.", "ko": "인지하다, 알아차리다"}, {"pos": "v.", "ko": "감지하다, 느끼다"}], "meaning_ko": "인지하다", "example_en": "Children can often perceive emotions that adults try to hide.", "example_ko": "아이들은 어른들이 숨기려는 감정을 종종 인지할 수 있다."}
{"headword": "perception", "meanings": [{"pos": "n.", "ko": "지각, 인지"}, {"pos": "n.", "ko": "인식, 이해"}, {"pos": "n.", "ko": "견해, 생각"}], "meaning_ko": "지각", "example_en": "Your perception of reality can be influenced by your experiences.", "example_ko": "현실에 대한 지각은 경험에 의해 영향을 받을 수 있다."}
{"headword": "perfect", "meanings": [{"pos": "a.", "ko": "완벽한, 흠잡을 데 없는"}, {"pos": "v.", "ko": "완성하다, 완전하게 하다"}], "meaning_ko": "완벽한", "example_en": "She wrote a perfect essay that impressed all the teachers.", "example_ko": "그녀는 모든 선생님을 감탄하게 한 완벽한 에세이를 썼다."}
{"headword": "perfection", "meanings": [{"pos": "n.", "ko": "완벽(함), 완전"}, {"pos": "n.", "ko": "완성"}], "meaning_ko": "완벽함", "example_en": "He always strives for perfection in everything he does.", "example_ko": "그는 자신이 하는 모든 일에서 완벽함을 추구한다."}
{"headword": "perfectly", "meanings": [{"pos": "ad.", "ko": "완벽하게, 나무랄 데 없이"}, {"pos": "ad.", "ko": "완전히, 전적으로"}], "meaning_ko": "완벽하게", "example_en": "The machine is working perfectly after the repair.", "example_ko": "수리 후 기계가 완벽하게 작동하고 있다."}
{"headword": "perform", "meanings": [{"pos": "v.", "ko": "수행하다, 실행하다"}, {"pos": "v.", "ko": "공연하다, 연기하다"}], "meaning_ko": "수행하다", "example_en": "Students are expected to perform their duties responsibly at school.", "example_ko": "학생들은 학교에서 자신의 임무를 책임감 있게 수행해야 한다."}
{"headword": "performance", "meanings": [{"pos": "n.", "ko": "공연, 연주"}, {"pos": "n.", "ko": "성과, 실적"}, {"pos": "n.", "ko": "수행, 실행"}], "meaning_ko": "공연", "example_en": "The performance last night received a standing ovation from the audience.", "example_ko": "어젯밤 공연은 관객들의 기립 박수를 받았다."}
{"headword": "peril", "meanings": [{"pos": "n.", "ko": "위험, 위기"}, {"pos": "n.", "ko": "모험"}], "meaning_ko": "위험", "example_en": "Traveling alone at night can put you in great peril.", "example_ko": "밤에 혼자 여행하는 것은 큰 위험에 빠질 수 있다."}
{"headword": "perilous", "meanings": [{"pos": "a.", "ko": "위험한, 모험적인"}], "meaning_ko": "위험한", "example_en": "They made a perilous journey through the desert to reach safety.", "example_ko": "그들은 안전한 곳에 도착하기 위해 사막을 통과하는 위험한 여행을 했다."}
{"headword": "period", "meanings": [{"pos": "n.", "ko": "기간, 시기"}, {"pos": "n.", "ko": "(문장 끝의) 마침표"}, {"pos": "n.", "ko": "수업 시간"}], "meaning_ko": "기간", "example_en": "The Renaissance was a period of great cultural change in Europe.", "example_ko": "르네상스는 유럽에서 큰 문화적 변화가 있었던 기간이었다."}
{"headword": "perish", "meanings": [{"pos": "v.", "ko": "죽다, 소멸하다"}, {"pos": "v.", "ko": "사라지다"}], "meaning_ko": "죽다", "example_en": "Many plants will perish without enough sunlight and water.", "example_ko": "많은 식물은 충분한 햇빛과 물이 없으면 죽게 된다."}
{"headword": "permanent", "meanings": [{"pos": "a.", "ko": "영구적인, 영속적인"}, {"pos": "a.", "ko": "오랫동안 지속되는"}, {"pos": "a.", "ko": "정규의, 상설의"}], "meaning_ko": "영구적인", "example_en": "The museum has a permanent collection of ancient artifacts.", "example_ko": "그 박물관에는 고대 유물의 영구 소장이 있다."}
{"headword": "permission", "meanings": [{"pos": "n.", "ko": "허가, 허락"}, {"pos": "n.", "ko": "승인"}], "meaning_ko": "허가", "example_en": "You need permission from your parents to join the club.", "example_ko": "동아리에 가입하려면 부모님의 허가가 필요하다."}
{"headword": "permit", "meanings": [{"pos": "v.", "ko": "허락하다, 허용하다"}, {"pos": "n.", "ko": "허가증, 승인서"}], "meaning_ko": "허락하다", "example_en": "The teacher did not permit students to use their phones in class.", "example_ko": "선생님은 수업 중 학생들이 휴대폰을 사용하는 것을 허락하지 않았다."}
{"headword": "perpetual", "meanings": [{"pos": "a.", "ko": "끊임없는, 영원한"}, {"pos": "a.", "ko": "반복되는, 계속되는"}], "meaning_ko": "끊임없는", "example_en": "The region is known for its perpetual snow and cold weather.", "example_ko": "그 지역은 끊임없는 눈과 추운 날씨로 유명하다."}
{"headword": "perplex", "meanings": [{"pos": "v.", "ko": "당황하게 하다, 혼란스럽게 하다"}], "meaning_ko": "당황하게 하다", "example_en": "The complicated instructions began to perplex the students.", "example_ko": "복잡한 설명이 학생들을 당황하게 만들기 시작했다."}
{"headword": "perseverance", "meanings": [{"pos": "n.", "ko": "끈기, 인내"}, {"pos": "n.", "ko": "참을성"}], "meaning_ko": "끈기", "example_en": "With perseverance, she overcame many obstacles to achieve her dream.", "example_ko": "끈기로 그녀는 많은 장애물을 극복하고 꿈을 이뤘다."}
{"headword": "persevere", "meanings": [{"pos": "v.", "ko": "끈질기게 계속하다"}, {"pos": "v.", "ko": "어려움에도 인내하다"}, {"pos": "v.", "ko": "포기하지 않고 노력하다"}], "meaning_ko": "끈질기게 계속하다", "example_en": "She persevered in her studies despite many challenges and finally succeeded.", "example_ko": "그녀는 많은 어려움에도 학업을 끈질기게 계속해 결국 성공했다."}
{"headword": "persist", "meanings": [{"pos": "v.", "ko": "계속하다"}, {"pos": "v.", "ko": "고집하다"}, {"pos": "v.", "ko": "지속되다"}], "meaning_ko": "계속하다", "example_en": "If you persist in practicing every day, your skills will improve.", "example_ko": "매일 꾸준히 연습하면 실력이 늘 것이다."}
{"headword": "persistence", "meanings": [{"pos": "n.", "ko": "끈기"}, {"pos": "n.", "ko": "지속성"}, {"pos": "n.", "ko": "고집"}], "meaning_ko": "끈기", "example_en": "His persistence in solving the problem impressed the entire team.", "example_ko": "그가 문제를 해결하려는 끈기는 팀 전체에 깊은 인상을 남겼다."}
{"headword": "persistent", "meanings": [{"pos": "a.", "ko": "지속적인"}, {"pos": "a.", "ko": "끈질긴"}, {"pos": "a.", "ko": "고집하는"}], "meaning_ko": "지속적인", "example_en": "The persistent rain caused delays in the construction project.", "example_ko": "지속적인 비로 인해 공사 일정이 지연되었다."}
{"headword": "personal", "meanings": [{"pos": "a.", "ko": "개인적인"}, {"pos": "a.", "ko": "사적인"}, {"pos": "a.", "ko": "본인의"}], "meaning_ko": "개인적인", "example_en": "Please do not ask personal questions during the interview.", "example_ko": "면접 중에는 개인적인 질문을 삼가 주세요."}
{"headword": "personality", "meanings": [{"pos": "n.", "ko": "성격"}, {"pos": "n.", "ko": "개성"}, {"pos": "n.", "ko": "특성"}], "meaning_ko": "성격", "example_en": "Her cheerful personality makes her popular among her classmates.", "example_ko": "그녀의 명랑한 성격 덕분에 반 친구들에게 인기가 많다."}
{"headword": "personnel", "meanings": [{"pos": "n.", "ko": "직원"}, {"pos": "n.", "ko": "인사과"}, {"pos": "a.", "ko": "인사의"}], "meaning_ko": "직원", "example_en": "All company personnel must attend the safety training next week.", "example_ko": "모든 회사 직원은 다음 주 안전 교육에 참석해야 한다."}
{"headword": "perspective", "meanings": [{"pos": "n.", "ko": "관점"}, {"pos": "n.", "ko": "시각"}, {"pos": "n.", "ko": "원근법"}], "meaning_ko": "관점", "example_en": "It is important to consider different perspectives when making decisions.", "example_ko": "결정을 내릴 때 다양한 관점을 고려하는 것이 중요하다."}
{"headword": "perspiration", "meanings": [{"pos": "n.", "ko": "땀"}, {"pos": "n.", "ko": "땀이 남"}, {"pos": "n.", "ko": "노력의 흔적"}], "meaning_ko": "땀", "example_en": "After running for an hour, his shirt was soaked with perspiration.", "example_ko": "한 시간 동안 달린 후 그의 셔츠는 땀으로 흠뻑 젖었다."}
{"headword": "persuade", "meanings": [{"pos": "v.", "ko": "설득하다"}, {"pos": "v.", "ko": "납득시키다"}, {"pos": "v.", "ko": "권유하다"}], "meaning_ko": "설득하다", "example_en": "She tried to persuade her friend to join the volunteer club.", "example_ko": "그녀는 친구에게 자원봉사 동아리에 가입하라고 설득했다."}
{"headword": "persuasion", "meanings": [{"pos": "n.", "ko": "설득"}, {"pos": "n.", "ko": "신념"}, {"pos": "n.", "ko": "확신"}], "meaning_ko": "설득", "example_en": "Through gentle persuasion, the teacher encouraged the students to participate.", "example_ko": "선생님은 부드러운 설득으로 학생들의 참여를 이끌어냈다."}
{"headword": "persuasive", "meanings": [{"pos": "a.", "ko": "설득력 있는"}, {"pos": "a.", "ko": "납득시키는"}, {"pos": "a.", "ko": "설득하는"}], "meaning_ko": "설득력 있는", "example_en": "His persuasive speech convinced many people to support the cause.", "example_ko": "그의 설득력 있는 연설은 많은 사람들이 그 대의를 지지하게 만들었다."}
{"headword": "pervade", "meanings": [{"pos": "v.", "ko": "가득 차다"}, {"pos": "v.", "ko": "널리 퍼지다"}, {"pos": "v.", "ko": "스며들다"}], "meaning_ko": "가득 차다", "example_en": "A sense of excitement pervaded the classroom before the field trip.", "example_ko": "소풍을 앞두고 교실에는 기대감이 가득 찼다."}
{"headword": "pervasive", "meanings": [{"pos": "a.", "ko": "만연하는"}, {"pos": "a.", "ko": "스며드는"}, {"pos": "a.", "ko": "널리 퍼진"}], "meaning_ko": "만연하는", "example_en": "The influence of technology is pervasive in modern society.", "example_ko": "현대 사회에서 기술의 영향력은 만연하다."}
{"headword": "pest", "meanings": [{"pos": "n.", "ko": "해충"}, {"pos": "n.", "ko": "성가신 사람"}, {"pos": "n.", "ko": "골칫거리"}], "meaning_ko": "해충", "example_en": "The farmers used traps to protect their crops from pests.", "example_ko": "농부들은 해충으로부터 농작물을 지키기 위해 덫을 사용했다."}
