{"headword": "guard", "meanings": [{"pos": "n.", "ko": "경비원, 경호원"}, {"pos": "n.", "ko": "보호 장치"}, {"pos": "v.", "ko": "지키다, 보호하다"}], "meaning_ko": "경비원", "example_en": "A security guard checks the entrance every morning for safety.", "example_ko": "경비원이 매일 아침 안전을 위해 출입구를 확인한다."}
{"headword": "guardian", "meanings": [{"pos": "n.", "ko": "보호자, 후견인"}], "meaning_ko": "보호자", "example_en": "After her parents passed away, her uncle became her legal guardian.", "example_ko": "부모님이 돌아가신 후 삼촌이 그녀의 법적 보호자가 되었다."}
{"headword": "guidance", "meanings": [{"pos": "n.", "ko": "지도, 안내"}, {"pos": "n.", "ko": "조언, 충고"}], "meaning_ko": "지도", "example_en": "Students often seek guidance from teachers when choosing their careers.", "example_ko": "학생들은 진로를 정할 때 종종 선생님께 지도를 구한다."}
{"headword": "guilty", "meanings": [{"pos": "a.", "ko": "죄책감을 느끼는"}, {"pos": "a.", "ko": "유죄의"}], "meaning_ko": "유죄의", "example_en": "The jury found the defendant guilty of all charges.", "example_ko": "배심원단은 피고에게 모든 혐의에 대해 유죄 판결을 내렸다."}
{"headword": "gust", "meanings": [{"pos": "n.", "ko": "돌풍, 세찬 바람"}, {"pos": "n.", "ko": "(감정의) 갑작스러운 표출"}], "meaning_ko": "돌풍", "example_en": "A sudden gust of wind blew the papers off the table.", "example_ko": "갑작스러운 돌풍에 종이들이 탁자에서 날아갔다."}
{"headword": "gymnastics", "meanings": [{"pos": "n.", "ko": "체조, 체조 경기"}], "meaning_ko": "체조", "example_en": "She practices gymnastics every day to improve her balance and strength.", "example_ko": "그녀는 균형과 체력을 기르기 위해 매일 체조를 연습한다."}
{"headword": "habit", "meanings": [{"pos": "n.", "ko": "습관, 버릇"}], "meaning_ko": "습관", "example_en": "Brushing your teeth before bed is a healthy habit.", "example_ko": "잠자기 전에 양치하는 것은 건강한 습관이다."}
{"headword": "habitable", "meanings": [{"pos": "a.", "ko": "살기에 적합한, 거주할 수 있는"}], "meaning_ko": "거주 가능", "example_en": "Scientists are searching for habitable planets outside our solar system.", "example_ko": "과학자들은 태양계 밖에서 거주 가능한 행성을 찾고 있다."}
{"headword": "habitat", "meanings": [{"pos": "n.", "ko": "서식지, 번식지"}, {"pos": "n.", "ko": "거주지"}], "meaning_ko": "서식지", "example_en": "The polar bear's natural habitat is rapidly disappearing due to climate change.", "example_ko": "기후 변화로 북극곰의 자연 서식지가 빠르게 사라지고 있다."}
{"headword": "habitual", "meanings": [{"pos": "a.", "ko": "습관적인, 상습적인"}], "meaning_ko": "습관적인", "example_en": "He is a habitual latecomer to class, always arriving after the bell.", "example_ko": "그는 항상 종이 울린 뒤에 오는 습관적인 지각생이다."}
{"headword": "habitually", "meanings": [{"pos": "ad.", "ko": "습관적으로, 늘"}], "meaning_ko": "습관적으로", "example_en": "She habitually checks her phone as soon as she wakes up.", "example_ko": "그녀는 아침에 일어나자마자 습관적으로 휴대폰을 확인한다."}
{"headword": "hail", "meanings": [{"pos": "n.", "ko": "우박"}, {"pos": "v.", "ko": "환호하며 맞이하다"}, {"pos": "v.", "ko": "불러 세우다"}], "meaning_ko": "우박", "example_en": "The sudden hail damaged many cars parked outside last night.", "example_ko": "어젯밤 갑작스러운 우박이 밖에 주차된 많은 차를 망가뜨렸다."}
{"headword": "halfway", "meanings": [{"pos": "ad.", "ko": "중간에, 절반쯤"}, {"pos": "a.", "ko": "중간의, 절반의"}], "meaning_ko": "중간에", "example_en": "We stopped halfway up the mountain to rest and drink water.", "example_ko": "우리는 산 중턱에서 쉬고 물을 마시기 위해 멈췄다."}
{"headword": "halt", "meanings": [{"pos": "v.", "ko": "멈추다, 중단하다"}, {"pos": "n.", "ko": "정지, 멈춤"}], "meaning_ko": "멈추다", "example_en": "The train came to a sudden halt because of an animal on the tracks.", "example_ko": "선로 위에 동물이 있어 기차가 갑자기 멈췄다."}
{"headword": "handle", "meanings": [{"pos": "v.", "ko": "다루다, 처리하다"}, {"pos": "n.", "ko": "손잡이"}], "meaning_ko": "다루다", "example_en": "She knows how to handle difficult situations calmly and wisely.", "example_ko": "그녀는 어려운 상황도 침착하고 현명하게 다룰 줄 안다."}
{"headword": "harass", "meanings": [{"pos": "v.", "ko": "괴롭히다, 반복적으로 공격하다"}], "meaning_ko": "괴롭히다", "example_en": "It is illegal to harass someone at school or in the workplace.", "example_ko": "학교나 직장에서 누군가를 괴롭히는 것은 불법이다."}
{"headword": "hard", "meanings": [{"pos": "a.", "ko": "단단한"}, {"pos": "a.", "ko": "어려운"}, {"pos": "ad.", "ko": "열심히"}], "meaning_ko": "단단한", "example_en": "The rock was too hard to break with a small hammer.", "example_ko": "그 바위는 작은 망치로 깨기에는 너무 단단했다."}
{"headword": "hardly", "meanings": [{"pos": "ad.", "ko": "거의 ~않다"}], "meaning_ko": "거의 않다", "example_en": "He could hardly see anything in the thick fog last night.", "example_ko": "어젯밤 짙은 안개 속에서 그는 거의 아무것도 볼 수 없었다."}
{"headword": "hardship", "meanings": [{"pos": "n.", "ko": "고난, 어려움"}], "meaning_ko": "고난", "example_en": "Many families faced financial hardship during the economic crisis.", "example_ko": "경제 위기 동안 많은 가정이 경제적 고난을 겪었다."}
{"headword": "inhibition", "meanings": [{"pos": "n.", "ko": "억제, 자제"}, {"pos": "n.", "ko": "금지, 제한"}], "meaning_ko": "억제", "example_en": "The drug was designed to cause the inhibition of harmful bacteria in the body.", "example_ko": "그 약은 몸속의 해로운 박테리아를 억제하기 위해 만들어졌다."}
{"headword": "initial", "meanings": [{"pos": "a.", "ko": "처음의, 최초의"}, {"pos": "n.", "ko": "머리글자, 이니셜"}], "meaning_ko": "처음의", "example_en": "Her initial reaction to the news was one of surprise and disbelief.", "example_ko": "그 소식을 처음 들었을 때 그녀는 놀라고 믿지 못했다."}
{"headword": "initially", "meanings": [{"pos": "ad.", "ko": "처음에, 초기에"}, {"pos": "ad.", "ko": "시작할 때"}], "meaning_ko": "처음에", "example_en": "The project was initially planned to last for six months.", "example_ko": "그 프로젝트는 처음에 6개월간 진행될 예정이었다."}
{"headword": "initiate", "meanings": [{"pos": "v.", "ko": "시작하다, 개시하다"}, {"pos": "v.", "ko": "(방법·기술 등을) 전수하다, 가르치다"}], "meaning_ko": "시작하다", "example_en": "The company will initiate a new training program next month.", "example_ko": "그 회사는 다음 달에 새로운 교육 프로그램을 시작할 것이다."}
{"headword": "initiative", "meanings": [{"pos": "n.", "ko": "주도권, 솔선"}, {"pos": "n.", "ko": "계획, 새로운 시도"}], "meaning_ko": "주도권", "example_en": "Taking the initiative in group projects often leads to better results.", "example_ko": "조별 과제에서 주도권을 잡으면 더 좋은 결과를 얻는 경우가 많다."}
{"headword": "inject", "meanings": [{"pos": "v.", "ko": "주사하다, 주입하다"}, {"pos": "v.", "ko": "(새로운 요소를) 도입하다"}], "meaning_ko": "주사하다", "example_en": "Doctors must inject the vaccine into the patient's arm carefully.", "example_ko": "의사들은 환자의 팔에 백신을 조심스럽게 주사해야 한다."}
{"headword": "injection", "meanings": [{"pos": "n.", "ko": "주사, 주입"}, {"pos": "n.", "ko": "투입, 삽입"}], "meaning_ko": "주사", "example_en": "The nurse gave the child an injection to prevent the disease.", "example_ko": "간호사가 아이에게 질병 예방을 위해 주사를 놓았다."}
{"headword": "injure", "meanings": [{"pos": "v.", "ko": "상처를 입히다, 다치게 하다"}, {"pos": "v.", "ko": "(감정·명예 등을) 손상시키다, 해치다"}], "meaning_ko": "다치게 하다", "example_en": "He did not want to injure his friend during the soccer match.", "example_ko": "그는 축구 경기 중에 친구를 다치게 하고 싶지 않았다."}
{"headword": "injurious", "meanings": [{"pos": "a.", "ko": "해로운, 유해한"}], "meaning_ko": "해로운", "example_en": "Smoking is injurious to your health in many ways.", "example_ko": "흡연은 여러 면에서 건강에 해롭다."}
{"headword": "injury", "meanings": [{"pos": "n.", "ko": "부상, 상해"}, {"pos": "n.", "ko": "손상, 훼손"}], "meaning_ko": "부상", "example_en": "He suffered a serious injury while playing basketball.", "example_ko": "그는 농구를 하다가 심한 부상을 입었다."}
{"headword": "innate", "meanings": [{"pos": "a.", "ko": "선천적인, 타고난"}], "meaning_ko": "선천적인", "example_en": "Some people have an innate talent for music from a young age.", "example_ko": "어떤 사람들은 어릴 때부터 선천적으로 음악에 재능이 있다."}
{"headword": "inner", "meanings": [{"pos": "a.", "ko": "내부의, 안쪽의"}, {"pos": "a.", "ko": "내면의, 마음속의"}], "meaning_ko": "내부의", "example_en": "The inner walls of the castle were built to protect against attacks.", "example_ko": "성의 내부 벽은 공격을 막기 위해 지어졌다."}
{"headword": "innermost", "meanings": [{"pos": "a.", "ko": "가장 안쪽의, 가장 깊은"}], "meaning_ko": "가장 안쪽의", "example_en": "She kept her innermost thoughts hidden from everyone.", "example_ko": "그녀는 자신의 가장 깊은 생각을 아무에게도 털어놓지 않았다."}
{"headword": "innocence", "meanings": [{"pos": "n.", "ko": "결백, 무죄"}, {"pos": "n.", "ko": "순수함, 순진함"}], "meaning_ko": "결백", "example_en": "The lawyer argued strongly for his client's innocence in court.", "example_ko": "변호사는 법정에서 의뢰인의 결백을 강하게 주장했다."}
{"headword": "innocent", "meanings": [{"pos": "a.", "ko": "무죄의, 결백한"}, {"pos": "a.", "ko": "순진한, 천진난만한"}], "meaning_ko": "무죄의", "example_en": "The jury found the accused innocent after reviewing all the evidence.", "example_ko": "배심원단은 모든 증거를 검토한 후 피고가 무죄임을 인정했다."}
{"headword": "innovate", "meanings": [{"pos": "v.", "ko": "혁신하다, 새롭게 하다"}], "meaning_ko": "혁신하다", "example_en": "Companies must innovate constantly to stay ahead in the market.", "example_ko": "기업은 시장에서 앞서기 위해 끊임없이 혁신해야 한다."}
{"headword": "innovation", "meanings": [{"pos": "n.", "ko": "혁신, 새로움"}, {"pos": "n.", "ko": "새로운 고안, 신기술"}], "meaning_ko": "혁신", "example_en": "Innovation in technology has changed the way we communicate.", "example_ko": "기술 혁신으로 우리의 소통 방식이 달라졌다."}
{"headword": "innovator", "meanings": [{"pos": "n.", "ko": "혁신가, 개혁가"}], "meaning_ko": "혁신가", "example_en": "An innovator often challenges old ideas to create something new.", "example_ko": "혁신가는 종종 기존의 생각에 도전해 새로운 것을 만들어낸다."}
{"headword": "innumerable", "meanings": [{"pos": "a.", "ko": "셀 수 없이 많은, 무수한"}], "meaning_ko": "무수한", "example_en": "There are innumerable stars in the night sky above us.", "example_ko": "우리 머리 위 밤하늘에는 무수히 많은 별이 있다."}
{"headword": "inquire", "meanings": [{"pos": "v.", "ko": "묻다, 질문하다"}, {"pos": "v.", "ko": "조사하다, 알아보다"}], "meaning_ko": "묻다", "example_en": "She called the office to inquire about the application process.", "example_ko": "그녀는 지원 절차를 묻기 위해 사무실에 전화했다."}
{"headword": "inquiry", "meanings": [{"pos": "n.", "ko": "질문, 문의"}, {"pos": "n.", "ko": "조사, 탐구"}], "meaning_ko": "질문", "example_en": "The student made an inquiry about the homework deadline after class.", "example_ko": "학생은 수업이 끝난 후 숙제 마감일에 대해 질문했다."}
{"headword": "insane", "meanings": [{"pos": "a.", "ko": "정신 이상의, 미친"}, {"pos": "a.", "ko": "터무니없는, 비상식적인"}], "meaning_ko": "미친", "example_en": "It would be insane to try climbing that mountain without any experience.", "example_ko": "아무런 경험 없이 그 산을 오르려는 것은 미친 짓일 것이다."}
{"headword": "inseparable", "meanings": [{"pos": "a.", "ko": "떨어질 수 없는, 불가분의"}, {"pos": "a.", "ko": "매우 친한"}], "meaning_ko": "떨어질 수 없는", "example_en": "The two friends have been inseparable since they met in middle school.", "example_ko": "그 두 친구는 중학교에서 만난 이후로 떨어질 수 없을 만큼 친했다."}
{"headword": "insert", "meanings": [{"pos": "v.", "ko": "삽입하다, 끼워 넣다"}, {"pos": "v.", "ko": "(문서 등에) 말을 써 넣다, 덧붙이다"}], "meaning_ko": "삽입하다", "example_en": "Please insert your card into the machine to begin the transaction.", "example_ko": "거래를 시작하려면 카드를 기계에 삽입하세요."}
{"headword": "insertion", "meanings": [{"pos": "n.", "ko": "삽입, 끼워넣기"}, {"pos": "n.", "ko": "(문서 등에) 추가, 삽입된 것"}], "meaning_ko": "삽입", "example_en": "The insertion of the new paragraph made the essay clearer.", "example_ko": "새 단락의 삽입으로 글이 더 명확해졌다."}
{"headword": "insight", "meanings": [{"pos": "n.", "ko": "통찰력, 식견"}, {"pos": "n.", "ko": "이해, 간파"}], "meaning_ko": "통찰력", "example_en": "Her insight into human behavior helped solve the problem quickly.", "example_ko": "그녀의 인간 행동에 대한 통찰력 덕분에 문제를 빨리 해결할 수 있었다."}
{"headword": "insist", "meanings": [{"pos": "v.", "ko": "주장하다, 고집하다"}, {"pos": "v.", "ko": "(강하게) 요구하다"}], "meaning_ko": "주장하다", "example_en": "He insisted that he was telling the truth despite the evidence.", "example_ko": "그는 증거에도 불구하고 자신이 진실을 말하고 있다고 주장했다."}
{"headword": "insistence", "meanings": [{"pos": "n.", "ko": "(강한) 주장, 고집"}, {"pos": "n.", "ko": "(강한) 요구"}], "meaning_ko": "주장", "example_en": "Because of her insistence, the team reconsidered their decision.", "example_ko": "그녀의 강한 주장 때문에 팀은 결정을 다시 생각했다."}
{"headword": "insistent", "meanings": [{"pos": "a.", "ko": "고집하는, 끈질긴"}, {"pos": "a.", "ko": "집요한, 계속되는"}], "meaning_ko": "고집하는", "example_en": "The insistent ringing of the phone finally made him answer it.", "example_ko": "계속 울리는 전화 소리에 그는 결국 전화를 받았다."}
{"headword": "insomnia", "meanings": [{"pos": "n.", "ko": "불면증"}], "meaning_ko": "불면증", "example_en": "She suffers from insomnia and often stays awake all night.", "example_ko": "그녀는 불면증으로 밤새 잠을 못 이루곤 한다."}
{"headword": "inspect", "meanings": [{"pos": "v.", "ko": "조사하다, 검사하다"}, {"pos": "v.", "ko": "(시설·기구 등을) 점검하다, 사찰하다"}], "meaning_ko": "조사하다", "example_en": "The teacher will inspect each student's project before grading.", "example_ko": "선생님이 채점 전에 각 학생의 과제를 조사할 것이다."}
{"headword": "inspection", "meanings": [{"pos": "n.", "ko": "조사, 검사"}, {"pos": "n.", "ko": "사찰, 감사"}], "meaning_ko": "조사", "example_en": "The building passed the safety inspection last month.", "example_ko": "그 건물은 지난달 안전 조사를 통과했다."}
{"headword": "inspector", "meanings": [{"pos": "n.", "ko": "조사관, 검열관"}, {"pos": "n.", "ko": "감독관"}], "meaning_ko": "조사관", "example_en": "An inspector visited the restaurant to check its hygiene standards.", "example_ko": "조사관이 식당의 위생 상태를 점검하러 방문했다."}
{"headword": "inspiration", "meanings": [{"pos": "n.", "ko": "영감, 창작 자극"}, {"pos": "n.", "ko": "고무, 격려"}, {"pos": "n.", "ko": "영감을 주는 것[사람]"}], "meaning_ko": "영감", "example_en": "The beautiful scenery served as inspiration for her painting.", "example_ko": "아름다운 풍경이 그녀의 그림에 영감을 주었다."}
{"headword": "inspire", "meanings": [{"pos": "v.", "ko": "고무하다, 격려하다"}, {"pos": "v.", "ko": "(감정·사상 등을) 불어넣다"}, {"pos": "v.", "ko": "영감을 주다"}], "meaning_ko": "고무하다", "example_en": "Her courage inspired many people to face their fears.", "example_ko": "그녀의 용기는 많은 사람들에게 두려움에 맞서도록 용기를 주었다."}
{"headword": "install", "meanings": [{"pos": "v.", "ko": "설치하다, 장착하다"}, {"pos": "v.", "ko": "임명하다, 취임시키다"}], "meaning_ko": "설치하다", "example_en": "They will install new computers in the library next week.", "example_ko": "그들은 다음 주에 도서관에 새 컴퓨터를 설치할 것이다."}
{"headword": "installation", "meanings": [{"pos": "n.", "ko": "설치, 장착"}, {"pos": "n.", "ko": "설치된 장비"}], "meaning_ko": "설치", "example_en": "The installation of the new software was completed in an hour.", "example_ko": "새 소프트웨어 설치가 한 시간 만에 끝났다."}
{"headword": "instance", "meanings": [{"pos": "n.", "ko": "사례, 예"}, {"pos": "n.", "ko": "경우, 상황"}], "meaning_ko": "사례", "example_en": "For instance, there are many cases where teamwork leads to success.", "example_ko": "예를 들어, 팀워크가 성공으로 이어진 사례가 많다."}
{"headword": "instant", "meanings": [{"pos": "a.", "ko": "즉각적인, 즉시의"}, {"pos": "a.", "ko": "즉석의, 인스턴트의"}, {"pos": "n.", "ko": "순간, 찰나"}], "meaning_ko": "즉각적인", "example_en": "She received an instant reply to her email inquiry.", "example_ko": "그녀는 이메일 문의에 즉각적인 답장을 받았다."}
{"headword": "instantly", "meanings": [{"pos": "ad.", "ko": "즉시, 곧"}, {"pos": "ad.", "ko": "즉석에서"}], "meaning_ko": "즉시", "example_en": "He answered the difficult question instantly without hesitation.", "example_ko": "그는 어려운 질문에도 망설임 없이 즉시 대답했다."}
{"headword": "instinct", "meanings": [{"pos": "n.", "ko": "타고난 본능"}, {"pos": "n.", "ko": "직감, 직관"}, {"pos": "n.", "ko": "천성, 기질"}], "meaning_ko": "본능", "example_en": "Birds have an instinct to migrate when the seasons change.", "example_ko": "새들은 계절이 바뀌면 이동하려는 본능이 있다."}
{"headword": "instinctive", "meanings": [{"pos": "a.", "ko": "본능적인, 자연스러운"}, {"pos": "a.", "ko": "무의식적인"}, {"pos": "a.", "ko": "타고난"}], "meaning_ko": "본능적인", "example_en": "She gave an instinctive response to the sudden noise.", "example_ko": "그녀는 갑작스러운 소리에 본능적으로 반응했다."}
{"headword": "instinctively", "meanings": [{"pos": "ad.", "ko": "본능적으로"}, {"pos": "ad.", "ko": "무의식적으로"}, {"pos": "ad.", "ko": "자연스럽게"}], "meaning_ko": "본능적으로", "example_en": "He instinctively reached out to catch the falling glass.", "example_ko": "그는 본능적으로 떨어지는 유리잔을 잡으려 손을 뻗었다."}
{"headword": "institute", "meanings": [{"pos": "n.", "ko": "연구소, 기관"}, {"pos": "v.", "ko": "(제도 등을) 도입하다"}, {"pos": "v.", "ko": "설립하다, 시작하다"}], "meaning_ko": "연구소", "example_en": "The institute is known for its advanced medical research.", "example_ko": "그 연구소는 첨단 의학 연구로 유명하다."}
{"headword": "institution", "meanings": [{"pos": "n.", "ko": "기관, 시설"}, {"pos": "n.", "ko": "제도, 관습"}, {"pos": "n.", "ko": "설립, 제정"}], "meaning_ko": "기관", "example_en": "The institution offers scholarships to talented students.", "example_ko": "그 기관은 우수한 학생들에게 장학금을 제공한다."}
{"headword": "institutional", "meanings": [{"pos": "a.", "ko": "제도상의, 규정된"}, {"pos": "a.", "ko": "기관의"}, {"pos": "a.", "ko": "공공 기관에 의한"}], "meaning_ko": "제도상의", "example_en": "Institutional reforms are needed to improve the education system.", "example_ko": "교육 제도를 개선하려면 제도상의 개혁이 필요하다."}
{"headword": "instruct", "meanings": [{"pos": "v.", "ko": "지시하다, 명령하다"}, {"pos": "v.", "ko": "가르치다, 교육하다"}, {"pos": "v.", "ko": "알려주다, 안내하다"}], "meaning_ko": "지시하다", "example_en": "The coach instructed the team to practice every morning.", "example_ko": "코치는 팀에게 매일 아침 연습하라고 지시했다."}
{"headword": "instruction", "meanings": [{"pos": "n.", "ko": "지시, 명령"}, {"pos": "n.", "ko": "설명서, 안내서"}, {"pos": "n.", "ko": "교육, 가르침"}], "meaning_ko": "지시", "example_en": "Please read the instruction before using the device.", "example_ko": "기기를 사용하기 전에 지시사항을 읽으세요."}
{"headword": "instructive", "meanings": [{"pos": "a.", "ko": "유익한, 교육적인"}, {"pos": "a.", "ko": "정보를 주는"}, {"pos": "a.", "ko": "교훈적인"}], "meaning_ko": "유익한", "example_en": "The documentary was very instructive and helped me understand the topic.", "example_ko": "그 다큐멘터리는 매우 유익해서 주제를 이해하는 데 도움이 되었다."}
{"headword": "instructor", "meanings": [{"pos": "n.", "ko": "강사, 교사"}, {"pos": "n.", "ko": "지도자"}, {"pos": "n.", "ko": "(대학의) 전임 강사"}], "meaning_ko": "강사", "example_en": "The instructor explained the experiment step by step.", "example_ko": "강사는 실험을 단계별로 설명했다."}
{"headword": "instrument", "meanings": [{"pos": "n.", "ko": "도구, 기구"}, {"pos": "n.", "ko": "악기"}, {"pos": "n.", "ko": "수단, 매개체"}], "meaning_ko": "도구", "example_en": "A thermometer is an instrument used to measure temperature.", "example_ko": "온도계는 온도를 재는 데 쓰이는 도구다."}
{"headword": "instrumental", "meanings": [{"pos": "a.", "ko": "중요한 역할을 하는"}, {"pos": "a.", "ko": "도움이 되는"}, {"pos": "a.", "ko": "악기의"}], "meaning_ko": "중요한", "example_en": "Her advice was instrumental in my decision to study abroad.", "example_ko": "그녀의 조언은 내가 유학을 결심하는 데 중요한 역할을 했다."}
{"headword": "insult", "meanings": [{"pos": "v.", "ko": "모욕하다, 무례하게 굴다"}, {"pos": "n.", "ko": "모욕, 무례한 말"}, {"pos": "n.", "ko": "창피를 주는 일"}], "meaning_ko": "모욕하다", "example_en": "He insulted his friend by making a rude comment.", "example_ko": "그는 무례한 말을 해서 친구를 모욕했다."}
{"headword": "insurance", "meanings": [{"pos": "n.", "ko": "보험"}, {"pos": "n.", "ko": "보험료"}, {"pos": "n.", "ko": "보장, 대비책"}], "meaning_ko": "보험", "example_en": "You need health insurance to cover medical expenses.", "example_ko": "의료비를 보장받으려면 건강보험이 필요하다."}
{"headword": "insure", "meanings": [{"pos": "v.", "ko": "보험에 가입하다"}, {"pos": "v.", "ko": "보장하다"}, {"pos": "v.", "ko": "확실히 하다"}], "meaning_ko": "보험에 가입하다", "example_en": "Many people insure their cars against accidents.", "example_ko": "많은 사람들이 사고에 대비해 자동차 보험에 가입한다."}
{"headword": "intact", "meanings": [{"pos": "a.", "ko": "온전한, 손상되지 않은"}, {"pos": "a.", "ko": "완전한"}, {"pos": "a.", "ko": "흠 없는"}], "meaning_ko": "온전한", "example_en": "The ancient vase was found intact after the earthquake.", "example_ko": "지진 후에도 그 고대 도자기는 온전하게 발견되었다."}
{"headword": "intake", "meanings": [{"pos": "n.", "ko": "섭취량, 흡입량"}, {"pos": "n.", "ko": "받아들임"}, {"pos": "n.", "ko": "인원 수용"}], "meaning_ko": "섭취량", "example_en": "You should reduce your intake of sugar for better health.", "example_ko": "건강을 위해 설탕 섭취량을 줄여야 한다."}
{"headword": "integrate", "meanings": [{"pos": "v.", "ko": "통합하다, 하나로 합치다"}, {"pos": "v.", "ko": "인종 차별을 없애다"}, {"pos": "v.", "ko": "조화시키다"}], "meaning_ko": "통합하다", "example_en": "The new policy aims to integrate students from different backgrounds.", "example_ko": "새 정책은 다양한 배경의 학생들을 통합하는 것을 목표로 한다."}
{"headword": "integration", "meanings": [{"pos": "n.", "ko": "통합, 결합"}, {"pos": "n.", "ko": "인종 통합"}, {"pos": "n.", "ko": "융합"}], "meaning_ko": "통합", "example_en": "Cultural integration can help people understand each other better.", "example_ko": "문화 통합은 사람들이 서로를 더 잘 이해하는 데 도움이 된다."}
{"headword": "integrity", "meanings": [{"pos": "n.", "ko": "정직, 성실"}, {"pos": "n.", "ko": "완전무결, 온전함"}, {"pos": "n.", "ko": "청렴"}], "meaning_ko": "정직", "example_en": "A leader should always act with integrity and honesty.", "example_ko": "지도자는 항상 정직하고 성실하게 행동해야 한다."}
{"headword": "harm", "meanings": [{"pos": "n.", "ko": "해, 손해"}, {"pos": "v.", "ko": "해를 끼치다, 손상시키다"}], "meaning_ko": "해", "example_en": "Too much sunlight can cause harm to your skin over time.", "example_ko": "지나친 햇빛은 시간이 지나면 피부에 해를 줄 수 있다."}
{"headword": "harmonize", "meanings": [{"pos": "v.", "ko": "조화를 이루다"}, {"pos": "v.", "ko": "일치시키다, 맞추다"}], "meaning_ko": "조화를 이루다", "example_en": "The colors in the painting harmonize beautifully with each other.", "example_ko": "그 그림의 색상들은 서로 아름답게 조화를 이룬다."}
{"headword": "harsh", "meanings": [{"pos": "a.", "ko": "거친, 가혹한"}, {"pos": "a.", "ko": "혹독한, 엄한"}, {"pos": "a.", "ko": "귀에 거슬리는"}], "meaning_ko": "거친", "example_en": "The harsh winter made it difficult for the animals to survive.", "example_ko": "혹독한 겨울 때문에 동물들이 살아남기 힘들었다."}
{"headword": "harvest", "meanings": [{"pos": "n.", "ko": "수확, 추수"}, {"pos": "v.", "ko": "수확하다, 거두다"}], "meaning_ko": "수확", "example_en": "Farmers work hard during the harvest season to gather their crops.", "example_ko": "농부들은 수확철에 작물을 거두기 위해 열심히 일한다."}
{"headword": "haste", "meanings": [{"pos": "n.", "ko": "서두름, 급함"}], "meaning_ko": "서두름", "example_en": "In his haste to leave, he forgot to lock the door.", "example_ko": "그는 서둘러 나가다가 문을 잠그는 것을 잊었다."}
{"headword": "hasten", "meanings": [{"pos": "v.", "ko": "서둘러 하다"}, {"pos": "v.", "ko": "재촉하다, 촉진하다"}], "meaning_ko": "서둘러 하다", "example_en": "She tried to hasten her steps when she realized she was late.", "example_ko": "그녀는 늦은 것을 알고 발걸음을 서둘렀다."}
{"headword": "hasty", "meanings": [{"pos": "a.", "ko": "성급한, 급한"}, {"pos": "a.", "ko": "서두르는, 조급한"}], "meaning_ko": "성급한", "example_en": "A hasty decision can sometimes lead to mistakes.", "example_ko": "성급한 결정은 때때로 실수를 부를 수 있다."}
{"headword": "hatch", "meanings": [{"pos": "v.", "ko": "(알이) 부화하다, 까다"}, {"pos": "v.", "ko": "계획하다, 꾸미다"}, {"pos": "n.", "ko": "출입구, 해치"}], "meaning_ko": "부화하다", "example_en": "The chicks will hatch from their eggs in about three weeks.", "example_ko": "병아리들은 약 3주 후에 알에서 부화할 것이다."}
{"headword": "have A in common", "meanings": [{"pos": "phr.", "ko": "A를 공통으로 가지다, 공통점이 있다"}], "meaning_ko": "공통점이 있다", "example_en": "The two students have many interests in common despite their differences.", "example_ko": "두 학생은 서로 다름에도 불구하고 공통의 관심사가 많다."}
{"headword": "have an effect on", "meanings": [{"pos": "phr.", "ko": "~에 영향을 미치다"}], "meaning_ko": "영향을 미치다", "example_en": "Lack of sleep can have an effect on your ability to concentrate.", "example_ko": "수면 부족은 집중력에 영향을 줄 수 있다."}
{"headword": "hazardous", "meanings": [{"pos": "a.", "ko": "위험한, 유해한"}], "meaning_ko": "위험한", "example_en": "It is hazardous to drive in heavy rain without headlights.", "example_ko": "강한 비에 전조등 없이 운전하는 것은 위험하다."}
{"headword": "headquarters", "meanings": [{"pos": "n.", "ko": "본부, 본사"}], "meaning_ko": "본부", "example_en": "The company's headquarters are located in the center of the city.", "example_ko": "그 회사의 본부는 도심에 위치해 있다."}
{"headword": "heal", "meanings": [{"pos": "v.", "ko": "치유하다, 낫게 하다"}, {"pos": "v.", "ko": "(상처 등이) 낫다"}], "meaning_ko": "치유하다", "example_en": "Time can help heal both physical and emotional wounds.", "example_ko": "시간이 지나면 신체적, 감정적 상처 모두 치유될 수 있다."}
{"headword": "heatstroke", "meanings": [{"pos": "n.", "ko": "열사병"}], "meaning_ko": "열사병", "example_en": "Drinking enough water is important to prevent heatstroke in summer.", "example_ko": "여름에는 열사병을 예방하려면 충분한 물을 마시는 것이 중요하다."}
{"headword": "heir", "meanings": [{"pos": "n.", "ko": "상속인, 후계자"}], "meaning_ko": "상속인", "example_en": "He became the heir to his family's estate after his father passed away.", "example_ko": "그는 아버지가 돌아가신 후 집안 재산의 상속인이 되었다."}
{"headword": "helpless", "meanings": [{"pos": "a.", "ko": "무력한, 속수무책인"}, {"pos": "a.", "ko": "감당하지 못하는"}], "meaning_ko": "무력한", "example_en": "The kitten looked helpless in the middle of the busy street.", "example_ko": "그 새끼 고양이는 번화한 거리 한가운데서 무력해 보였다."}
{"headword": "helplessness", "meanings": [{"pos": "n.", "ko": "무력감, 난감함"}], "meaning_ko": "무력감", "example_en": "He felt a deep sense of helplessness when he couldn't solve the problem.", "example_ko": "그는 문제를 해결하지 못해 깊은 무력감을 느꼈다."}
{"headword": "hemisphere", "meanings": [{"pos": "n.", "ko": "반구, (지구·뇌의) 반구"}], "meaning_ko": "반구", "example_en": "The northern hemisphere experiences winter while the southern hemisphere has summer.", "example_ko": "북반구가 겨울일 때 남반구는 여름이다."}
{"headword": "hence", "meanings": [{"pos": "ad.", "ko": "그러므로, 따라서"}, {"pos": "ad.", "ko": "지금부터"}], "meaning_ko": "그러므로", "example_en": "He was the most experienced, hence he was chosen as the leader.", "example_ko": "그가 가장 경험이 많았으므로 리더로 뽑혔다."}
{"headword": "herd", "meanings": [{"pos": "n.", "ko": "(동물의) 떼, 무리"}, {"pos": "v.", "ko": "떼를 짓다, 모으다"}], "meaning_ko": "떼", "example_en": "A herd of elephants slowly crossed the river together.", "example_ko": "코끼리 떼가 함께 천천히 강을 건넜다."}
{"headword": "precious", "meanings": [{"pos": "a.", "ko": "소중한, 귀중한"}, {"pos": "a.", "ko": "값비싼, 비싼"}], "meaning_ko": "소중한", "example_en": "Family and friends are the most precious things in our lives.", "example_ko": "가족과 친구는 우리 삶에서 가장 소중한 존재이다."}
{"headword": "precise", "meanings": [{"pos": "a.", "ko": "정확한, 틀림없는"}, {"pos": "a.", "ko": "정밀한, 세밀한"}], "meaning_ko": "정확한", "example_en": "The scientist gave a precise explanation of the experiment's results.", "example_ko": "그 과학자는 실험 결과에 대해 정확하게 설명했다."}
{"headword": "precisely", "meanings": [{"pos": "ad.", "ko": "정확히, 틀림없이"}, {"pos": "ad.", "ko": "정밀하게, 꼼꼼하게"}], "meaning_ko": "정확히", "example_en": "The meeting will start precisely at 2 p.m., so please be on time.", "example_ko": "회의는 정확히 오후 2시에 시작하니 제시간에 오세요."}
{"headword": "precision", "meanings": [{"pos": "n.", "ko": "정확성, 정밀도"}, {"pos": "n.", "ko": "신중함, 꼼꼼함"}], "meaning_ko": "정확성", "example_en": "The machine was built with great precision to avoid any errors.", "example_ko": "그 기계는 오류를 막기 위해 매우 정확하게 제작되었다."}
{"headword": "predator", "meanings": [{"pos": "n.", "ko": "포식자, 육식 동물"}, {"pos": "n.", "ko": "약탈자, 착취자"}], "meaning_ko": "포식자", "example_en": "The lion is a powerful predator at the top of the food chain.", "example_ko": "사자는 먹이사슬의 최상위에 있는 강력한 포식자이다."}
{"headword": "predecessor", "meanings": [{"pos": "n.", "ko": "전임자, 이전의 것"}, {"pos": "n.", "ko": "선배, 선조"}], "meaning_ko": "전임자", "example_en": "The new manager thanked his predecessor for the helpful advice.", "example_ko": "신임 관리자는 전임자에게 유익한 조언에 대해 감사했다."}
{"headword": "predict", "meanings": [{"pos": "v.", "ko": "예측하다, 예상하다"}, {"pos": "v.", "ko": "예언하다"}], "meaning_ko": "예측하다", "example_en": "Experts predict that the economy will improve next year.", "example_ko": "전문가들은 내년에 경제가 나아질 것이라고 예측한다."}
{"headword": "predictable", "meanings": [{"pos": "a.", "ko": "예측 가능한, 뻔한"}, {"pos": "a.", "ko": "너무 평범한, 예상되는"}], "meaning_ko": "예측 가능한", "example_en": "The ending of the movie was too predictable for most viewers.", "example_ko": "영화의 결말은 대부분의 관객에게 너무 예측 가능했다."}
{"headword": "prediction", "meanings": [{"pos": "n.", "ko": "예측, 예상"}, {"pos": "n.", "ko": "예언"}], "meaning_ko": "예측", "example_en": "Her prediction about the weather turned out to be correct.", "example_ko": "그녀의 날씨 예측이 맞았다."}
{"headword": "predominant", "meanings": [{"pos": "a.", "ko": "두드러진, 현저한"}, {"pos": "a.", "ko": "지배적인, 우세한"}], "meaning_ko": "두드러진", "example_en": "English is the predominant language in international business.", "example_ko": "영어는 국제 비즈니스에서 두드러진 언어이다."}
{"headword": "predominantly", "meanings": [{"pos": "ad.", "ko": "주로, 대부분"}, {"pos": "ad.", "ko": "대부분의 경우에"}], "meaning_ko": "주로", "example_en": "The population in this area is predominantly young people.", "example_ko": "이 지역 인구는 주로 젊은 층이다."}
{"headword": "predominate", "meanings": [{"pos": "v.", "ko": "지배적이다, 우세하다"}, {"pos": "v.", "ko": "주도하다"}], "meaning_ko": "지배적이다", "example_en": "One political party tends to predominate in rural regions.", "example_ko": "한 정당이 농촌 지역에서 지배적인 경향이 있다."}
{"headword": "prefer", "meanings": [{"pos": "v.", "ko": "더 좋아하다, 선호하다"}, {"pos": "v.", "ko": "차라리 ~을 택하다"}], "meaning_ko": "더 좋아하다", "example_en": "Most students prefer studying in a quiet environment.", "example_ko": "대부분의 학생들은 조용한 환경에서 공부하는 것을 더 좋아한다."}
{"headword": "preferable", "meanings": [{"pos": "a.", "ko": "더 좋은, 더 바람직한"}, {"pos": "a.", "ko": "더 적합한"}], "meaning_ko": "더 좋은", "example_en": "It is preferable to arrive early for the interview.", "example_ko": "면접에는 일찍 도착하는 것이 더 좋다."}
{"headword": "preference", "meanings": [{"pos": "n.", "ko": "선호, 더 좋아함"}, {"pos": "n.", "ko": "선호하는 것"}], "meaning_ko": "선호", "example_en": "She showed a clear preference for classical music over pop.", "example_ko": "그녀는 팝보다 클래식 음악을 더 선호했다."}
{"headword": "pregnancy", "meanings": [{"pos": "n.", "ko": "임신"}, {"pos": "n.", "ko": "임신 기간"}], "meaning_ko": "임신", "example_en": "Regular check-ups are important during pregnancy for both mother and baby.", "example_ko": "임신 중에는 산모와 아기를 위해 정기 검진이 중요하다."}
{"headword": "pregnant", "meanings": [{"pos": "a.", "ko": "임신한"}, {"pos": "a.", "ko": "(의미, 중요성 등을) 내포한"}], "meaning_ko": "임신한", "example_en": "She discovered she was pregnant after visiting the doctor.", "example_ko": "그녀는 병원에 다녀온 후 임신 사실을 알게 되었다."}
{"headword": "prehistoric", "meanings": [{"pos": "a.", "ko": "선사 시대의, 역사 이전의"}, {"pos": "a.", "ko": "아주 오래된"}], "meaning_ko": "선사 시대의", "example_en": "Scientists study prehistoric bones to learn about ancient animals.", "example_ko": "과학자들은 고대 동물에 대해 알기 위해 선사 시대의 뼈를 연구한다."}
{"headword": "prejudice", "meanings": [{"pos": "n.", "ko": "편견, 선입견"}, {"pos": "v.", "ko": "편견을 갖게 하다"}], "meaning_ko": "편견", "example_en": "We must overcome prejudice to build a fair society.", "example_ko": "공정한 사회를 만들기 위해 우리는 편견을 극복해야 한다."}
{"headword": "preliminary", "meanings": [{"pos": "a.", "ko": "예비의, 준비의"}, {"pos": "a.", "ko": "서두의, 예선의"}, {"pos": "n.", "ko": "예비, 준비, 예선전"}], "meaning_ko": "예비의", "example_en": "The team passed the preliminary round and moved on to the finals.", "example_ko": "그 팀은 예선을 통과해 결승에 진출했다."}
{"headword": "outlet", "meanings": [{"pos": "n.", "ko": "배출구, 방출구"}, {"pos": "n.", "ko": "판매점, 아웃렛"}, {"pos": "n.", "ko": "(감정의) 표출 방법"}], "meaning_ko": "배출구", "example_en": "The pipe acts as an outlet for excess water during heavy rain.", "example_ko": "그 파이프는 폭우 시에 남는 물의 배출구 역할을 한다."}
{"headword": "outline", "meanings": [{"pos": "n.", "ko": "개요, 요약"}, {"pos": "n.", "ko": "윤곽, 외형"}, {"pos": "v.", "ko": "개요를 설명하다"}, {"pos": "v.", "ko": "윤곽을 나타내다"}], "meaning_ko": "개요", "example_en": "Before writing your essay, make a clear outline of your main points.", "example_ko": "에세이를 쓰기 전에 주요 내용을 명확하게 개요로 정리해라."}
{"headword": "outlook", "meanings": [{"pos": "n.", "ko": "전망, 예측"}, {"pos": "n.", "ko": "관점, 시각"}, {"pos": "n.", "ko": "경치, 조망"}], "meaning_ko": "전망", "example_en": "The economic outlook for next year is more positive than expected.", "example_ko": "내년의 경제 전망이 예상보다 더 긍정적이다."}
{"headword": "output", "meanings": [{"pos": "n.", "ko": "생산량, 산출"}, {"pos": "n.", "ko": "출력, 결과"}, {"pos": "v.", "ko": "출력하다"}], "meaning_ko": "생산량", "example_en": "Factory output increased significantly during the last quarter.", "example_ko": "공장 생산량이 지난 분기에 크게 늘었다."}
{"headword": "outrage", "meanings": [{"pos": "n.", "ko": "격분, 분노"}, {"pos": "n.", "ko": "잔혹 행위, 만행"}, {"pos": "v.", "ko": "격분하게 하다"}], "meaning_ko": "격분", "example_en": "The unfair decision caused public outrage among the citizens.", "example_ko": "그 불공정한 결정에 시민들 사이에서 격분이 일었다."}
{"headword": "outset", "meanings": [{"pos": "n.", "ko": "처음, 시작"}, {"pos": "n.", "ko": "발단, 기점"}], "meaning_ko": "처음", "example_en": "At the outset of the project, everyone was full of enthusiasm.", "example_ko": "프로젝트 초반에는 모두가 열정에 가득 차 있었다."}
{"headword": "outstanding", "meanings": [{"pos": "a.", "ko": "뛰어난, 우수한"}, {"pos": "a.", "ko": "두드러진, 눈에 띄는"}, {"pos": "a.", "ko": "미결제의, 미해결의"}], "meaning_ko": "뛰어난", "example_en": "She received an award for her outstanding academic achievements.", "example_ko": "그녀는 뛰어난 학업 성적으로 상을 받았다."}
{"headword": "outweigh", "meanings": [{"pos": "v.", "ko": "~보다 더 크다, 중요하다"}, {"pos": "v.", "ko": "~보다 무겁다"}], "meaning_ko": "더 중요하다", "example_en": "The benefits of exercising regularly outweigh the possible risks.", "example_ko": "규칙적으로 운동하는 이점이 잠재적 위험보다 더 크다."}
{"headword": "oval", "meanings": [{"pos": "a.", "ko": "타원형의, 달걀 모양의"}, {"pos": "n.", "ko": "타원형, 타원"}], "meaning_ko": "타원형의", "example_en": "The artist drew an oval face for the character in his painting.", "example_ko": "그 화가는 그림 속 인물의 얼굴을 타원형으로 그렸다."}
{"headword": "overall", "meanings": [{"pos": "a.", "ko": "전반적인, 전체의"}, {"pos": "ad.", "ko": "전반적으로, 전체적으로"}], "meaning_ko": "전반적인", "example_en": "The overall performance of the team improved this season.", "example_ko": "이번 시즌 팀의 전반적인 성적이 향상되었다."}
{"headword": "overcome", "meanings": [{"pos": "v.", "ko": "극복하다, 이겨내다"}, {"pos": "v.", "ko": "이기다, 제압하다"}], "meaning_ko": "극복하다", "example_en": "He managed to overcome many obstacles to achieve his dream.", "example_ko": "그는 꿈을 이루기 위해 많은 장애물을 극복했다."}
{"headword": "overestimate", "meanings": [{"pos": "v.", "ko": "과대평가하다"}, {"pos": "n.", "ko": "과대평가"}], "meaning_ko": "과대평가하다", "example_en": "We should not overestimate our ability to finish the task quickly.", "example_ko": "우리는 일을 빨리 끝낼 수 있는 능력을 과대평가해서는 안 된다."}
{"headword": "overflow", "meanings": [{"pos": "v.", "ko": "넘치다, 범람하다"}, {"pos": "v.", "ko": "가득 차다, 넘쳐나다"}, {"pos": "n.", "ko": "넘침, 범람"}], "meaning_ko": "넘치다", "example_en": "The river will overflow if the rain continues all night.", "example_ko": "비가 밤새 내리면 강이 넘칠 것이다."}
{"headword": "overhead", "meanings": [{"pos": "ad.", "ko": "머리 위에, 위쪽에"}, {"pos": "a.", "ko": "머리 위의, 위에 있는"}], "meaning_ko": "머리 위에", "example_en": "The lights overhead suddenly went out during the performance.", "example_ko": "공연 도중 머리 위의 조명이 갑자기 꺼졌다."}
{"headword": "overlap", "meanings": [{"pos": "v.", "ko": "겹치다, 포개지다"}, {"pos": "v.", "ko": "중복되다, 일부 일치하다"}, {"pos": "n.", "ko": "겹침, 중복"}], "meaning_ko": "겹치다", "example_en": "Some of the students' ideas overlap with each other.", "example_ko": "몇몇 학생들의 아이디어가 서로 겹친다."}
{"headword": "overload", "meanings": [{"pos": "v.", "ko": "과부하를 주다, 너무 많이 싣다"}, {"pos": "n.", "ko": "과부하, 과중"}], "meaning_ko": "과부하를 주다", "example_en": "If you overload the circuit, it may cause a power outage.", "example_ko": "회로에 과부하를 주면 정전이 발생할 수 있다."}
{"headword": "overlook", "meanings": [{"pos": "v.", "ko": "간과하다, 못 보고 넘어가다"}, {"pos": "v.", "ko": "눈감아 주다"}, {"pos": "v.", "ko": "내려다보다"}], "meaning_ko": "간과하다", "example_en": "It's easy to overlook small mistakes when you are in a hurry.", "example_ko": "서두를 때 작은 실수를 간과하기 쉽다."}
{"headword": "overseas", "meanings": [{"pos": "ad.", "ko": "해외로, 해외에"}, {"pos": "a.", "ko": "해외의, 외국의"}], "meaning_ko": "해외로", "example_en": "Many students plan to study overseas after graduation.", "example_ko": "많은 학생들이 졸업 후 해외로 유학을 계획한다."}
{"headword": "oversee", "meanings": [{"pos": "v.", "ko": "감독하다, 관리하다"}], "meaning_ko": "감독하다", "example_en": "The manager will oversee the progress of the new project.", "example_ko": "매니저가 새 프로젝트의 진행을 감독할 것이다."}
{"headword": "overtake", "meanings": [{"pos": "v.", "ko": "추월하다, 따라잡다"}, {"pos": "v.", "ko": "능가하다, 앞지르다"}, {"pos": "v.", "ko": "(재난·감정 등이) 덮치다, 엄습하다"}], "meaning_ko": "추월하다", "example_en": "The runner tried to overtake his competitor in the final lap.", "example_ko": "그 주자는 마지막 바퀴에서 경쟁자를 추월하려고 했다."}
{"headword": "organic", "meanings": [{"pos": "a.", "ko": "유기농의, 화학 첨가물이 없는"}, {"pos": "a.", "ko": "유기체의, 생물의"}, {"pos": "a.", "ko": "체계적으로 연결된"}], "meaning_ko": "유기농의", "example_en": "Many people prefer organic vegetables because they are grown without chemicals.", "example_ko": "많은 사람들이 화학물질 없이 재배된 유기농 채소를 선호한다."}
{"headword": "organism", "meanings": [{"pos": "n.", "ko": "생물, 유기체"}, {"pos": "n.", "ko": "미생물"}], "meaning_ko": "생물", "example_en": "Every organism in the ecosystem plays an important role in maintaining balance.", "example_ko": "생태계의 모든 생물은 균형을 유지하는 데 중요한 역할을 한다."}
{"headword": "organize", "meanings": [{"pos": "v.", "ko": "정리하다, 체계화하다"}, {"pos": "v.", "ko": "조직하다, 구성하다"}, {"pos": "v.", "ko": "행사를 준비하다"}], "meaning_ko": "정리하다", "example_en": "She decided to organize her notes before the final exam.", "example_ko": "그녀는 기말고사 전에 노트를 정리하기로 했다."}
{"headword": "orient", "meanings": [{"pos": "v.", "ko": "~을 (특정 방향으로) 향하게 하다"}, {"pos": "v.", "ko": "적응시키다, 익숙하게 하다"}], "meaning_ko": "향하게 하다", "example_en": "The architect will orient the building to get the most sunlight.", "example_ko": "건축가는 건물이 햇빛을 가장 잘 받도록 방향을 맞출 것이다."}
{"headword": "orientation", "meanings": [{"pos": "n.", "ko": "관심, 지향"}, {"pos": "n.", "ko": "(신입 대상) 예비 교육, 오리엔테이션"}, {"pos": "n.", "ko": "방향 설정"}], "meaning_ko": "관심", "example_en": "His orientation toward science influenced his choice of university.", "example_ko": "그의 과학에 대한 관심이 대학 선택에 영향을 주었다."}
{"headword": "origin", "meanings": [{"pos": "n.", "ko": "기원, 유래"}, {"pos": "n.", "ko": "출신, 태생"}], "meaning_ko": "기원", "example_en": "The origin of this tradition dates back hundreds of years.", "example_ko": "이 전통의 기원은 수백 년 전으로 거슬러 올라간다."}
{"headword": "original", "meanings": [{"pos": "a.", "ko": "원래의, 최초의"}, {"pos": "a.", "ko": "독창적인, 참신한"}, {"pos": "n.", "ko": "원본, 원작"}], "meaning_ko": "원래의", "example_en": "The original painting is displayed in the main hall of the museum.", "example_ko": "그 원래의 그림은 박물관의 본관에 전시되어 있다."}
{"headword": "originality", "meanings": [{"pos": "n.", "ko": "독창성, 참신함"}, {"pos": "n.", "ko": "기발함"}], "meaning_ko": "독창성", "example_en": "Her originality made her artwork stand out from the rest.", "example_ko": "그녀의 독창성 덕분에 작품이 다른 것들과 차별화되었다."}
{"headword": "originate", "meanings": [{"pos": "v.", "ko": "비롯되다, 시작되다"}, {"pos": "v.", "ko": "발명하다, 고안하다"}], "meaning_ko": "비롯되다", "example_en": "The custom is believed to have originated in ancient times.", "example_ko": "그 관습은 고대에 비롯된 것으로 여겨진다."}
{"headword": "ornament", "meanings": [{"pos": "n.", "ko": "장식품, 장식"}, {"pos": "v.", "ko": "장식하다"}], "meaning_ko": "장식품", "example_en": "She placed a beautiful ornament on the Christmas tree.", "example_ko": "그녀는 크리스마스 트리에 예쁜 장식품을 달았다."}
{"headword": "orphan", "meanings": [{"pos": "n.", "ko": "고아"}, {"pos": "v.", "ko": "고아로 만들다"}], "meaning_ko": "고아", "example_en": "The orphan found a new family through the adoption program.", "example_ko": "그 고아는 입양 프로그램을 통해 새 가족을 만났다."}
{"headword": "otherwise", "meanings": [{"pos": "ad.", "ko": "달리, 다르게"}, {"pos": "ad.", "ko": "그렇지 않으면"}, {"pos": "ad.", "ko": "다른 점에서"}], "meaning_ko": "달리", "example_en": "You must follow the rules; otherwise, you may be asked to leave.", "example_ko": "규칙을 지켜야 한다. 그렇지 않으면 퇴장당할 수도 있다."}
{"headword": "out of place", "meanings": [{"pos": "phr.", "ko": "어울리지 않는, 부적절한"}, {"pos": "phr.", "ko": "제자리에 있지 않은"}], "meaning_ko": "어울리지 않는", "example_en": "He felt out of place at the formal dinner party.", "example_ko": "그는 격식을 차린 저녁 파티에서 어울리지 않는 느낌을 받았다."}
{"headword": "outbreak", "meanings": [{"pos": "n.", "ko": "(질병·전쟁 등의) 발생, 발발"}], "meaning_ko": "발생", "example_en": "The outbreak of the disease caused concern throughout the city.", "example_ko": "그 질병의 발생은 도시 전체에 우려를 불러일으켰다."}
{"headword": "outburst", "meanings": [{"pos": "n.", "ko": "(감정의) 폭발, 분출"}], "meaning_ko": "폭발", "example_en": "His sudden outburst surprised everyone in the room.", "example_ko": "그의 갑작스러운 폭발적인 반응에 방 안의 모두가 놀랐다."}
{"headword": "outcome", "meanings": [{"pos": "n.", "ko": "결과, 성과"}], "meaning_ko": "결과", "example_en": "The outcome of the experiment was different from what we expected.", "example_ko": "실험 결과는 우리가 예상했던 것과 달랐다."}
{"headword": "outdated", "meanings": [{"pos": "a.", "ko": "구식의, 시대에 뒤떨어진"}], "meaning_ko": "구식의", "example_en": "The computer system is outdated and needs to be replaced soon.", "example_ko": "그 컴퓨터 시스템은 구식이라 곧 교체해야 한다."}
{"headword": "outfit", "meanings": [{"pos": "n.", "ko": "옷차림, 복장"}, {"pos": "n.", "ko": "장비, 도구"}], "meaning_ko": "옷차림", "example_en": "She wore a stylish outfit to the school festival.", "example_ko": "그녀는 학교 축제에 멋진 옷차림으로 참석했다."}
{"headword": "outgoing", "meanings": [{"pos": "a.", "ko": "사교적인, 외향적인"}, {"pos": "a.", "ko": "떠나는, 물러나는"}], "meaning_ko": "사교적인", "example_en": "He is very outgoing and makes friends easily wherever he goes.", "example_ko": "그는 매우 사교적이라 어디서든 쉽게 친구를 만든다."}
{"headword": "outlaw", "meanings": [{"pos": "n.", "ko": "범법자, 무법자"}, {"pos": "v.", "ko": "불법화하다"}], "meaning_ko": "범법자", "example_en": "The outlaw was finally caught after months of searching.", "example_ko": "그 범법자는 몇 달간의 수색 끝에 마침내 붙잡혔다."}
{"headword": "principle", "meanings": [{"pos": "n.", "ko": "기본 원리, 근본 법칙"}, {"pos": "n.", "ko": "신념, 도덕적 기준"}, {"pos": "n.", "ko": "방침, 행동 지침"}], "meaning_ko": "기본 원리", "example_en": "The principle of equality is important in modern society.", "example_ko": "평등의 원리는 현대 사회에서 중요하다."}
{"headword": "prior", "meanings": [{"pos": "a.", "ko": "이전의, 앞선"}, {"pos": "a.", "ko": "더 중요한, 우선하는"}], "meaning_ko": "이전의", "example_en": "She had no prior experience before starting this job.", "example_ko": "그녀는 이 일을 시작하기 전에 경험이 없었다."}
{"headword": "prioritize", "meanings": [{"pos": "v.", "ko": "우선순위를 정하다"}, {"pos": "v.", "ko": "더 중요하게 여기다"}], "meaning_ko": "우선순위 정하다", "example_en": "You should prioritize your assignments to manage your time well.", "example_ko": "시간 관리를 잘하려면 과제의 우선순위를 정해야 한다."}
{"headword": "priority", "meanings": [{"pos": "n.", "ko": "우선순위"}, {"pos": "n.", "ko": "우선권"}], "meaning_ko": "우선순위", "example_en": "Finishing the project on time is our top priority.", "example_ko": "기한 내에 프로젝트를 끝내는 것이 우리의 최우선 과제다."}
{"headword": "prison", "meanings": [{"pos": "n.", "ko": "감옥, 교도소"}], "meaning_ko": "감옥", "example_en": "He was sent to prison for breaking the law.", "example_ko": "그는 법을 어겨 감옥에 갔다."}
{"headword": "prisoner", "meanings": [{"pos": "n.", "ko": "죄수, 수감자"}, {"pos": "n.", "ko": "포로"}], "meaning_ko": "죄수", "example_en": "The prisoner was released after serving ten years.", "example_ko": "그 죄수는 10년 복역 후에 풀려났다."}
{"headword": "privacy", "meanings": [{"pos": "n.", "ko": "사생활, 개인 정보"}, {"pos": "n.", "ko": "혼자 있는 상태"}], "meaning_ko": "사생활", "example_en": "Many people worry about their privacy on social media.", "example_ko": "많은 사람들이 소셜 미디어에서 사생활을 걱정한다."}
{"headword": "private", "meanings": [{"pos": "a.", "ko": "개인적인, 사적인"}, {"pos": "a.", "ko": "비밀의, 공개되지 않은"}], "meaning_ko": "개인적인", "example_en": "He shared his private thoughts only with close friends.", "example_ko": "그는 자신의 개인적인 생각을 친한 친구들에게만 털어놓았다."}
{"headword": "privately", "meanings": [{"pos": "ad.", "ko": "남몰래, 은밀히"}, {"pos": "ad.", "ko": "개인적으로, 사적으로"}], "meaning_ko": "남몰래", "example_en": "She spoke to her teacher privately after class.", "example_ko": "그녀는 수업이 끝난 후 남몰래 선생님과 이야기했다."}
{"headword": "privilege", "meanings": [{"pos": "n.", "ko": "특권, 특별한 혜택"}, {"pos": "n.", "ko": "영광, 명예"}, {"pos": "v.", "ko": "특권을 주다"}], "meaning_ko": "특권", "example_en": "Education is still a privilege in some countries.", "example_ko": "교육은 아직도 일부 나라에서는 특권이다."}
{"headword": "privileged", "meanings": [{"pos": "a.", "ko": "특권을 가진, 혜택받은"}], "meaning_ko": "특권을 가진", "example_en": "She feels privileged to study at a top university.", "example_ko": "그녀는 명문대에서 공부하게 되어 특권을 누린다고 느낀다."}
{"headword": "probability", "meanings": [{"pos": "n.", "ko": "확률, 가능성"}], "meaning_ko": "확률", "example_en": "The probability of rain tomorrow is quite high.", "example_ko": "내일 비가 올 확률이 꽤 높다."}
{"headword": "probable", "meanings": [{"pos": "a.", "ko": "있을 법한, 가능성이 높은"}], "meaning_ko": "있을 법한", "example_en": "It is probable that the event will be canceled due to the weather.", "example_ko": "날씨 때문에 행사가 취소될 가능성이 있다."}
{"headword": "probably", "meanings": [{"pos": "ad.", "ko": "아마도, 십중팔구"}], "meaning_ko": "아마도", "example_en": "He will probably arrive before noon today.", "example_ko": "그는 아마 오늘 정오 전에 도착할 것이다."}
{"headword": "probe", "meanings": [{"pos": "v.", "ko": "엄밀히 조사하다, 진상을 규명하다"}, {"pos": "n.", "ko": "철저한 조사, 탐사"}], "meaning_ko": "조사하다", "example_en": "Scientists probe the ocean floor to learn more about marine life.", "example_ko": "과학자들은 해양 생물을 더 알기 위해 바닷속을 조사한다."}
{"headword": "procedure", "meanings": [{"pos": "n.", "ko": "절차, 순서"}, {"pos": "n.", "ko": "진행 방식"}], "meaning_ko": "절차", "example_en": "You must follow the correct procedure when applying for a visa.", "example_ko": "비자를 신청할 때는 올바른 절차를 따라야 한다."}
{"headword": "proceed", "meanings": [{"pos": "v.", "ko": "계속하다, 진행하다"}, {"pos": "v.", "ko": "나아가다"}], "meaning_ko": "계속하다", "example_en": "After a short break, the meeting will proceed as planned.", "example_ko": "잠깐 쉬고 나서 회의는 예정대로 계속된다."}
{"headword": "proceeding", "meanings": [{"pos": "n.", "ko": "행사, 일련의 행위"}, {"pos": "n.", "ko": "소송 절차"}], "meaning_ko": "행사", "example_en": "The proceeding began with a welcoming speech from the host.", "example_ko": "행사는 주최자의 환영사로 시작되었다."}
{"headword": "process", "meanings": [{"pos": "n.", "ko": "진행, 과정"}, {"pos": "n.", "ko": "(생산) 공정, 처리"}, {"pos": "v.", "ko": "(자료·서류 등을) 처리하다"}], "meaning_ko": "과정", "example_en": "Learning a new language is a slow and steady process.", "example_ko": "새로운 언어를 배우는 것은 느리고 꾸준한 과정이다."}
{"headword": "proclaim", "meanings": [{"pos": "v.", "ko": "공식적으로 선언하다, 공표하다"}], "meaning_ko": "선언하다", "example_en": "The government will proclaim a national holiday next month.", "example_ko": "정부는 다음 달에 공휴일을 선포할 예정이다."}
{"headword": "premature", "meanings": [{"pos": "a.", "ko": "시기상조의, 너무 이른"}, {"pos": "a.", "ko": "조급한, 성급한"}], "meaning_ko": "시기상조의", "example_en": "The decision to cancel the event was premature and surprised many people.", "example_ko": "행사를 취소한 결정은 시기상조여서 많은 사람들을 놀라게 했다."}
{"headword": "preoccupation", "meanings": [{"pos": "n.", "ko": "몰두, 집착"}, {"pos": "n.", "ko": "걱정거리, 관심사"}], "meaning_ko": "몰두", "example_en": "Her preoccupation with her studies left her little time for friends.", "example_ko": "그녀는 공부에 몰두하느라 친구들과 보낼 시간이 거의 없었다."}
{"headword": "preparation", "meanings": [{"pos": "n.", "ko": "준비, 대비"}, {"pos": "n.", "ko": "준비 과정, 예비 조치"}], "meaning_ko": "준비", "example_en": "Proper preparation is essential before taking an important exam.", "example_ko": "중요한 시험을 치르기 전에는 철저한 준비가 필수적이다."}
{"headword": "prepare", "meanings": [{"pos": "v.", "ko": "준비하다, 대비하다"}, {"pos": "v.", "ko": "조리하다, 마련하다"}], "meaning_ko": "준비하다", "example_en": "Students should prepare for the test by reviewing their notes every day.", "example_ko": "학생들은 매일 노트를 복습하며 시험을 준비해야 한다."}
{"headword": "prescribe", "meanings": [{"pos": "v.", "ko": "(약을) 처방하다"}, {"pos": "v.", "ko": "(규칙 등을) 규정하다, 정하다"}], "meaning_ko": "처방하다", "example_en": "The doctor will prescribe medicine to help you recover quickly.", "example_ko": "의사가 당신이 빨리 회복하도록 약을 처방해 줄 것이다."}
{"headword": "prescription", "meanings": [{"pos": "n.", "ko": "처방전, 처방약"}, {"pos": "n.", "ko": "규정, 명령"}], "meaning_ko": "처방전", "example_en": "You need a prescription from your doctor to buy this medication.", "example_ko": "이 약을 사려면 의사의 처방전이 필요하다."}
{"headword": "presence", "meanings": [{"pos": "n.", "ko": "존재, 있음"}, {"pos": "n.", "ko": "출석, 참석"}], "meaning_ko": "존재", "example_en": "The presence of security guards made everyone feel safer at the event.", "example_ko": "경비원들이 있어서 행사장에 있던 모두가 더 안전하게 느꼈다."}
{"headword": "present", "meanings": [{"pos": "a.", "ko": "출석한, 참석한"}, {"pos": "a.", "ko": "현재의, 지금의"}, {"pos": "v.", "ko": "제출하다, 주다"}, {"pos": "v.", "ko": "보여주다, 나타내다"}, {"pos": "n.", "ko": "선물"}, {"pos": "n.", "ko": "현재"}], "meaning_ko": "출석한", "example_en": "All students must be present in the classroom before the bell rings.", "example_ko": "모든 학생은 종이 울리기 전에 교실에 출석해 있어야 한다."}
{"headword": "presentation", "meanings": [{"pos": "n.", "ko": "발표, 설명"}, {"pos": "n.", "ko": "제출, 제시"}, {"pos": "n.", "ko": "공연, 상연"}], "meaning_ko": "발표", "example_en": "She gave a presentation about climate change to her classmates.", "example_ko": "그녀는 반 친구들에게 기후 변화에 대해 발표했다."}
{"headword": "preservation", "meanings": [{"pos": "n.", "ko": "보존, 보호"}, {"pos": "n.", "ko": "유지, 관리"}], "meaning_ko": "보존", "example_en": "The preservation of historic buildings is important for cultural heritage.", "example_ko": "역사적 건물의 보존은 문화유산을 위해 중요하다."}
{"headword": "preservative", "meanings": [{"pos": "n.", "ko": "방부제"}], "meaning_ko": "방부제", "example_en": "This food contains no artificial preservative, so eat it soon.", "example_ko": "이 음식에는 인공 방부제가 들어 있지 않으니 빨리 먹어야 한다."}
{"headword": "preserve", "meanings": [{"pos": "v.", "ko": "보호하다, 보존하다"}, {"pos": "v.", "ko": "유지하다, 지키다"}], "meaning_ko": "보호하다", "example_en": "We must preserve the environment for future generations.", "example_ko": "우리는 미래 세대를 위해 환경을 보호해야 한다."}
{"headword": "president", "meanings": [{"pos": "n.", "ko": "대통령"}, {"pos": "n.", "ko": "(회사 등의) 회장, 총장"}], "meaning_ko": "대통령", "example_en": "The president gave a speech about the country's future plans.", "example_ko": "대통령은 나라의 미래 계획에 대해 연설했다."}
{"headword": "presidential", "meanings": [{"pos": "a.", "ko": "대통령의"}], "meaning_ko": "대통령의", "example_en": "The presidential election attracted attention from people around the world.", "example_ko": "대통령 선거는 전 세계 사람들의 관심을 끌었다."}
{"headword": "press", "meanings": [{"pos": "v.", "ko": "누르다, 압박하다"}, {"pos": "n.", "ko": "언론, 보도 기관"}, {"pos": "n.", "ko": "인쇄기, 출판물"}], "meaning_ko": "누르다", "example_en": "Please press the button to start the machine.", "example_ko": "기계를 작동하려면 버튼을 눌러 주세요."}
{"headword": "pressure", "meanings": [{"pos": "n.", "ko": "압력, 압박"}, {"pos": "n.", "ko": "스트레스, 중압감"}], "meaning_ko": "압력", "example_en": "The pressure inside the container must be checked regularly.", "example_ko": "용기 내부의 압력은 정기적으로 점검해야 한다."}
{"headword": "prestige", "meanings": [{"pos": "n.", "ko": "명성, 위신"}, {"pos": "a.", "ko": "명문의, 일류의"}], "meaning_ko": "명성", "example_en": "Winning the award brought great prestige to the university.", "example_ko": "그 상을 수상하면서 대학의 명성이 크게 높아졌다."}
{"headword": "prestigious", "meanings": [{"pos": "a.", "ko": "명성 있는, 명문의"}], "meaning_ko": "명성 있는", "example_en": "He graduated from a prestigious university in the United States.", "example_ko": "그는 미국의 명문 대학을 졸업했다."}
{"headword": "presume", "meanings": [{"pos": "v.", "ko": "추정하다, 가정하다"}, {"pos": "v.", "ko": "주제넘게 굴다"}], "meaning_ko": "추정하다", "example_en": "We can presume that the meeting will start on time.", "example_ko": "회의가 제시간에 시작될 것이라고 추정할 수 있다."}
{"headword": "presumption", "meanings": [{"pos": "n.", "ko": "추정, 가정"}, {"pos": "n.", "ko": "뻔뻔함, 주제넘음"}], "meaning_ko": "추정", "example_en": "His presumption that everyone agreed was clearly incorrect.", "example_ko": "모두가 동의할 것이라는 그의 추정은 분명히 틀렸다."}
{"headword": "spark", "meanings": [{"pos": "n.", "ko": "불꽃, 번쩍임"}, {"pos": "v.", "ko": "불러일으키다, 촉발하다"}], "meaning_ko": "불꽃", "example_en": "A single spark can start a large forest fire in dry weather.", "example_ko": "건조한 날씨에는 작은 불꽃 하나가 큰 산불로 이어질 수 있다."}
{"headword": "spatial", "meanings": [{"pos": "a.", "ko": "공간의, 공간적인"}], "meaning_ko": "공간의", "example_en": "Spatial awareness is important for athletes during a fast-paced game.", "example_ko": "빠른 경기에서는 선수들에게 공간 감각이 중요하다."}
{"headword": "spear", "meanings": [{"pos": "n.", "ko": "창, 투창"}, {"pos": "v.", "ko": "창으로 찌르다"}], "meaning_ko": "창", "example_en": "The ancient warrior carried a long spear into battle.", "example_ko": "고대 전사는 긴 창을 들고 전투에 나섰다."}
{"headword": "special", "meanings": [{"pos": "a.", "ko": "특별한, 독특한"}, {"pos": "a.", "ko": "전용의, 특정한 목적의"}], "meaning_ko": "특별한", "example_en": "She made a special cake for her friend's birthday party.", "example_ko": "그녀는 친구의 생일 파티를 위해 특별한 케이크를 만들었다."}
{"headword": "specialist", "meanings": [{"pos": "n.", "ko": "전문가, 전문의"}], "meaning_ko": "전문가", "example_en": "If the symptoms continue, you should consult a medical specialist.", "example_ko": "증상이 계속되면 전문의와 상담해야 한다."}
{"headword": "specialize", "meanings": [{"pos": "v.", "ko": "전문으로 하다, 전공하다"}], "meaning_ko": "전문으로 하다", "example_en": "She decided to specialize in environmental engineering at university.", "example_ko": "그녀는 대학에서 환경공학을 전공하기로 했다."}
{"headword": "specially", "meanings": [{"pos": "ad.", "ko": "특별히, 특별하게"}], "meaning_ko": "특별히", "example_en": "The invitation was specially designed for the graduation ceremony.", "example_ko": "그 초대장은 졸업식을 위해 특별히 제작되었다."}
{"headword": "species", "meanings": [{"pos": "n.", "ko": "(생물 분류상의) 종"}, {"pos": "n.", "ko": "종류, 유형"}], "meaning_ko": "종", "example_en": "This forest is home to many rare species of birds.", "example_ko": "이 숲에는 희귀한 새의 종들이 많이 산다."}
{"headword": "specific", "meanings": [{"pos": "a.", "ko": "특정한, 분명한"}, {"pos": "a.", "ko": "구체적인, 자세한"}], "meaning_ko": "특정한", "example_en": "Each student was given a specific task for the project.", "example_ko": "각 학생은 프로젝트에서 특정한 임무를 맡았다."}
{"headword": "specifically", "meanings": [{"pos": "ad.", "ko": "특히, 특별히"}, {"pos": "ad.", "ko": "구체적으로, 명확하게"}], "meaning_ko": "특히", "example_en": "This rule was created specifically to protect endangered animals.", "example_ko": "이 규칙은 특히 멸종 위기 동물을 보호하기 위해 만들어졌다."}
{"headword": "specification", "meanings": [{"pos": "n.", "ko": "명세 사항, 세부 내역"}, {"pos": "n.", "ko": "상세 설명서"}], "meaning_ko": "명세 사항", "example_en": "The engineer checked every specification before starting the construction.", "example_ko": "엔지니어는 공사를 시작하기 전에 모든 명세 사항을 확인했다."}
{"headword": "spectacle", "meanings": [{"pos": "n.", "ko": "장관, 구경거리"}, {"pos": "n.", "ko": "안경"}], "meaning_ko": "장관", "example_en": "The fireworks created a beautiful spectacle in the night sky.", "example_ko": "불꽃놀이가 밤하늘에 아름다운 장관을 연출했다."}
{"headword": "spectacular", "meanings": [{"pos": "a.", "ko": "장관의, 화려한"}, {"pos": "a.", "ko": "구경거리의, 인상적인"}], "meaning_ko": "장관의", "example_en": "The view from the mountain top was truly spectacular at sunrise.", "example_ko": "산 정상에서 본 일출은 정말 장관이었다."}
{"headword": "spectator", "meanings": [{"pos": "n.", "ko": "관중, 구경꾼"}], "meaning_ko": "관중", "example_en": "Thousands of spectators filled the stadium for the final match.", "example_ko": "결승전을 보기 위해 수천 명의 관중이 경기장을 가득 메웠다."}
{"headword": "speculate", "meanings": [{"pos": "v.", "ko": "추측하다, 짐작하다"}, {"pos": "v.", "ko": "투기하다"}], "meaning_ko": "추측하다", "example_en": "Scientists often speculate about the possibility of life on other planets.", "example_ko": "과학자들은 종종 다른 행성에 생명체가 있을 가능성을 추측한다."}
{"headword": "spell", "meanings": [{"pos": "v.", "ko": "철자를 쓰다, 철자를 말하다"}, {"pos": "n.", "ko": "한동안, 기간"}, {"pos": "n.", "ko": "주문, 마법"}], "meaning_ko": "철자를 쓰다", "example_en": "Can you spell your name for me so I can write it correctly?", "example_ko": "정확히 적을 수 있도록 이름의 철자를 말해 줄 수 있나요?"}
{"headword": "sphere", "meanings": [{"pos": "n.", "ko": "구, 구체"}, {"pos": "n.", "ko": "영역, 분야"}], "meaning_ko": "구", "example_en": "The Earth is almost a perfect sphere in shape.", "example_ko": "지구는 거의 완벽한 구형에 가깝다."}
{"headword": "spherical", "meanings": [{"pos": "a.", "ko": "구 모양의, 구형의"}], "meaning_ko": "구 모양의", "example_en": "Bubbles in water are usually spherical due to surface tension.", "example_ko": "물속의 거품은 표면 장력 때문에 보통 구 모양이다."}
{"headword": "spice", "meanings": [{"pos": "n.", "ko": "향신료, 양념"}, {"pos": "v.", "ko": "양념을 넣다"}], "meaning_ko": "향신료", "example_en": "Adding a little spice can make the dish much more flavorful.", "example_ko": "약간의 향신료를 넣으면 요리가 훨씬 맛있어진다."}
{"headword": "spike", "meanings": [{"pos": "n.", "ko": "뾰족한 것, 못"}, {"pos": "n.", "ko": "급증, 급등"}, {"pos": "v.", "ko": "급등하다"}], "meaning_ko": "뾰족한 것", "example_en": "The fence was topped with a row of sharp metal spikes.", "example_ko": "울타리 위에는 날카로운 금속 뾰족한 것들이 줄지어 있었다."}
{"headword": "respectively", "meanings": [{"pos": "ad.", "ko": "각각, 각자"}], "meaning_ko": "각각", "example_en": "The students received first, second, and third place, respectively, in the contest.", "example_ko": "학생들은 대회에서 각각 1등, 2등, 3등을 차지했다."}
{"headword": "respond", "meanings": [{"pos": "v.", "ko": "반응하다"}, {"pos": "v.", "ko": "대답하다, 응답하다"}], "meaning_ko": "반응하다", "example_en": "The audience responded positively to the speaker's message.", "example_ko": "청중은 연설자의 메시지에 긍정적으로 반응했다."}
{"headword": "respondent", "meanings": [{"pos": "n.", "ko": "응답자, 답변자"}], "meaning_ko": "응답자", "example_en": "Each respondent completed the survey about their study habits.", "example_ko": "각 응답자는 자신의 학습 습관에 관한 설문지를 작성했다."}
{"headword": "response", "meanings": [{"pos": "n.", "ko": "반응, 대응"}, {"pos": "n.", "ko": "대답, 응답"}], "meaning_ko": "반응", "example_en": "Her response to the sudden question was quick and thoughtful.", "example_ko": "갑작스러운 질문에 그녀는 빠르고 신중하게 반응했다."}
{"headword": "responsibility", "meanings": [{"pos": "n.", "ko": "책임, 의무"}, {"pos": "n.", "ko": "책임감"}], "meaning_ko": "책임", "example_en": "It is your responsibility to submit the assignment on time.", "example_ko": "과제를 제때 제출하는 것은 너의 책임이다."}
{"headword": "responsible", "meanings": [{"pos": "a.", "ko": "책임이 있는, 맡고 있는"}, {"pos": "a.", "ko": "원인이 되는"}, {"pos": "a.", "ko": "책임감 있는"}], "meaning_ko": "책임이 있는", "example_en": "He is responsible for organizing the school festival this year.", "example_ko": "그는 올해 학교 축제를 준비하는 일을 맡고 있다."}
{"headword": "responsive", "meanings": [{"pos": "a.", "ko": "즉각 반응하는"}, {"pos": "a.", "ko": "호응하는"}], "meaning_ko": "즉각 반응하는", "example_en": "The company is very responsive to customer feedback and suggestions.", "example_ko": "그 회사는 고객의 피드백과 제안에 매우 즉각적으로 반응한다."}
{"headword": "restorable", "meanings": [{"pos": "a.", "ko": "회복할 수 있는, 복구할 수 있는"}], "meaning_ko": "회복할 수 있는", "example_en": "The damaged painting is restorable with careful conservation work.", "example_ko": "손상된 그림은 세심한 보존 작업으로 회복할 수 있다."}
{"headword": "restoration", "meanings": [{"pos": "n.", "ko": "복원, 복구"}, {"pos": "n.", "ko": "회복"}, {"pos": "n.", "ko": "반환"}], "meaning_ko": "복원", "example_en": "The restoration of the ancient temple took several years to complete.", "example_ko": "고대 사원의 복원 작업은 몇 년이 걸렸다."}
{"headword": "restorative", "meanings": [{"pos": "a.", "ko": "회복시키는, 원기를 회복하는"}, {"pos": "n.", "ko": "회복제"}], "meaning_ko": "회복시키는", "example_en": "A good night's sleep can have a restorative effect on your body and mind.", "example_ko": "충분한 수면은 몸과 마음을 회복시키는 효과가 있다."}
{"headword": "restore", "meanings": [{"pos": "v.", "ko": "회복하다, 복구하다"}, {"pos": "v.", "ko": "복원하다"}, {"pos": "v.", "ko": "돌려주다"}], "meaning_ko": "회복하다", "example_en": "The government worked hard to restore order after the disaster.", "example_ko": "정부는 재난 이후 질서를 회복하기 위해 힘썼다."}
{"headword": "restrain", "meanings": [{"pos": "v.", "ko": "제지하다, 못하게 하다"}, {"pos": "v.", "ko": "억누르다, 억제하다"}], "meaning_ko": "제지하다", "example_en": "The teacher restrained the students from running in the hallway.", "example_ko": "선생님은 학생들이 복도에서 뛰지 못하게 제지했다."}
{"headword": "restraint", "meanings": [{"pos": "n.", "ko": "억제, 규제"}, {"pos": "n.", "ko": "자제"}], "meaning_ko": "억제", "example_en": "He showed great restraint by not reacting angrily to the criticism.", "example_ko": "그는 비판에 화내지 않고 큰 억제를 보였다."}
{"headword": "restrict", "meanings": [{"pos": "v.", "ko": "제한하다, 한정하다"}], "meaning_ko": "제한하다", "example_en": "The new law restricts the use of plastic bags in stores.", "example_ko": "새 법은 상점에서 비닐봉지 사용을 제한한다."}
{"headword": "restriction", "meanings": [{"pos": "n.", "ko": "제한, 한정"}], "meaning_ko": "제한", "example_en": "There is a restriction on the number of visitors allowed each day.", "example_ko": "하루에 허용되는 방문객 수에 제한이 있다."}
{"headword": "result", "meanings": [{"pos": "n.", "ko": "결과, 결말"}, {"pos": "v.", "ko": "~의 결과로 일어나다"}, {"pos": "v.", "ko": "~로 끝나다"}], "meaning_ko": "결과", "example_en": "Poor time management can result in lower grades at school.", "example_ko": "시간 관리를 잘 못하면 학교 성적이 떨어질 수 있다."}
{"headword": "result from", "meanings": [{"pos": "phr.", "ko": "~에서 기인하다, ~의 결과로 생기다"}], "meaning_ko": "~에서 기인하다", "example_en": "Many health problems result from a lack of regular exercise.", "example_ko": "많은 건강 문제는 규칙적인 운동 부족에서 기인한다."}
{"headword": "resume", "meanings": [{"pos": "v.", "ko": "다시 시작하다, 재개하다"}, {"pos": "v.", "ko": "되찾다, 다시 차지하다"}], "meaning_ko": "다시 시작하다", "example_en": "After a short break, the teacher resumed the lesson with new energy.", "example_ko": "짧은 휴식 후 선생님은 새로운 활력으로 수업을 다시 시작했다."}
{"headword": "resumption", "meanings": [{"pos": "n.", "ko": "재개, 다시 시작함"}, {"pos": "n.", "ko": "회수, 되찾음"}], "meaning_ko": "재개", "example_en": "The resumption of classes was announced after the holidays ended.", "example_ko": "방학이 끝난 후 수업 재개가 공지되었다."}
{"headword": "retail", "meanings": [{"pos": "n.", "ko": "소매"}, {"pos": "v.", "ko": "소매하다"}, {"pos": "a.", "ko": "소매의"}, {"pos": "ad.", "ko": "소매로"}], "meaning_ko": "소매", "example_en": "The new product will be sold at retail stores nationwide.", "example_ko": "신제품은 전국 소매점에서 판매될 예정이다."}
{"headword": "theoretical", "meanings": [{"pos": "a.", "ko": "이론상의, 이론적인"}, {"pos": "a.", "ko": "추상적인, 실제와는 다른"}], "meaning_ko": "이론상의", "example_en": "The theoretical model does not always match real-world results.", "example_ko": "이론상의 모델이 실제 결과와 항상 일치하는 것은 아니다."}
{"headword": "theorist", "meanings": [{"pos": "n.", "ko": "이론가, 이론을 연구하는 사람"}], "meaning_ko": "이론가", "example_en": "The famous theorist introduced a new perspective on human behavior.", "example_ko": "그 유명한 이론가는 인간 행동에 대한 새로운 관점을 제시했다."}
{"headword": "theorize", "meanings": [{"pos": "v.", "ko": "이론을 세우다, 가설을 세우다"}, {"pos": "v.", "ko": "추측하다, 이론적으로 설명하다"}], "meaning_ko": "이론을 세우다", "example_en": "Scientists often theorize about the origin of the universe.", "example_ko": "과학자들은 종종 우주의 기원에 대해 이론을 세운다."}
{"headword": "theory", "meanings": [{"pos": "n.", "ko": "이론, 체계적인 설명"}, {"pos": "n.", "ko": "학설, 특정 분야의 주장"}, {"pos": "n.", "ko": "가설, 추측"}], "meaning_ko": "이론", "example_en": "Darwin's theory of evolution changed the way people view life.", "example_ko": "다윈의 진화 이론은 사람들이 생명을 바라보는 방식을 바꿨다."}
{"headword": "therapy", "meanings": [{"pos": "n.", "ko": "치료, 치료법"}, {"pos": "n.", "ko": "심리치료, 상담"}], "meaning_ko": "치료", "example_en": "Physical therapy helped him recover after the accident.", "example_ko": "물리 치료 덕분에 그는 사고 후에 회복할 수 있었다."}
{"headword": "therefore", "meanings": [{"pos": "ad.", "ko": "그러므로, 따라서"}], "meaning_ko": "그러므로", "example_en": "She was late; therefore, she missed the beginning of the class.", "example_ko": "그녀는 늦었으므로 수업 시작 부분을 놓쳤다."}
{"headword": "thesis", "meanings": [{"pos": "n.", "ko": "논문, 학위 논문"}, {"pos": "n.", "ko": "주장, 논제"}], "meaning_ko": "논문", "example_en": "He spent two years writing his master's thesis on climate change.", "example_ko": "그는 기후 변화에 관한 석사 논문을 2년 동안 썼다."}
{"headword": "thorn", "meanings": [{"pos": "n.", "ko": "가시, 식물의 뾰족한 부분"}, {"pos": "n.", "ko": "고통의 원인, 골칫거리"}], "meaning_ko": "가시", "example_en": "The rose bush is covered with sharp thorns that can hurt your hand.", "example_ko": "장미 덤불에는 손을 다치게 할 수 있는 날카로운 가시가 있다."}
{"headword": "thorough", "meanings": [{"pos": "a.", "ko": "철저한, 빈틈없는"}, {"pos": "a.", "ko": "완전한, 전면적인"}], "meaning_ko": "철저한", "example_en": "The detective conducted a thorough investigation of the crime scene.", "example_ko": "형사는 범죄 현장을 철저하게 조사했다."}
{"headword": "thoughtful", "meanings": [{"pos": "a.", "ko": "사려 깊은, 배려하는"}, {"pos": "a.", "ko": "생각에 잠긴, 사색하는"}], "meaning_ko": "사려 깊은", "example_en": "Her thoughtful gift made everyone feel appreciated.", "example_ko": "그녀의 사려 깊은 선물은 모두를 감동시켰다."}
{"headword": "thread", "meanings": [{"pos": "n.", "ko": "실, 바느질용 실"}, {"pos": "n.", "ko": "이야기의 흐름, 맥락"}], "meaning_ko": "실", "example_en": "She used a red thread to sew the button onto her shirt.", "example_ko": "그녀는 빨간 실로 셔츠에 단추를 달았다."}
{"headword": "threat", "meanings": [{"pos": "n.", "ko": "위협, 협박"}, {"pos": "n.", "ko": "위험 요소"}], "meaning_ko": "위협", "example_en": "The threat of a storm forced the event to be canceled.", "example_ko": "폭풍의 위협 때문에 행사가 취소되었다."}
{"headword": "threaten", "meanings": [{"pos": "v.", "ko": "위협하다, 협박하다"}, {"pos": "v.", "ko": "위태롭게 하다, 위험에 빠뜨리다"}], "meaning_ko": "위협하다", "example_en": "The company threatened to fire employees who arrived late repeatedly.", "example_ko": "회사는 반복해서 지각하는 직원들을 해고하겠다고 위협했다."}
{"headword": "threatening", "meanings": [{"pos": "a.", "ko": "위협적인, 험악한"}, {"pos": "a.", "ko": "불길한, 금방이라도 닥칠 듯한"}], "meaning_ko": "위협적인", "example_en": "A threatening voice came from the other side of the door.", "example_ko": "문 너머에서 위협적인 목소리가 들려왔다."}
{"headword": "thrill", "meanings": [{"pos": "n.", "ko": "흥분, 전율"}, {"pos": "v.", "ko": "흥분시키다, 짜릿하게 하다"}], "meaning_ko": "흥분", "example_en": "The thrill of winning the game was unforgettable for the team.", "example_ko": "경기에서 이긴 흥분은 팀에게 잊을 수 없는 경험이었다."}
{"headword": "thrive", "meanings": [{"pos": "v.", "ko": "번창하다, 잘 자라다"}, {"pos": "v.", "ko": "성공하다, 발전하다"}], "meaning_ko": "번창하다", "example_en": "Small businesses can thrive with the right support and resources.", "example_ko": "적절한 지원과 자원이 있으면 소규모 기업도 번창할 수 있다."}
{"headword": "throughout", "meanings": [{"pos": "prep.", "ko": "~동안 내내, ~전체에 걸쳐"}, {"pos": "ad.", "ko": "도처에, 전역에"}], "meaning_ko": "~내내", "example_en": "He traveled throughout Europe during his summer vacation.", "example_ko": "그는 여름 방학 내내 유럽을 여행했다."}
{"headword": "thrust", "meanings": [{"pos": "v.", "ko": "세게 밀다, 밀어 넣다"}, {"pos": "v.", "ko": "(칼 등으로) 찌르다"}, {"pos": "n.", "ko": "밀침, 찌르기"}, {"pos": "n.", "ko": "요점, 핵심"}], "meaning_ko": "세게 밀다", "example_en": "He thrust the door open when he heard the alarm.", "example_ko": "그는 경보음을 듣고 문을 세게 밀어 열었다."}
{"headword": "thus", "meanings": [{"pos": "ad.", "ko": "이렇게, 이와 같이"}, {"pos": "ad.", "ko": "따라서, 그러므로"}], "meaning_ko": "따라서", "example_en": "He forgot to set his alarm, thus he was late for school.", "example_ko": "그는 알람을 맞추지 않아 결국 학교에 늦었다."}
{"headword": "tide", "meanings": [{"pos": "n.", "ko": "조수, 밀물과 썰물"}, {"pos": "n.", "ko": "흐름, 경향"}], "meaning_ko": "조수", "example_en": "The tide comes in every morning and covers the sandy beach.", "example_ko": "조수는 매일 아침 밀려와 모래사장을 덮는다."}
